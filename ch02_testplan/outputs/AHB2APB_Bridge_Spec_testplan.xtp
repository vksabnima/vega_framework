            <action>At T1, drive HTRANS=2'b10, HADDR=0x0000_3000, HWRITE=0, HSEL=1, HREADY_IN=1</action>
            <expected>AHB read address phase captured</expected>
          </step>
          <step num="2">
            <action>At T2, APB SETUP phase begins</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_3000</expected>
          </step>
          <step num="3">
            <action>At T3, APB ACCESS phase, drive PRDATA=0x9876_5432, PREADY=1</action>
            <expected>APB read completes</expected>
          </step>
