        <pass_criteria>HRDATA exactly equals PRDATA for all read transfers</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_005" name="incr4_burst_conversion">
        <req_ref>REQ_004</req_ref>
        <objective>Verify INCR4 burst converts to 4 sequential APB transfers</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10 (NONSEQ), HBURST=3'b011 (INCR4), HADDR=0x0000_1000, HWRITE=1, HSEL=1</action>
            <expected>First beat of INCR4 burst initiated</expected>
          </step>
          <step num="2">
            <action>At T2, drive HWDATA=0x1111_1111, HTRANS=2'b11 (SEQ), observe APB</action>
            <expected>First APB transfer: PADDR=0x0000_1000, PWDATA=0x1111_1111</expected>
          </step>
          <step num="3">
            <action>Drive PREADY=1 to complete first APB transfer, second beat HWDATA=0x2222_2222</action>
            <expected>Second APB transfer: PADDR=0x0000_1004, PWDATA=0x2222_2222</expected>
          </step>
          <step num="4">
            <action>Drive PREADY=1 to complete second APB transfer, third beat HWDATA=0x3333_3333</action>
            <expected>Third APB transfer: PADDR=0x0000_1008, PWDATA=0x3333_3333</expected>
          </step>
          <step num="5">
            <action>Drive PREADY=1 to complete third APB transfer, fourth beat HWDATA=0x4444_4444</action>
            <expected>Fourth APB transfer: PADDR=0x0000_100C, PWDATA=0x4444_4444</expected>
          </step>
          <step num="6">
            <action>Drive PREADY=1 to complete fourth APB transfer</action>
            <expected>Burst completes, HREADY_OUT=1, return to IDLE</expected>
          </step>
          <step num="7">
            <action>Read back all 4 locations to verify writes</action>
            <expected>0x1000→0x1111_1111, 0x1004→0x2222_2222, 0x1008→0x3333_3333, 0x100C→0x4444_4444</expected>
          </step>
        </steps>
        <pass_criteria>1. INCR4 burst converts to exactly 4 APB transfers. 2. Addresses increment by 4. 3. All data written correctly.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_006" name="incr_address_increment">
        <req_ref>REQ_004</req_ref>
        <objective>Verify address increments by HSIZE for INCR bursts</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10, HBURST=3'b011 (INCR4), HADDR=0x0000_2000, HSIZE=3'b010 (Word), HWRITE=1</action>
            <expected>INCR4 burst with word transfers initiated</expected>
          </step>
          <step num="2">
            <action>Monitor PADDR for first beat</action>
            <expected>PADDR=0x0000_2000 (base address)</expected>
          </step>
          <step num="3">
            <action>Complete first APB transfer, monitor PADDR for second beat</action>
            <expected>PADDR=0x0000_2004 (incremented by 4 for word size)</expected>
          </step>
          <step num="4">
            <action>Complete second APB transfer, monitor PADDR for third beat</action>
            <expected>PADDR=0x0000_2008 (incremented by 4 again)</expected>
          </step>
          <step num="5">
            <action>Complete third APB transfer, monitor PADDR for fourth beat</action>
            <expected>PADDR=0x0000_200C (incremented by 4 again)</expected>
          </step>
          <step num="6">
            <action>Test with HSIZE=3'b001 (Halfword): HADDR=0x0000_3000</action>
            <expected>Address increments: 0x3000, 0x3002, 0x3004, 0x3006 (by 2)</expected>
          </step>
          <step num="7">
            <action>Test with HSIZE=3'b000 (Byte): HADDR=0x0000_4000</action>
            <expected>Address increments: 0x4000, 0x4001, 0x4002, 0x4003 (by 1)</expected>
          </step>
        </steps>
        <pass_criteria>Address increments match HSIZE: Word=+4, Halfword=+2, Byte=+1</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_007" name="wrap4_boundary_test">
        <req_ref>REQ_004</req_ref>
        <objective>Verify WRAP4 burst wraps at 4×HSIZE boundary</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10, HBURST=3'b010 (WRAP4), HADDR=0x0000_100E, HSIZE=3'b010 (Word), HWRITE=1</action>
            <expected>WRAP4 burst initiated at unaligned address 0x100E</expected>
          </step>
          <step num="2">
            <action>Monitor PADDR for first beat</action>
            <expected>PADDR=0x0000_100E (starting address)</expected>
          </step>
          <step num="3">
            <action>Complete first APB transfer, monitor PADDR for second beat</action>
            <expected>PADDR=0x0000_1010 (boundary at 0x1010-0x101F, wraps to 0x1010)</expected>
          </step>
          <step num="4">
            <action>Complete second APB transfer, monitor PADDR for third beat</action>
            <expected>PADDR=0x0000_1014 (increment within boundary)</expected>
          </step>
          <step num="5">
            <action>Complete third APB transfer, monitor PADDR for fourth beat</action>
            <expected>PADDR=0x0000_1018 (increment within boundary)</expected>
          </step>
          <step num="6">
            <action>Complete all 4 transfers with unique data patterns</action>
            <expected>Burst completes with proper wrapping behavior</expected>
          </step>
        </steps>
        <pass_criteria>WRAP4 addresses follow wrap boundary: 0x100E→0x1010→0x1014→0x1018 for 16-byte boundary</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_008" name="transfer_gating_negative">
        <req_ref>REQ_003</req_ref>
        <objective>Verify bridge ignores transfers when HSEL=0, HREADY_IN=0, or HTRANS=IDLE/BUSY (CONV-2)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Drive HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HSEL=0, HREADY_IN=1</action>
            <expected>Bridge ignores transfer — HSEL=0 means bridge not selected</expected>
          </step>
          <step num="2">
            <action>Monitor APB signals for 5 cycles</action>
            <expected>PSEL=0, PENABLE=0, no APB transfer initiated</expected>
          </step>
          <step num="3">
            <action>Drive HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HSEL=1, HREADY_IN=0</action>
            <expected>Bridge ignores transfer — HREADY_IN=0 means previous transfer not complete</expected>
          </step>
          <step num="4">
            <action>Monitor APB signals for 5 cycles</action>
            <expected>PSEL=0, PENABLE=0, no APB transfer initiated</expected>
          </step>
          <step num="5">
            <action>Drive HTRANS=2'b00 (IDLE), HADDR=0x0000_1000, HWRITE=1, HSEL=1, HREADY_IN=1</action>
            <expected>Bridge ignores — HTRANS=IDLE means no transfer requested</expected>
          </step>
          <step num="6">
            <action>Drive HTRANS=2'b01 (BUSY), HADDR=0x0000_1000, HWRITE=1, HSEL=1, HREADY_IN=1</action>
            <expected>Bridge ignores — HTRANS=BUSY is a wait cycle, no new transfer</expected>
          </step>
          <step num="7">
            <action>Verify bridge still works: HTRANS=2'b10, HSEL=1, HREADY_IN=1, HADDR=0x1000, write 0xDEAD_BEEF</action>
            <expected>Transfer succeeds, proving bridge is functional after ignoring invalid requests</expected>
          </step>
        </steps>
        <pass_criteria>Bridge only captures transfer when HSEL=1 AND HREADY_IN=1 AND HTRANS[1]=1</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_009" name="direction_forwarding">
        <req_ref>REQ_003</req_ref>
        <objective>Verify PWRITE equals captured HWRITE for both write and read transfers (CONV-6)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Initiate write: HTRANS=2'b10, HADDR=0x0000_4000, HWRITE=1</action>
            <expected>Write transfer captured</expected>
          </step>
          <step num="2">
            <action>During APB SETUP/ACCESS, sample PWRITE</action>
            <expected>PWRITE=1, matching HWRITE=1 (write direction forwarded)</expected>
          </step>
          <step num="3">
            <action>Complete write, initiate read: HTRANS=2'b10, HADDR=0x0000_4000, HWRITE=0</action>
            <expected>Read transfer captured</expected>
          </step>
          <step num="4">
            <action>During APB SETUP/ACCESS, sample PWRITE</action>
            <expected>PWRITE=0, matching HWRITE=0 (read direction forwarded)</expected>
          </step>
          <step num="5">
            <action>Alternate write/read 5 times, check PWRITE matches HWRITE each time</action>
            <expected>PWRITE always equals captured HWRITE for every transfer</expected>
          </step>
        </steps>
        <pass_criteria>PWRITE exactly equals HWRITE for every transfer — write maps to write, read maps to read</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_010" name="burst_early_termination">
        <req_ref>REQ_004</req_ref>
        <objective>Verify burst terminates early on HTRANS=IDLE or HTRANS=NONSEQ (BURST-5)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start INCR4 burst: HTRANS=2'b10 (NONSEQ), HBURST=3'b011, HADDR=0x0000_5000, HWRITE=1</action>
            <expected>First beat of INCR4 burst initiated</expected>
          </step>
          <step num="2">
            <action>Complete first beat with HWDATA=0x1111_1111</action>
            <expected>First APB transfer completes at 0x5000</expected>
          </step>
          <step num="3">
            <action>Drive HTRANS=2'b00 (IDLE) instead of SEQ for second beat</action>
            <expected>Burst terminated early — bridge detects IDLE and stops burst</expected>
          </step>
          <step num="4">
            <action>Verify bridge returns to IDLE, no further APB transfers</action>
            <expected>PSEL=0, PENABLE=0, bridge idle</expected>
          </step>
          <step num="5">
            <action>Start new INCR4 burst: HADDR=0x0000_6000</action>
            <expected>New burst initiated</expected>
          </step>
          <step num="6">
            <action>Complete 2 beats, then drive HTRANS=2'b10 (NONSEQ) with new HADDR=0x0000_7000</action>
            <expected>Current burst terminated, new single/burst transfer begins at 0x7000</expected>
          </step>
          <step num="7">
            <action>Complete new transfer and verify data at 0x7000</action>
            <expected>New transfer succeeds, old burst cleanly terminated</expected>
          </step>
        </steps>
        <pass_criteria>1. HTRANS=IDLE terminates burst. 2. HTRANS=NONSEQ starts new transfer and terminates old burst. 3. No residual state from aborted burst.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_011" name="burst_1kb_boundary_no_cross">
        <req_ref>REQ_004</req_ref>
        <objective>Verify bridge handles bursts near 1KB boundary correctly (BURST-6)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start INCR4 burst at HADDR=0x0000_03F0 (16 bytes before 1KB boundary at 0x400)</action>
            <expected>Burst starts near 1KB boundary</expected>
          </step>
          <step num="2">
            <action>Complete 4 beats: 0x03F0, 0x03F4, 0x03F8, 0x03FC</action>
            <expected>All 4 beats stay within 1KB boundary — burst completes normally</expected>
          </step>
          <step num="3">
            <action>Start INCR4 burst at HADDR=0x0000_03F4 (would cross 1KB at beat 4: 0x400)</action>
            <expected>Burst may cross 1KB boundary at 4th beat</expected>
          </step>
          <step num="4">
            <action>Monitor addresses: 0x03F4, 0x03F8, 0x03FC, 0x0400</action>
            <expected>Bridge should handle or prevent 1KB crossing per design policy</expected>
          </step>
          <step num="5">
            <action>Verify bridge state after boundary-crossing attempt</action>
            <expected>Bridge either wraps address, terminates burst, or handles gracefully — no hang or corruption</expected>
          </step>
          <step num="6">
            <action>Test WRAP4 at boundary: HADDR=0x0000_03FC with HSIZE=Word</action>
            <expected>WRAP4 wraps within 16-byte boundary (0x03FC, 0x03F0, 0x03F4, 0x03F8), never crosses 1KB</expected>
          </step>
        </steps>
        <pass_criteria>1. Bursts within 1KB complete normally. 2. Potential 1KB-crossing handled gracefully. 3. WRAP bursts naturally avoid crossing.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="protocol_tests" category="protocol" count="4">
      <test_case test_id="TEST_PROTOCOL_001" name="apb_wait_state_propagation">
        <req_ref>REQ_005</req_ref>
        <objective>Verify APB PREADY=0 causes AHB HREADY_OUT=0</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Transfer in progress</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, initiate transfer: HTRANS=2'b10, HADDR=0x0000_5000, HWRITE=1, HSEL=1</action>
            <expected>AHB transfer initiated</expected>
          </step>
          <step num="2">
            <action>At T2, APB SETUP phase begins, HWDATA=0x5555_AAAA</action>
            <expected>PSEL=1, PENABLE=0, PADDR=0x0000_5000, PWDATA=0x5555_AAAA</expected>
          </step>
          <step num="3">
            <action>At T3, APB ACCESS phase, drive PREADY=0</action>
            <expected>PSEL=1, PENABLE=1, HREADY_OUT=0 (wait state inserted)</expected>
          </step>
          <step num="4">
            <action>At T4, maintain PREADY=0</action>
            <expected>HREADY_OUT=0, transfer remains in ACCESS phase</expected>
          </step>
          <step num="5">
            <action>At T5, drive PREADY=1</action>
            <expected>HREADY_OUT=1, transfer completes</expected>
          </step>
          <step num="6">
            <action>At T6, observe signals</action>
            <expected>PSEL=0, PENABLE=0, return to IDLE</expected>
          </step>
        </steps>
        <pass_criteria>HREADY_OUT=0 when PREADY=0, HREADY_OUT=1 when PREADY=1</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_002" name="minimum_apb_transfer_cycles">
        <req_ref>REQ_005</req_ref>
        <objective>Verify APB transfer takes minimum 2 cycles even with PREADY=1</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, initiate transfer: HTRANS=2'b10, HADDR=0x0000_6000, HWRITE=1, HSEL=1</action>
            <expected>AHB transfer initiated</expected>
          </step>
          <step num="2">
            <action>At T2, HWDATA=0x1122_3344, slave ready immediately: PREADY=1</action>
            <expected>SETUP phase: PSEL=1, PENABLE=0, HREADY_OUT=0</expected>
          </step>
          <step num="3">
            <action>At T3, maintain PREADY=1</action>
            <expected>ACCESS phase: PSEL=1, PENABLE=1, HREADY_OUT=1, transfer completes</expected>
          </step>
          <step num="4">
            <action>Count total cycles from T2 to T3</action>
            <expected>Exactly 2 cycles for complete APB transfer</expected>
          </step>
          <step num="5">
            <action>At T4, observe signals</action>
            <expected>PSEL=0, PENABLE=0, IDLE state</expected>
          </step>
        </steps>
        <pass_criteria>APB transfer completes in exactly 2 cycles with PREADY=1 throughout</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_003" name="ahb_two_cycle_error_response">
        <req_ref>REQ_001</req_ref>
        <objective>Verify HRESP is held HIGH for exactly two cycles on error response (AHB-6)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Generate address error: HTRANS=2'b10, HADDR=0x0010_0000, HWRITE=1</action>
            <expected>Invalid address detected, error response begins</expected>
          </step>
          <step num="2">
            <action>Sample HRESP at first error cycle (T1)</action>
            <expected>HRESP=1 (ERROR), HREADY_OUT=0 (first cycle of two-cycle error)</expected>
          </step>
          <step num="3">
            <action>Sample HRESP at second error cycle (T2)</action>
            <expected>HRESP=1 (ERROR), HREADY_OUT=1 (second cycle, transfer completes)</expected>
          </step>
          <step num="4">
            <action>Sample HRESP at T3 (cycle after error completes)</action>
            <expected>HRESP=0 (OKAY), bridge returned to normal</expected>
          </step>
          <step num="5">
            <action>Generate timeout error: TIMEOUT_EN=1, PREADY=0 beyond timeout</action>
            <expected>Timeout error triggers</expected>
          </step>
          <step num="6">
            <action>Sample HRESP for exactly 2 cycles during timeout error response</action>
            <expected>HRESP=1 for exactly 2 cycles, then HRESP=0</expected>
          </step>
          <step num="7">
            <action>Generate protocol error: PSLVERR=1 during valid transfer</action>
            <expected>Protocol error triggers</expected>
          </step>
          <step num="8">
            <action>Sample HRESP for exactly 2 cycles during PSLVERR error response</action>
            <expected>HRESP=1 for exactly 2 cycles, then HRESP=0</expected>
          </step>
        </steps>
        <pass_criteria>All three error types (address, timeout, protocol) produce exactly 2-cycle HRESP=ERROR response per AHB-6</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_004" name="apb_signal_stability_during_transfer">
        <req_ref>REQ_002</req_ref>
        <objective>Verify PADDR, PWRITE, and PWDATA remain stable for entire APB transfer (APB-3)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Initiate write: HTRANS=2'b10, HADDR=0x0000_2000, HWRITE=1, HWDATA=0xA5A5_5A5A</action>
            <expected>Transfer initiated</expected>
          </step>
          <step num="2">
            <action>During SETUP phase (PSEL=1, PENABLE=0), sample PADDR, PWRITE, PWDATA</action>
            <expected>PADDR=0x0000_2000, PWRITE=1, PWDATA=0xA5A5_5A5A</expected>
          </step>
          <step num="3">
            <action>Drive PREADY=0 to insert 3 wait states in ACCESS phase</action>
            <expected>Transfer held in ACCESS phase</expected>
          </step>
          <step num="4">
            <action>Sample PADDR, PWRITE, PWDATA on each wait state cycle</action>
            <expected>PADDR=0x0000_2000, PWRITE=1, PWDATA=0xA5A5_5A5A — all stable across all wait cycles</expected>
          </step>
          <step num="5">
            <action>Drive PREADY=1, transfer completes</action>
            <expected>PADDR, PWRITE, PWDATA still stable at completion</expected>
          </step>
          <step num="6">
            <action>Repeat with read transfer: HADDR=0x0000_3000, HWRITE=0, 2 wait states</action>
            <expected>PADDR=0x0000_3000, PWRITE=0 stable throughout SETUP and ACCESS phases</expected>
          </step>
        </steps>
        <pass_criteria>PADDR, PWRITE, PWDATA remain stable from SETUP through ACCESS phase completion, including wait states</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="register_access_tests" category="register_access" count="6">
      <test_case test_id="TEST_REGISTER_ACCESS_001" name="ctrl_register_access">
        <req_ref>REQ_006</req_ref>
        <objective>Verify CTRL register can be read and written at 0xF00</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge base address configured</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Read CTRL register: HADDR=0x0000_0F00, HTRANS=2'b10, HWRITE=0, HSEL=1</action>
            <expected>Read transfer to CTRL register</expected>
          </step>
          <step num="2">
            <action>Sample HRDATA when HREADY_OUT=1</action>
            <expected>HRDATA=0x0000_0071 (reset value: TIMEOUT_VAL=111, ENABLE=1)</expected>
          </step>
          <step num="3">
            <action>Write CTRL register: HADDR=0x0000_0F00, HWRITE=1, HWDATA=0x0000_0089</action>
            <expected>Write 0x89 to CTRL (TIMEOUT_EN=1, TIMEOUT_VAL=000, ERR_INT_EN=1, ENABLE=1)</expected>
          </step>
          <step num="4">
            <action>Read back CTRL register</action>
            <expected>HRDATA=0x0000_0089, confirming write successful</expected>
          </step>
          <step num="5">
            <action>Test individual bit fields: write HWDATA=0x0000_0008</action>
            <expected>Only ERR_INT_EN=1, all other fields cleared</expected>
          </step>
          <step num="6">
            <action>Read back and verify bit fields</action>
            <expected>HRDATA=0x0000_0008, ERR_INT_EN bit set correctly</expected>
          </step>
        </steps>
        <pass_criteria>1. CTRL register readable at 0xF00. 2. Writes preserved on readback. 3. Bit fields set correctly.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_002" name="ctrl_enable_bit">
        <req_ref>REQ_006</req_ref>
        <objective>Verify ENABLE bit controls bridge operation</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge initially enabled</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Verify bridge enabled: write data to 0x1000, read back</action>
            <expected>Transfer succeeds, bridge operational</expected>
          </step>
          <step num="2">
            <action>Disable bridge: write 0x0000_0070 to CTRL (TIMEOUT_VAL=111, ENABLE=0)</action>
            <expected>CTRL.ENABLE=0, bridge disabled, TIMEOUT_VAL preserved</expected>
          </step>
          <step num="3">
            <action>Attempt transfer to 0x1000 while disabled</action>
            <expected>Transfer may fail or generate error response</expected>
          </step>
          <step num="4">
            <action>Re-enable bridge: write 0x0000_0001 to CTRL (ENABLE=1)</action>
            <expected>CTRL.ENABLE=1, bridge re-enabled</expected>
          </step>
          <step num="5">
            <action>Verify bridge works: write 0xABCD_EF01 to 0x1000, read back</action>
            <expected>HRDATA=0xABCD_EF01, bridge fully operational</expected>
          </step>
        </steps>
        <pass_criteria>ENABLE=0 disables bridge, ENABLE=1 enables normal operation</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_003" name="status_register_access">
        <req_ref>REQ_007</req_ref>
        <objective>Verify STATUS register read access and write-1-to-clear behavior</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Read STATUS register: HADDR=0x0000_0F04, HTRANS=2'b10, HWRITE=0, HSEL=1</action>
            <expected>Read transfer to STATUS register</expected>
          </step>
          <step num="2">
            <action>Sample HRDATA when HREADY_OUT=1</action>
            <expected>HRDATA=0x0000_0001 (reset value: READY=1)</expected>
          </step>
          <step num="3">
            <action>Force error condition to set error bits</action>
            <expected>STATUS error bits become set</expected>
          </step>
          <step num="4">
            <action>Read STATUS register again</action>
            <expected>Error bits visible in HRDATA</expected>
          </step>
          <step num="5">
            <action>Clear error: write 0x0000_00F0 (clear all error bits)</action>
            <expected>Write-1-to-clear on error bits</expected>
          </step>
          <step num="6">
            <action>Read STATUS register after clear</action>
            <expected>Error bits cleared, HRDATA=0x0000_0001 (only READY=1)</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS readable at 0xF04. 2. Error bits set on error. 3. Write-1-to-clear works correctly.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_004" name="status_ready_bit">
        <req_ref>REQ_007</req_ref>
        <objective>Verify READY bit reflects bridge transfer status</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Read STATUS when bridge idle</action>
            <expected>STATUS.READY=1 (bit 0 set)</expected>
          </step>
          <step num="2">
            <action>Initiate transfer: HTRANS=2'b10, HADDR=0x2000, HWRITE=1</action>
            <expected>Transfer begins</expected>
          </step>
          <step num="3">
            <action>Read STATUS during active transfer</action>
            <expected>STATUS.BUSY=1 (bit 1 set), STATUS.READY=0</expected>
          </step>
          <step num="4">
            <action>Complete transfer with PREADY=1</action>
            <expected>Transfer completes</expected>
          </step>
          <step num="5">
            <action>Read STATUS after transfer completion</action>
            <expected>STATUS.READY=1, STATUS.BUSY=0</expected>
          </step>
        </steps>
        <pass_criteria>READY=1 when idle, READY=0 during active transfer, READY=1 when complete</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_005" name="error_addr_capture">
        <req_ref>REQ_008</req_ref>
        <objective>Verify ERROR_ADDR captures failing transfer address</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Read ERROR_ADDR initially: HADDR=0x0000_0F08, HWRITE=0</action>
            <expected>HRDATA=0x0000_0000 (reset value)</expected>
          </step>
          <step num="2">
            <action>Generate address error: transfer to invalid address 0x0001_FFFF</action>
            <expected>Address error occurs</expected>
          </step>
          <step num="3">
            <action>Read ERROR_ADDR after error</action>
            <expected>HRDATA=0x0001_FFFF (captured failing address)</expected>
          </step>
          <step num="4">
            <action>Generate different error: transfer to 0x0002_AAAA</action>
            <expected>New error at different address</expected>
          </step>
          <step num="5">
            <action>Read ERROR_ADDR again</action>
            <expected>HRDATA=0x0002_AAAA (updated to new failing address)</expected>
          </step>
          <step num="6">
            <action>Clear error via STATUS register, read ERROR_ADDR</action>
            <expected>ERROR_ADDR may retain last error address for debugging</expected>
          </step>
        </steps>
        <pass_criteria>ERROR_ADDR captures exact address that caused each error</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_006" name="error_info_capture">
        <req_ref>REQ_009</req_ref>
        <objective>Verify ERROR_INFO captures comprehensive error details</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Read ERROR_INFO initially: HADDR=0x0000_0F0C, HWRITE=0</action>
            <expected>HRDATA=0x0000_0000 (reset value)</expected>
          </step>
          <step num="2">
            <action>Generate protocol error during write: PSLVERR=1, HADDR=0x3000, HSIZE=3'b010</action>
            <expected>Protocol error occurs on word write</expected>
          </step>
          <step num="3">
            <action>Read ERROR_INFO after protocol error</action>
            <expected>ERR_TYPE=4'h3 (protocol), ERR_WRITE=1, ERR_SIZE=3'b010</expected>
          </step>
          <step num="4">
            <action>Generate timeout error during read: HWRITE=0, HSIZE=3'b001</action>
            <expected>Timeout error on halfword read</expected>
          </step>
          <step num="5">
            <action>Read ERROR_INFO after timeout</action>
            <expected>ERR_TYPE=4'h2 (timeout), ERR_WRITE=0, ERR_SIZE=3'b001</expected>
          </step>
          <step num="6">
            <action>Generate error during burst: INCR4, beat 2</action>
            <expected>Error on second beat of burst</expected>
          </step>
          <step num="7">
            <action>Read ERROR_INFO after burst error</action>
            <expected>ERR_BEAT=8'h01 (beat 2, zero-indexed), correct ERR_TYPE</expected>
          </step>
        </steps>
        <pass_criteria>ERROR_INFO correctly captures error type, direction, size, and beat number</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="reset_tests" category="reset" count="5">
      <test_case test_id="TEST_RESET_001" name="soft_reset_initiation">
        <req_ref>REQ_013</req_ref>
        <objective>Verify writing SOFT_RST bit initiates soft reset sequence</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational with active configuration</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure bridge: write 0x0000_008F to CTRL (timeout enabled, interrupts enabled)</action>
            <expected>Bridge configured with non-reset values</expected>
          </step>
          <step num="2">
            <action>Generate traffic: write 0xDEAD_BEEF to 0x1000, read back</action>
            <expected>HRDATA=0xDEAD_BEEF, bridge working normally</expected>
          </step>
          <step num="3">
            <action>Cause error condition to set STATUS bits</action>
            <expected>STATUS register has error bits set</expected>
          </step>
          <step num="4">
            <action>Initiate soft reset: write 0x0000_008E to CTRL (SOFT_RST=1, preserve other bits)</action>
            <expected>Soft reset initiated</expected>
          </step>
          <step num="5">
            <action>Wait 2 clock cycles for soft reset completion</action>
            <expected>Soft reset completes</expected>
          </step>
          <step num="6">
            <action>Verify bridge ready after 2-cycle soft reset recovery (SRST-6): read STATUS</action>
            <expected>STATUS.READY=1, confirming bridge ready exactly 2 cycles after soft reset</expected>
          </step>
          <step num="7">
            <action>Read CTRL register after soft reset</action>
            <expected>SOFT_RST bit self-cleared, other CTRL bits preserved</expected>
          </step>
          <step num="8">
            <action>Read STATUS register after soft reset</action>
            <expected>STATUS=0x0000_0001 (all error bits cleared, READY=1)</expected>
          </step>
          <step num="9">
            <action>Read ERROR_ADDR and ERROR_INFO</action>
            <expected>Error registers cleared to 0x0000_0000</expected>
          </step>
          <step num="10">
            <action>Reconfigure if needed, test functionality</action>
            <expected>Bridge ready for new transfers</expected>
          </step>
          <step num="11">
            <action>Verify operation: write 0xCAFE_BABE to 0x2000, read back</action>
            <expected>HRDATA=0xCAFE_BABE, proving soft reset successful and device operational</expected>
          </step>
        </steps>
        <pass_criteria>1. SOFT_RST initiates reset. 2. STATUS errors cleared. 3. SOFT_RST self-clears. 4. CTRL preserved except SOFT_RST. 5. 2-cycle recovery (SRST-6). 6. Device works after reset.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_002" name="soft_reset_abort_transfer">
        <req_ref>REQ_013</req_ref>
        <objective>Verify soft reset aborts active transfers cleanly</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start transfer: HTRANS=2'b10, HADDR=0x0000_3000, HWRITE=1, HWDATA=0x1357_2468</action>
            <expected>Transfer initiated, APB SETUP phase</expected>
          </step>
          <step num="2">
            <action>Advance to ACCESS phase: PSEL=1, PENABLE=1, PREADY=0</action>
            <expected>Transfer in progress, waiting for PREADY</expected>
          </step>
          <step num="3">
            <action>During active transfer, write SOFT_RST=1 to CTRL register</action>
            <expected>Soft reset initiated during active transfer</expected>
          </step>
          <step num="4">
            <action>Monitor APB signals immediately after soft reset</action>
            <expected>PSEL=0, PENABLE=0, APB transfer aborted</expected>
          </step>
          <step num="5">
            <action>Monitor AHB signals after soft reset</action>
            <expected>HREADY_OUT=1, HRESP=0, AHB returns to ready state</expected>
          </step>
          <step num="6">
            <action>Wait 2 cycles for soft reset completion</action>
            <expected>Reset sequence completes</expected>
          </step>
          <step num="7">
            <action>Read STATUS register</action>
            <expected>STATUS=0x0000_0001 (READY=1, clean state)</expected>
          </step>
          <step num="8">
            <action>Verify aborted transfer: read from 0x0000_3000</action>
            <expected>Data not written (transfer was aborted)</expected>
          </step>
          <step num="9">
            <action>Test new transfer: write 0x9999_AAAA to 0x3000, read back</action>
            <expected>HRDATA=0x9999_AAAA, new transfer succeeds</expected>
          </step>
          <step num="10">
            <action>Verify bridge fully operational after abort and reset</action>
            <expected>All subsequent transfers work normally</expected>
          </step>
        </steps>
        <pass_criteria>1. Active transfer aborted by soft reset. 2. APB signals return to IDLE. 3. AHB ready for new transfers. 4. New transfers work normally.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_003" name="async_reset_assertion">
        <req_ref>REQ_014</req_ref>
        <objective>Verify reset can be asserted asynchronously during any operation</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>Bridge operational and configured</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure bridge: write 0x0000_008F to CTRL register</action>
            <expected>Bridge configured with non-default settings</expected>
          </step>
          <step num="2">
            <action>Generate traffic: write 0xDEAD_BEEF to 0x1000, read back</action>
            <expected>HRDATA=0xDEAD_BEEF, bridge operational</expected>
          </step>
          <step num="3">
            <action>Start active transfer: HTRANS=2'b10, HADDR=0x2000, HWRITE=1</action>
            <expected>Transfer in progress, APB ACCESS phase</expected>
          </step>
          <step num="4">
            <action>Assert HRESETn=0 asynchronously during mid-transfer</action>
            <expected>Reset asserted during active operation</expected>
          </step>
          <step num="5">
            <action>Within 1 cycle, verify active APB transfer is aborted: sample PSEL, PENABLE</action>
            <expected>PSEL=0, PENABLE=0, confirming active APB transfer aborted by reset</expected>
          </step>
          <step num="6">
            <action>Within 1 cycle, observe all AHB outputs</action>
            <expected>HREADY_OUT=1, HRESP=0, PSEL=0, PENABLE=0 (safe reset state)</expected>
          </step>
          <step num="7">
            <action>Hold HRESETn=0 for 5 cycles</action>
            <expected>All outputs remain at reset values</expected>
          </step>
          <step num="8">
            <action>Deassert HRESETn=1 synchronously at clock edge</action>
            <expected>Reset released synchronously</expected>
          </step>
          <step num="9">
            <action>Wait 2 cycles after reset deassertion</action>
            <expected>Bridge initialization complete</expected>
          </step>
          <step num="10">
            <action>Read CTRL register</action>
            <expected>CTRL=0x0000_0071 (reset value: TIMEOUT_VAL=111, ENABLE=1)</expected>
          </step>
          <step num="11">
            <action>Read STATUS register</action>
            <expected>STATUS=0x0000_0001 (reset value: READY=1 only)</expected>
          </step>
          <step num="12">
            <action>Reconfigure bridge as needed</action>
            <expected>Configuration successful</expected>
          </step>
          <step num="13">
            <action>Test operation: write 0xCAFE_BABE to 0x3000, read back</action>
            <expected>HRDATA=0xCAFE_BABE, proving reset recovery and full operation</expected>
          </step>
        </steps>
        <pass_criteria>1. Async reset accepted anytime. 2. Safe state within 1 cycle. 3. Sync reset release. 4. 2-cycle recovery. 5. Full operation restored.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_004" name="reset_safe_state_timing">
        <req_ref>REQ_014</req_ref>
        <objective>Verify all outputs reach safe state within 1 clock cycle of reset assertion</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>Bridge in active operation</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Establish active state: ongoing transfer with PSEL=1, PENABLE=1, HREADY_OUT=0</action>
            <expected>Active transfer in progress</expected>
          </step>
          <step num="2">
            <action>At T1, assert HRESETn=0 (can be mid-cycle)</action>
            <expected>Reset assertion</expected>
          </step>
          <step num="3">
            <action>At T2 rising edge (1 cycle later), sample all outputs</action>
            <expected>HREADY_OUT=1, HRESP=0, HRDATA=0, PSEL=0, PENABLE=0, PADDR=0, PWRITE=0, PWDATA=0</expected>
          </step>
          <step num="4">
            <action>Verify ALL register reset values per Table 12: read CTRL, STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>CTRL=0x0000_0071, STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="5">
            <action>Continue monitoring for additional cycles</action>
            <expected>Outputs stable at reset values</expected>
          </step>
        </steps>
        <pass_criteria>All outputs reach safe reset state within exactly 1 clock cycle</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_005" name="reset_recovery_timing">
        <req_ref>REQ_014</req_ref>
        <objective>Verify bridge ready exactly 2 cycles after reset deassertion</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn asserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, deassert HRESETn=1 synchronously</action>
            <expected>Reset deassertion at clock edge</expected>
          </step>
          <step num="2">
            <action>At T2 (1 cycle after deassertion), read STATUS register</action>
            <expected>Bridge NOT ready — STATUS.READY=0, transfer must not be accepted (RST-4 requires 2 cycles)</expected>
          </step>
          <step num="3">
            <action>At T3 (2 cycles after deassertion), initiate transfer: HTRANS=2'b10, HADDR=0x1000</action>
            <expected>Bridge accepts transfer, operates normally</expected>
          </step>
          <step num="4">
            <action>Complete transfer with write data 0x1234_ABCD</action>
            <expected>Transfer completes successfully</expected>
          </step>
          <step num="5">
            <action>Read back written data</action>
            <expected>HRDATA=0x1234_ABCD, proving bridge fully operational</expected>
          </step>
        </steps>
        <pass_criteria>Bridge accepts and completes transfers starting exactly 2 cycles after reset deassertion</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="stress_tests" category="stress" count="1">
      <test_case test_id="TEST_STRESS_001" name="back_to_back_stress_test">
        <req_ref>REQ_015</req_ref>
        <objective>Verify bridge handles 1000+ back-to-back transfers without errors</objective>
        <preconditions>
          <condition>HCLK running at maximum frequency 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge configured for minimal latency</condition>
          <condition>APB slave responds with PREADY=1 (no wait states)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure for max performance: write 0x0000_0001 to CTRL (minimal settings)</action>
            <expected>Bridge configured for lowest latency</expected>
          </step>
          <step num="2">
            <action>Execute 1000 back-to-back writes with ZERO idle cycles: HTRANS never IDLE</action>
            <expected>Continuous NONSEQ transfers: 0x1000+i, data=0x0000+i</expected>
          </step>
          <step num="3">
            <action>Monitor HREADY_OUT throughout write sequence</action>
            <expected>HREADY_OUT follows APB completion, no stalls beyond APB requirements</expected>
          </step>
          <step num="4">
            <action>Execute 1000 back-to-back reads from same addresses</action>
            <expected>Read data matches written data: HRDATA=0x0000+i for address 0x1000+i</expected>
          </step>
          <step num="5">
            <action>Monitor STATUS register during stress test</action>
            <expected>STATUS shows no errors throughout: no TIMEOUT_ERR, ADDR_ERR, PSLVERR</expected>
          </step>
          <step num="6">
            <action>After 1000 transfers, verify bridge still operational</action>
            <expected>Bridge responds normally to new transfers</expected>
          </step>
          <step num="7">
            <action>Final verification: write 0xFEED_FACE to 0x9999, read back</action>
            <expected>HRDATA=0xFEED_FACE, proving bridge fully operational after stress</expected>
          </step>
        </steps>
        <pass_criteria>1. 1000+ transfers complete without errors. 2. No performance degradation. 3. STATUS clean. 4. Bridge operational after stress.</pass_criteria>
      </test_case>
    </test_suite>
  </test_suites>
</testplan>