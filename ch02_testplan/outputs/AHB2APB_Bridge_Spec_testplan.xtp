  <features count="15">
    <feature req_id="REQ_001" name="AHB Slave Interface" category="connectivity" pages="page 6-7">
      <description>Bridge presents AHB slave interface to receive transfers from AHB master</description>
      <signals>HCLK, HRESETn, HADDR, HTRANS, HWRITE, HSIZE, HBURST, HWDATA, HSEL, HREADY_IN, HRDATA, HREADY_OUT, HRESP</signals>
      <requirements>
        <requirement text="AHB-2: HREADY_OUT shall be HIGH during IDLE state" page="page 9" test_ref="TEST_CONNECTIVITY_001"/>
        <requirement text="AHB-3: When HREADY_OUT is LOW, the master shall hold all control signals stable" page="page 9" test_ref="TEST_CONNECTIVITY_002"/>
        <requirement text="AHB-6: For ERROR response, HRESP shall be HIGH for two cycles" page="page 9" test_ref="TEST_PROTOCOL_003"/>
      </requirements>
    </feature>
    <feature req_id="REQ_002" name="APB Master Interface" category="connectivity" pages="page 7-8">
      <description>Bridge presents APB master interface to communicate with APB slave</description>
      <signals>PCLK, PRESETn, PADDR, PSEL, PENABLE, PWRITE, PWDATA, PRDATA, PREADY, PSLVERR</signals>
      <requirements>
        <requirement text="APB-1: PSEL shall be asserted for the entire transfer (SETUP and ACCESS phases)" page="page 9" test_ref="TEST_CONNECTIVITY_003"/>
        <requirement text="APB-2: PENABLE shall be LOW during SETUP phase and HIGH during ACCESS phase" page="page 9" test_ref="TEST_CONNECTIVITY_004"/>
        <requirement text="APB-3: PADDR, PWRITE, and PWDATA shall be stable for entire transfer" page="page 9" test_ref="TEST_PROTOCOL_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_003" name="Single Transfer Conversion" category="main_datapath" pages="page 9, 12-13">
      <description>Bridge converts single AHB transfers to single APB transfers</description>
      <signals>HADDR, HWDATA, HTRANS, PADDR, PWDATA, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="CONV-1: Each AHB beat shall be converted to one APB transfer" page="page 9" test_ref="TEST_MAIN_DATAPATH_001"/>
        <requirement text="CONV-5: PADDR shall equal the captured AHB address" page="page 9" test_ref="TEST_MAIN_DATAPATH_002"/>
        <requirement text="CONV-7: PWDATA shall equal HWDATA (directly forwarded)" page="page 9" test_ref="TEST_MAIN_DATAPATH_003"/>
        <requirement text="CONV-8: HRDATA shall equal PRDATA (directly forwarded)" page="page 9" test_ref="TEST_MAIN_DATAPATH_004"/>
        <requirement text="CONV-2: AHB address captured when HSEL, HREADY_IN, and HTRANS[1] are HIGH" page="page 9" test_ref="TEST_MAIN_DATAPATH_008"/>
        <requirement text="CONV-6: PWRITE shall equal the captured HWRITE" page="page 9" test_ref="TEST_MAIN_DATAPATH_009"/>
      </requirements>
    </feature>
    <feature req_id="REQ_004" name="Burst Transfer Conversion" category="main_datapath" pages="page 9-11, 13-14">
      <description>Bridge converts AHB burst transfers to sequential APB transfers</description>
      <signals>HBURST, HTRANS, HADDR, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="BURST-1: Bursts shall be converted to sequential APB transfers (one per beat)" page="page 9" test_ref="TEST_MAIN_DATAPATH_005"/>
        <requirement text="BURST-3: For INCR bursts, address shall increment by transfer size each beat" page="page 9" test_ref="TEST_MAIN_DATAPATH_006"/>
        <requirement text="BURST-4: For WRAP bursts, address shall wrap at the calculated boundary" page="page 9" test_ref="TEST_MAIN_DATAPATH_007"/>
        <requirement text="BURST-5: Burst shall terminate on HTRANS=IDLE or HTRANS=NONSEQ (new burst)" page="page 9" test_ref="TEST_MAIN_DATAPATH_010"/>
        <requirement text="BURST-6: Bridge shall not initiate bursts that cross 1KB boundary" page="page 9" test_ref="TEST_MAIN_DATAPATH_011"/>
      </requirements>
    </feature>
    <feature req_id="REQ_005" name="Wait State Handling" category="protocol" pages="page 10, 14">
      <description>Bridge handles APB slave wait states by propagating to AHB</description>
      <signals>PREADY, HREADY_OUT, PENABLE, PSEL</signals>
      <requirements>
        <requirement text="WAIT-1: When APB slave asserts PREADY = 0, bridge shall hold HREADY_OUT = 0" page="page 10" test_ref="TEST_PROTOCOL_001"/>
        <requirement text="WAIT-4: Minimum APB transfer takes 2 cycles (SETUP + ACCESS with PREADY=1)" page="page 10" test_ref="TEST_PROTOCOL_002"/>
      </requirements>
    </feature>
    <feature req_id="REQ_006" name="Control Register" category="register_access" pages="page 8-9">
      <description>Control register at 0xF00 configures bridge operation</description>
      <signals>HADDR, HWDATA, HRDATA</signals>
      <requirements>
        <requirement text="CTRL register accessible at offset 0xF00 with R/W access" page="page 8" test_ref="TEST_REGISTER_ACCESS_001"/>
        <requirement text="ENABLE bit (bit 0) controls bridge enable with R/W access" page="page 8" test_ref="TEST_REGISTER_ACCESS_002"/>
      </requirements>
    </feature>
    <feature req_id="REQ_007" name="Status Register" category="register_access" pages="page 8">
      <description>Status register at 0xF04 reports bridge status and errors</description>
      <signals>HADDR, HRDATA</signals>
      <requirements>
        <requirement text="STATUS register accessible at offset 0xF04 with R/W1C access" page="page 8" test_ref="TEST_REGISTER_ACCESS_003"/>
        <requirement text="READY bit (bit 0) indicates bridge ready for transfer" page="page 8" test_ref="TEST_REGISTER_ACCESS_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_008" name="Error Address Register" category="register_access" pages="page 8">
      <description>Error address register at 0xF08 captures address of failed transfer</description>
      <signals>HADDR, HRDATA</signals>
      <requirements>
        <requirement text="ERROR_ADDR register captures address that caused error" page="page 8" test_ref="TEST_REGISTER_ACCESS_005"/>
      </requirements>
    </feature>
    <feature req_id="REQ_009" name="Error Info Register" category="register_access" pages="page 8-9">
      <description>Error info register at 0xF0C provides detailed error information</description>
      <signals>HADDR, HRDATA</signals>
      <requirements>
        <requirement text="ERROR_INFO register captures error type, beat number, and transfer details" page="page 8-9" test_ref="TEST_REGISTER_ACCESS_006"/>
      </requirements>
    </feature>
    <feature req_id="REQ_010" name="Address Error Detection" category="error" pages="page 11">
      <description>Bridge detects and reports address errors for invalid address ranges</description>
      <signals>HADDR, HRESP, STATUS, ERROR_ADDR</signals>
      <requirements>
        <requirement text="AERR-1: Address error occurs when HADDR is outside valid APB address range" page="page 11" test_ref="TEST_ERROR_001"/>
        <requirement text="AERR-3: On address error, bridge shall NOT initiate APB transfer" page="page 11" test_ref="TEST_ERROR_002"/>
        <requirement text="ERCV-5: Bridge accepts new transfer immediately after error completion" page="page 12" test_ref="TEST_ERROR_008"/>
      </requirements>
    </feature>
    <feature req_id="REQ_011" name="Timeout Error Detection" category="error" pages="page 11-12">
      <description>Bridge detects timeout when APB slave doesn't respond within configured time</description>
      <signals>PREADY, HRESP, STATUS, CTRL</signals>
      <requirements>
        <requirement text="TERR-1: Timeout error occurs when APB slave holds PREADY=0 too long" page="page 11" test_ref="TEST_ERROR_003"/>
        <requirement text="TERR-2: Timeout detection requires CTRL.TIMEOUT_EN = 1" page="page 11" test_ref="TEST_ERROR_004"/>
        <requirement text="TERR-3: Timeout value = 2^(CTRL.TIMEOUT_VAL+4) clock cycles" page="page 11" test_ref="TEST_ERROR_005"/>
        <requirement text="TERR-4: On timeout, bridge shall abort APB transfer (PSEL=0, PENABLE=0)" page="page 11" test_ref="TEST_ERROR_012"/>
      </requirements>
    </feature>
    <feature req_id="REQ_012" name="Protocol Error Detection" category="error" pages="page 12">
      <description>Bridge detects and reports protocol errors from APB slave PSLVERR signal</description>
      <signals>PSLVERR, HRESP, STATUS, ERROR_INFO</signals>
      <requirements>
        <requirement text="PERR-1: Protocol error occurs when APB slave asserts PSLVERR=1" page="page 12" test_ref="TEST_ERROR_006"/>
        <requirement text="PERR-2: PSLVERR is sampled when PENABLE=1 and PREADY=1" page="page 12" test_ref="TEST_ERROR_007"/>
        <requirement text="PERR-7: For bursts, error terminates remaining beats" page="page 12" test_ref="TEST_ERROR_011"/>
        <requirement text="ERPT-4: If CTRL.ERR_INT_EN=1, STATUS.ERR_INT shall be set on any error" page="page 12" test_ref="TEST_ERROR_009"/>
        <requirement text="ERPT-6: Multiple errors: only first error captured until cleared" page="page 12" test_ref="TEST_ERROR_010"/>
      </requirements>
    </feature>
    <feature req_id="REQ_013" name="Soft Reset" category="reset" pages="page 11">
      <description>Bridge supports software-initiated reset via CTRL register</description>
      <signals>CTRL, STATUS, HRESP</signals>
      <requirements>
        <requirement text="SRST-1: Writing 1 to CTRL.SOFT_RST shall initiate soft reset" page="page 11" test_ref="TEST_RESET_001"/>
        <requirement text="SRST-2: Soft reset shall abort any in-progress transfer" page="page 11" test_ref="TEST_RESET_002"/>
      </requirements>
    </feature>
    <feature req_id="REQ_014" name="Hard Reset" category="reset" pages="page 10-11">
      <description>Bridge supports asynchronous hardware reset via HRESETn/PRESETn</description>
      <signals>HRESETn, PRESETn, HREADY_OUT, HRESP, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="RST-1: HRESETn may be asserted asynchronously at any time" page="page 10" test_ref="TEST_RESET_003"/>
        <requirement text="RST-2: Upon reset assertion, all outputs shall be driven to safe state within 1 cycle" page="page 10" test_ref="TEST_RESET_004"/>
        <requirement text="RST-4: Bridge shall be ready for transfers 2 cycles after reset deassertion" page="page 10" test_ref="TEST_RESET_005"/>
      </requirements>
    </feature>
    <feature req_id="REQ_015" name="Stress Testing" category="stress" pages="page 5-6, 9">
      <description>Bridge handles high-throughput back-to-back transfers without errors</description>
      <signals>HTRANS, HREADY_OUT, PREADY, STATUS</signals>
      <requirements>
        <requirement text="Bridge shall handle continuous back-to-back transfers without performance degradation" page="page 5-6" test_ref="TEST_STRESS_001"/>
      </requirements>
    </feature>
  </features>

  <test_suites>
    <test_suite name="connectivity_tests" category="connectivity" count="4">
      <test_case test_id="TEST_CONNECTIVITY_001" name="ahb_idle_hready_high">
        <req_ref>REQ_001</req_ref>
        <objective>Verify HREADY_OUT is HIGH when bridge is in IDLE state</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>No active transfers</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Drive HTRANS=2'b00 (IDLE), HSEL=1, all other signals stable</action>
            <expected>Interface in IDLE state</expected>
          </step>
          <step num="2">
            <action>Sample HREADY_OUT at clock rising edge</action>
            <expected>HREADY_OUT=1</expected>
          </step>
          <step num="3">
            <action>Hold IDLE state for 5 cycles, sample HREADY_OUT each cycle</action>
            <expected>HREADY_OUT=1 for all 5 cycles</expected>
          </step>
        </steps>
        <pass_criteria>HREADY_OUT remains HIGH throughout IDLE state</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_002" name="ahb_wait_state_stability">
        <req_ref>REQ_001</req_ref>
        <objective>Verify control signals remain stable during wait states</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Transfer initiated</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Drive HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HSIZE=3'b010, HSEL=1, HREADY_IN=1</action>
            <expected>Transfer address phase captured</expected>
          </step>
          <step num="2">
            <action>Drive HREADY_OUT=0 to insert wait state</action>
            <expected>Wait state inserted</expected>
          </step>
          <step num="3">
            <action>Hold all control signals stable for 3 cycles while HREADY_OUT=0</action>
            <expected>HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HSIZE=3'b010 remain stable</expected>
          </step>
          <step num="4">
            <action>Drive HREADY_OUT=1 to complete transfer</action>
            <expected>Transfer completes with stable control signals</expected>
          </step>
        </steps>
        <pass_criteria>All control signals remain stable during wait states</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_003" name="apb_psel_entire_transfer">
        <req_ref>REQ_002</req_ref>
        <objective>Verify PSEL remains HIGH for both SETUP and ACCESS phases</objective>
        <preconditions>
          <condition>PCLK running at 100MHz</condition>
          <condition>PRESETn deasserted</condition>
          <condition>Interface in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive PSEL=1, PADDR=0x0000_2000, PWRITE=1, PWDATA=0x1234_5678, PENABLE=0</action>
            <expected>SETUP phase begins, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T2, drive PENABLE=1, all other signals unchanged</action>
            <expected>ACCESS phase begins, PSEL=1, PENABLE=1</expected>
          </step>
          <step num="3">
            <action>Sample PSEL during both T1 and T2</action>
            <expected>PSEL=1 for entire transfer duration</expected>
          </step>
          <step num="4">
            <action>At T3, drive PSEL=0, PENABLE=0 to end transfer</action>
            <expected>Transfer ends, return to IDLE</expected>
          </step>
        </steps>
        <pass_criteria>PSEL=1 maintained for both SETUP and ACCESS phases</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_004" name="apb_penable_phases">
        <req_ref>REQ_002</req_ref>
        <objective>Verify PENABLE transitions correctly between SETUP and ACCESS phases</objective>
        <preconditions>
          <condition>PCLK running at 100MHz</condition>
          <condition>PRESETn deasserted</condition>
          <condition>Interface in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive PSEL=1, PADDR=0x0000_3000, PWRITE=0, PENABLE=0</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>Sample PENABLE at T1</action>
            <expected>PENABLE=0 during SETUP phase</expected>
          </step>
          <step num="3">
            <action>At T2, drive PENABLE=1, all other signals stable</action>
            <expected>ACCESS phase, PSEL=1, PENABLE=1</expected>
          </step>
          <step num="4">
            <action>Sample PENABLE at T2</action>
            <expected>PENABLE=1 during ACCESS phase</expected>
          </step>
          <step num="5">
            <action>Sample PRDATA when PREADY=1</action>
            <expected>Read data valid, transfer completes</expected>
          </step>
        </steps>
        <pass_criteria>PENABLE=0 in SETUP, PENABLE=1 in ACCESS phase</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="cross_feature_tests" category="cross_feature" count="4">
      <test_case test_id="TEST_CROSS_FEATURE_001" name="reset_during_burst_transfer">
        <req_ref></req_ref>
        <features_involved>Burst Transfer Conversion, Hard Reset</features_involved>
        <objective>Verify hard reset during burst transfer recovers correctly without data corruption</objective>
        <preconditions>
          <condition>INCR4 burst in progress</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start INCR4 burst: HTRANS=2'b10, HBURST=3'b011, HADDR=0x0000_4000, HWRITE=1</action>
            <expected>Burst initiated, first beat begins</expected>
          </step>
          <step num="2">
            <action>Complete first two beats: write 0x1111_1111 to 0x4000, 0x2222_2222 to 0x4004</action>
            <expected>First two APB transfers complete successfully</expected>
          </step>
          <step num="3">
            <action>During third beat ACCESS phase, assert HRESETn=0</action>
            <expected>Reset asserted mid-burst</expected>
          </step>
          <step num="4">
            <action>Hold HRESETn=0 for 3 cycles</action>
            <expected>All outputs at reset values: PSEL=0, PENABLE=0, HREADY_OUT=1</expected>
          </step>
          <step num="5">
            <action>Deassert HRESETn=1 synchronously</action>
            <expected>Reset released, bridge initialization begins</expected>
          </step>
          <step num="6">
            <action>Wait 2 cycles for bridge ready</action>
            <expected>Bridge ready for new transfers</expected>
          </step>
          <step num="7">
            <action>Read completed locations: 0x4000 and 0x4004</action>
            <expected>0x4000→0x1111_1111, 0x4004→0x2222_2222 (completed beats preserved)</expected>
          </step>
          <step num="8">
            <action>Read incomplete locations: 0x4008 and 0x400C</action>
            <expected>Original values (beats 3&amp;4 not written due to reset)</expected>
          </step>
          <step num="9">
            <action>Test new transfer: write 0xDEAD_BEEF to 0x5000, read back</action>
            <expected>HRDATA=0xDEAD_BEEF, bridge fully recovered</expected>
          </step>
        </steps>
        <pass_criteria>Reset cleanly aborts burst, preserves completed data, fully recovers for new transfers</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_002" name="timeout_error_during_register_access">
        <req_ref></req_ref>
        <features_involved>Timeout Error Detection, Control Register</features_involved>
        <objective>Verify timeout error handling doesn't affect register access functionality</objective>
        <preconditions>
          <condition>Timeout enabled</condition>
          <condition>Register access working</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure timeout: write 0x0000_0081 to CTRL (16-cycle timeout)</action>
            <expected>CTRL configured, timeout enabled</expected>
          </step>
          <step num="2">
            <action>Cause timeout error: transfer with PREADY=0 for 20 cycles</action>
            <expected>Timeout error occurs, STATUS.TIMEOUT_ERR=1</expected>
          </step>
          <step num="3">
            <action>Read CTRL register after timeout error</action>
            <expected>CTRL=0x0000_0081, register access unaffected</expected>
          </step>
          <step num="4">
            <action>Read STATUS register</action>
            <expected>STATUS.TIMEOUT_ERR=1, error properly recorded</expected>
          </step>
          <step num="5">
            <action>Read ERROR_ADDR register</action>
            <expected>ERROR_ADDR captures timeout transfer address</expected>
          </step>
          <step num="6">
            <action>Clear error: write 0x0000_0040 to STATUS</action>
            <expected>STATUS.TIMEOUT_ERR=0, error cleared via register</expected>
          </step>
          <step num="7">
            <action>Modify CTRL: change timeout value to 0x0000_0091 (32 cycles)</action>
            <expected>CTRL register write successful despite prior error</expected>
          </step>
          <step num="8">
            <action>Test new timeout value: PREADY=0 for 35 cycles</action>
            <expected>Timeout occurs at 32 cycles, confirming register modification</expected>
          </step>
        </steps>
        <pass_criteria>Register access works normally before, during, and after timeout errors</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_003" name="soft_reset_during_address_error">
        <req_ref></req_ref>
        <features_involved>Address Error Detection, Soft Reset</features_involved>
        <objective>Verify soft reset properly clears address error state and registers</objective>
        <preconditions>
          <condition>Address error occurred</condition>
          <condition>Error registers populated</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Generate address error: transfer to invalid address 0x0010_0000</action>
            <expected>Address error detected, HRESP=1</expected>
          </step>
          <step num="2">
            <action>Verify error state: read STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>STATUS.ADDR_ERR=1, ERROR_ADDR=0x0010_0000, ERR_TYPE=4'h1</expected>
          </step>
          <step num="3">
            <action>Initiate soft reset: write SOFT_RST=1 to CTRL</action>
            <expected>Soft reset initiated</expected>
          </step>
          <step num="4">
            <action>Wait 2 cycles for soft reset completion</action>
            <expected>Soft reset completes, SOFT_RST self-clears</expected>
          </step>
          <step num="5">
            <action>Read STATUS register after soft reset</action>
            <expected>STATUS=0x0000_0001 (ADDR_ERR cleared, READY=1)</expected>
          </step>
          <step num="6">
            <action>Read ERROR_ADDR after soft reset</action>
            <expected>ERROR_ADDR=0x0000_0000 (cleared)</expected>
          </step>
          <step num="7">
            <action>Read ERROR_INFO after soft reset</action>
            <expected>ERROR_INFO=0x0000_0000 (cleared)</expected>
          </step>
          <step num="8">
            <action>Test valid transfer: write 0x5555_AAAA to 0x0000_6000</action>
            <expected>Transfer succeeds, no error</expected>
          </step>
          <step num="9">
            <action>Test same invalid address again: 0x0010_0000</action>
            <expected>New address error detected, ERROR_ADDR updated</expected>
          </step>
        </steps>
        <pass_criteria>Soft reset clears all error state, registers zeroed, new errors detected properly</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_004" name="burst_with_wait_states_and_timeout">
        <req_ref></req_ref>
        <features_involved>Burst Transfer Conversion, Wait State Handling, Timeout Error Detection</features_involved>
        <objective>Verify burst handling with APB wait states doesn't cause false timeout</objective>
        <preconditions>
          <condition>INCR4 burst ready</condition>
          <condition>Timeout configured</condition>
          <condition>APB slave with wait states</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure timeout: write 0x0000_0091 to CTRL (TIMEOUT_EN=1, TIMEOUT_VAL=3'b001, 32 cycles, ENABLE=1)</action>
            <expected>Timeout set to 32 cycles</expected>
          </step>
          <step num="2">
            <action>Start INCR4 burst: HADDR=0x7000, data pattern 0xAAAA_0000 + beat</action>
            <expected>Burst initiated</expected>
          </step>
          <step num="3">
            <action>For each beat, insert 10 wait states (PREADY=0 for 10 cycles)</action>
            <expected>Each APB transfer takes 12 cycles (2 base + 10 wait)</expected>
          </step>
          <step num="4">
            <action>Complete all 4 beats with wait states (total ~48 cycles)</action>
            <expected>All beats complete within timeout limit</expected>
          </step>
          <step num="5">
            <action>Read STATUS register</action>
            <expected>STATUS.TIMEOUT_ERR=0, no timeout error</expected>
          </step>
          <step num="6">
            <action>Verify all burst data written correctly</action>
            <expected>0x7000→0xAAAA_0000, 0x7004→0xAAAA_0001, etc.</expected>
          </step>
          <step num="7">
            <action>Test timeout boundary: single transfer with 33 wait states</action>
            <expected>Timeout error occurs (exceeds 32-cycle limit)</expected>
          </step>
        </steps>
        <pass_criteria>Burst completes with wait states under timeout limit, timeout works when exceeded</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="error_tests" category="error" count="12">
      <test_case test_id="TEST_ERROR_001" name="address_error_detection">
        <req_ref>REQ_010</req_ref>
        <objective>Verify bridge detects invalid address ranges and generates address error</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge address range fixed at 0x0000_0000 to 0x0000_FFFF (not configurable, AERR-2 default)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Clear any existing errors, read STATUS register</action>
            <expected>STATUS=0x0000_0001 (READY=1, no errors)</expected>
          </step>
          <step num="2">
            <action>Test valid address: HTRANS=2'b10, HADDR=0x0000_8000, HWRITE=1, HWDATA=0x1234_5678</action>
            <expected>Transfer succeeds, HRESP=0 (OKAY)</expected>
          </step>
          <step num="3">
            <action>Read STATUS after valid transfer</action>
            <expected>STATUS.ADDR_ERR=0, no error reported</expected>
          </step>
          <step num="4">
            <action>Test invalid address: HTRANS=2'b10, HADDR=0x0001_0000, HWRITE=1, HWDATA=0xABCD_EF01</action>
            <expected>Address outside valid range (&gt;0x0000_FFFF)</expected>
          </step>
          <step num="5">
            <action>Sample HRESP during invalid transfer</action>
            <expected>HRESP=1 (ERROR) for 2 cycles per AHB protocol</expected>
          </step>
          <step num="6">
            <action>Read STATUS register after address error</action>
            <expected>STATUS.ADDR_ERR=1 (bit 4 set)</expected>
          </step>
          <step num="7">
            <action>Read ERROR_ADDR register</action>
            <expected>ERROR_ADDR=0x0001_0000 (captured invalid address)</expected>
          </step>
          <step num="8">
            <action>Read ERROR_INFO register</action>
            <expected>ERR_TYPE=4'h1 (address error), ERR_WRITE=1</expected>
          </step>
          <step num="9">
            <action>Clear error: write 0x0000_0010 to STATUS (clear ADDR_ERR)</action>
            <expected>STATUS.ADDR_ERR=0, error cleared</expected>
          </step>
          <step num="10">
            <action>Test boundary: HADDR=0x0000_FFFF (max valid)</action>
            <expected>Transfer succeeds, HRESP=0</expected>
          </step>
          <step num="11">
            <action>Test boundary: HADDR=0x0001_0000 (min invalid)</action>
            <expected>Address error, HRESP=1</expected>
          </step>
          <step num="12">
            <action>Reconfigure and test: write 0xCAFE_BABE to valid address 0x0000_7000</action>
            <expected>Transfer succeeds after error recovery</expected>
          </step>
          <step num="13">
            <action>Read back from 0x0000_7000</action>
            <expected>HRDATA=0xCAFE_BABE, proving device operational</expected>
          </step>
          <step num="14">
            <action>Read STATUS register after recovery test</action>
            <expected>STATUS.ADDR_ERR=0, no new errors</expected>
          </step>
          <step num="15">
            <action>Verify ERROR_ADDR unchanged after successful transfer</action>
            <expected>ERROR_ADDR retains last error address for debugging</expected>
          </step>
        </steps>
        <pass_criteria>1. Valid addresses succeed. 2. Invalid addresses generate HRESP=ERROR. 3. STATUS.ADDR_ERR set. 4. Error registers capture details. 5. Recovery works.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_002" name="address_error_no_apb">
        <req_ref>REQ_010</req_ref>
        <objective>Verify no APB transfer initiated for address errors</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Monitor APB signals in IDLE state</action>
            <expected>PSEL=0, PENABLE=0, no APB activity</expected>
          </step>
          <step num="2">
            <action>Initiate invalid transfer: HADDR=0x0010_0000, HTRANS=2'b10, HWRITE=1</action>
            <expected>AHB address phase captured</expected>
          </step>
          <step num="3">
            <action>Monitor APB signals during address error detection</action>
            <expected>PSEL=0, PENABLE=0, no APB transfer initiated</expected>
          </step>
          <step num="4">
            <action>Sample HRESP during error response</action>
            <expected>HRESP=1, AHB error response without APB activity</expected>
          </step>
          <step num="5">
            <action>Continue monitoring APB through error response completion</action>
            <expected>PSEL=0, PENABLE=0 throughout error response</expected>
          </step>
          <step num="6">
            <action>Initiate valid transfer after error: HADDR=0x0000_5000</action>
            <expected>APB transfer initiated: PSEL=1, PENABLE=0 (SETUP)</expected>
          </step>
        </steps>
        <pass_criteria>APB remains idle during address error, only valid addresses trigger APB transfers</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_003" name="timeout_error_detection">
        <req_ref>REQ_011</req_ref>
        <objective>Verify timeout error when APB slave doesn't respond within timeout period</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>TIMEOUT_EN enabled, TIMEOUT_VAL=3'b000 (16 cycles)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure timeout: write 0x0000_0081 to CTRL (TIMEOUT_EN=1, TIMEOUT_VAL=0, ENABLE=1)</action>
            <expected>Timeout enabled with 16-cycle limit</expected>
          </step>
          <step num="2">
            <action>Clear any errors, read STATUS</action>
            <expected>STATUS=0x0000_0001 (clean state)</expected>
          </step>
          <step num="3">
            <action>Initiate transfer: HTRANS=2'b10, HADDR=0x0000_4000, HWRITE=1, HWDATA=0xFEED_FACE</action>
            <expected>Transfer begins</expected>
          </step>
          <step num="4">
            <action>APB SETUP phase completes, ACCESS phase begins</action>
            <expected>PSEL=1, PENABLE=1</expected>
          </step>
          <step num="5">
            <action>Drive PREADY=0 for exactly 16 cycles</action>
            <expected>APB slave holds transfer, timeout counter runs</expected>
          </step>
          <step num="6">
            <action>At cycle 17, sample HRESP</action>
            <expected>HRESP=1 (ERROR), timeout detected</expected>
          </step>
          <step num="7">
            <action>Observe APB signals after timeout</action>
            <expected>PSEL=0, PENABLE=0, APB transfer aborted</expected>
          </step>
          <step num="8">
            <action>Read STATUS register</action>
            <expected>STATUS.TIMEOUT_ERR=1 (bit 6 set)</expected>
          </step>
          <step num="9">
            <action>Read ERROR_ADDR register</action>
            <expected>ERROR_ADDR=0x0000_4000 (timeout address captured)</expected>
          </step>
          <step num="10">
            <action>Read ERROR_INFO register</action>
            <expected>ERR_TYPE=4'h2 (timeout), ERR_WRITE=1</expected>
          </step>
          <step num="11">
            <action>Clear timeout error: write 0x0000_0040 to STATUS</action>
            <expected>STATUS.TIMEOUT_ERR=0</expected>
          </step>
          <step num="12">
            <action>Test with responsive slave: PREADY=1 immediately</action>
            <expected>Transfer completes in 2 cycles, no timeout</expected>
          </step>
          <step num="13">
            <action>Verify successful transfer: write 0x1111_2222 to 0x4000, read back</action>
            <expected>HRDATA=0x1111_2222, device recovered</expected>
          </step>
          <step num="14">
            <action>Read STATUS after successful recovery</action>
            <expected>STATUS.TIMEOUT_ERR=0, no errors</expected>
          </step>
          <step num="15">
            <action>Test timeout boundary: PREADY=0 for 15 cycles, then PREADY=1</action>
            <expected>Transfer completes without timeout (within limit)</expected>
          </step>
        </steps>
        <pass_criteria>1. Timeout after 16 cycles with PREADY=0. 2. HRESP=ERROR generated. 3. STATUS.TIMEOUT_ERR set. 4. APB transfer aborted. 5. Recovery works.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_004" name="timeout_enable_control">
        <req_ref>REQ_011</req_ref>
        <objective>Verify timeout only occurs when TIMEOUT_EN=1</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Disable timeout: write 0x0000_0001 to CTRL (TIMEOUT_EN=0, ENABLE=1)</action>
            <expected>Timeout detection disabled</expected>
          </step>
          <step num="2">
            <action>Initiate transfer: HADDR=0x0000_5000, HWRITE=1</action>
            <expected>Transfer begins</expected>
          </step>
          <step num="3">
            <action>Drive PREADY=0 for 100 cycles (well beyond any timeout)</action>
            <expected>Transfer waits indefinitely, no timeout error</expected>
          </step>
          <step num="4">
            <action>Read STATUS during extended wait</action>
            <expected>STATUS.TIMEOUT_ERR=0, no timeout detected</expected>
          </step>
          <step num="5">
            <action>Drive PREADY=1 to complete transfer</action>
            <expected>Transfer completes normally after long wait</expected>
          </step>
          <step num="6">
            <action>Enable timeout: write 0x0000_0081 to CTRL (TIMEOUT_EN=1)</action>
            <expected>Timeout detection enabled</expected>
          </step>
          <step num="7">
            <action>Repeat test with PREADY=0 for 20 cycles</action>
            <expected>Timeout error occurs when enabled</expected>
          </step>
        </steps>
        <pass_criteria>Timeout only occurs when TIMEOUT_EN=1, disabled when TIMEOUT_EN=0</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_005" name="timeout_value_configuration">
        <req_ref>REQ_011</req_ref>
        <objective>Verify timeout values match 2^(VAL+4) formula</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure TIMEOUT_VAL=3'b000: write 0x0000_0081 to CTRL</action>
            <expected>Timeout = 2^(0+4) = 16 cycles</expected>
          </step>
          <step num="2">
            <action>Test 16-cycle timeout: PREADY=0 for 15 cycles, then PREADY=1</action>
            <expected>Transfer completes, no timeout</expected>
          </step>
          <step num="3">
            <action>Test 16-cycle timeout: PREADY=0 for 16 cycles</action>
            <expected>Timeout error at cycle 16</expected>
          </step>
          <step num="4">
            <action>Configure TIMEOUT_VAL=3'b001: write 0x0000_0091 to CTRL</action>
            <expected>Timeout = 2^(1+4) = 32 cycles</expected>
          </step>
          <step num="5">
            <action>Test 32-cycle timeout: PREADY=0 for 31 cycles, then PREADY=1</action>
            <expected>Transfer completes, no timeout</expected>
          </step>
          <step num="6">
            <action>Test 32-cycle timeout: PREADY=0 for 32 cycles</action>
            <expected>Timeout error at cycle 32</expected>
          </step>
          <step num="7">
            <action>Configure TIMEOUT_VAL=3'b010: write 0x0000_00A1 to CTRL</action>
            <expected>Timeout = 2^(2+4) = 64 cycles</expected>
          </step>
          <step num="8">
            <action>Test 64-cycle timeout: PREADY=0 for 63 cycles, then PREADY=1</action>
            <expected>Transfer completes, no timeout</expected>
          </step>
        </steps>
        <pass_criteria>Timeout periods match 2^(TIMEOUT_VAL+4): 16, 32, 64, 128, 256, 512, 1024, 2048 cycles</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_006" name="protocol_error_detection">
        <req_ref>REQ_012</req_ref>
        <objective>Verify bridge detects PSLVERR and generates protocol error</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Clear errors, read STATUS</action>
            <expected>STATUS=0x0000_0001 (clean state)</expected>
          </step>
          <step num="2">
            <action>Initiate normal transfer: HADDR=0x0000_6000, HWRITE=1, HWDATA=0x8765_4321</action>
            <expected>Transfer begins normally</expected>
          </step>
          <step num="3">
            <action>APB ACCESS phase: PSEL=1, PENABLE=1</action>
            <expected>ACCESS phase active</expected>
          </step>
          <step num="4">
            <action>Drive PSLVERR=1, PREADY=1 simultaneously</action>
            <expected>APB slave reports error with transfer complete</expected>
          </step>
          <step num="5">
            <action>Sample HRESP immediately after PSLVERR=1</action>
            <expected>HRESP=1 (ERROR) propagated from APB</expected>
          </step>
          <step num="6">
            <action>Verify HRESP held for 2 cycles per AHB protocol</action>
            <expected>HRESP=1 for exactly 2 cycles</expected>
          </step>
          <step num="7">
            <action>Read STATUS register after protocol error</action>
            <expected>STATUS.PSLVERR=1 (bit 5 set)</expected>
          </step>
          <step num="8">
            <action>Read ERROR_ADDR register</action>
            <expected>ERROR_ADDR=0x0000_6000 (error address captured)</expected>
          </step>
          <step num="9">
            <action>Read ERROR_INFO register</action>
            <expected>ERR_TYPE=4'h3 (protocol error), ERR_WRITE=1</expected>
          </step>
          <step num="10">
            <action>Test read transfer with error: HWRITE=0, PSLVERR=1</action>
            <expected>Protocol error on read, ERR_WRITE=0 in ERROR_INFO</expected>
          </step>
          <step num="11">
            <action>Clear protocol error: write 0x0000_0020 to STATUS</action>
            <expected>STATUS.PSLVERR=0</expected>
          </step>
          <step num="12">
            <action>Test normal transfer: PSLVERR=0, PREADY=1</action>
            <expected>Transfer completes successfully, HRESP=0</expected>
          </step>
          <step num="13">
            <action>Verify recovery: write 0x2468_ACE0 to 0x6000, read back</action>
            <expected>HRDATA=0x2468_ACE0, device operational</expected>
          </step>
          <step num="14">
            <action>Read STATUS after successful recovery</action>
            <expected>STATUS.PSLVERR=0, no errors</expected>
          </step>
          <step num="15">
            <action>Test burst with protocol error on beat 2</action>
            <expected>Error terminates burst, remaining beats not executed</expected>
          </step>
        </steps>
        <pass_criteria>1. PSLVERR=1 generates HRESP=ERROR. 2. STATUS.PSLVERR set. 3. Error details captured. 4. Recovery works. 5. Burst terminated on error.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_007" name="pslverr_sampling_conditions">
        <req_ref>REQ_012</req_ref>
        <objective>Verify PSLVERR only sampled during valid APB completion</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Transfer in progress</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start transfer, reach SETUP phase</action>
            <expected>PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>Drive PSLVERR=1 during SETUP phase (PENABLE=0)</action>
            <expected>PSLVERR ignored, no error detected</expected>
          </step>
          <step num="3">
            <action>Enter ACCESS phase: PENABLE=1, PREADY=0, PSLVERR=1</action>
            <expected>PSLVERR ignored while PREADY=0</expected>
          </step>
          <step num="4">
            <action>Complete transfer: PENABLE=1, PREADY=1, PSLVERR=1</action>
            <expected>PSLVERR sampled, protocol error detected</expected>
          </step>
          <step num="5">
            <action>Verify error only occurs at completion</action>
            <expected>STATUS.PSLVERR=1, error captured</expected>
          </step>
        </steps>
        <pass_criteria>PSLVERR only causes error when PENABLE=1 AND PREADY=1</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_008" name="error_recovery_back_to_back">
        <req_ref>REQ_010</req_ref>
        <objective>Verify bridge accepts new valid transfer immediately after error completion (ERCV-5)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Generate address error: HTRANS=2'b10, HADDR=0x0010_0000, HWRITE=1</action>
            <expected>Address error detected, HRESP=1</expected>
          </step>
          <step num="2">
            <action>On the very next cycle after error response completes, drive valid transfer: HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HWDATA=0xBACK_2BAC</action>
            <expected>Bridge accepts new transfer immediately — no idle gap required</expected>
          </step>
          <step num="3">
            <action>Complete valid transfer with PREADY=1</action>
            <expected>Transfer succeeds, HRESP=0, data written to 0x1000</expected>
          </step>
          <step num="4">
            <action>Read back from 0x1000</action>
            <expected>HRDATA=0xBACK_2BAC, confirming valid transfer completed correctly</expected>
          </step>
          <step num="5">
            <action>Generate timeout error, immediately follow with valid transfer on next cycle</action>
            <expected>Valid transfer succeeds immediately after timeout error</expected>
          </step>
          <step num="6">
            <action>Generate PSLVERR error, immediately follow with valid transfer on next cycle</action>
            <expected>Valid transfer succeeds immediately after protocol error</expected>
          </step>
        </steps>
        <pass_criteria>Bridge recovers from all error types and accepts new transfer on the immediately following cycle</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_009" name="error_interrupt_enable">
        <req_ref>REQ_012</req_ref>
        <objective>Verify ERR_INT_EN in CTRL enables STATUS.ERR_INT on any error (ERPT-4)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Disable error interrupt: write 0x0000_0071 to CTRL (ERR_INT_EN=0)</action>
            <expected>CTRL.ERR_INT_EN=0, error interrupts disabled</expected>
          </step>
          <step num="2">
            <action>Generate address error: HADDR=0x0010_0000</action>
            <expected>Address error occurs, STATUS.ADDR_ERR=1</expected>
          </step>
          <step num="3">
            <action>Read STATUS register</action>
            <expected>STATUS.ADDR_ERR=1, STATUS.ERR_INT=0 (interrupt NOT set because ERR_INT_EN=0)</expected>
          </step>
          <step num="4">
            <action>Clear error: write W1C to STATUS</action>
            <expected>STATUS error bits cleared</expected>
          </step>
          <step num="5">
            <action>Enable error interrupt: write 0x0000_0079 to CTRL (ERR_INT_EN=1, ENABLE=1)</action>
            <expected>CTRL.ERR_INT_EN=1, error interrupts enabled</expected>
          </step>
          <step num="6">
            <action>Generate address error again: HADDR=0x0010_0000</action>
            <expected>Address error occurs</expected>
          </step>
          <step num="7">
            <action>Read STATUS register</action>
            <expected>STATUS.ADDR_ERR=1 AND STATUS.ERR_INT=1 (bit 7 set because ERR_INT_EN=1)</expected>
          </step>
          <step num="8">
            <action>Clear ERR_INT: write 0x0000_0080 to STATUS</action>
            <expected>STATUS.ERR_INT=0, interrupt cleared</expected>
          </step>
          <step num="9">
            <action>Generate timeout error with ERR_INT_EN=1</action>
            <expected>STATUS.TIMEOUT_ERR=1 AND STATUS.ERR_INT=1</expected>
          </step>
          <step num="10">
            <action>Generate PSLVERR error with ERR_INT_EN=1</action>
            <expected>STATUS.PSLVERR=1 AND STATUS.ERR_INT=1</expected>
          </step>
        </steps>
        <pass_criteria>1. ERR_INT_EN=0: errors set error bits but NOT ERR_INT. 2. ERR_INT_EN=1: all error types set ERR_INT. 3. ERR_INT clearable via W1C.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_010" name="multiple_errors_first_captured">
        <req_ref>REQ_012</req_ref>
        <objective>Verify only first error is captured in ERROR_ADDR/ERROR_INFO until cleared (ERPT-6)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Generate first error: address error at 0x0010_0000 (write, word)</action>
            <expected>First error captured: ERROR_ADDR=0x0010_0000, ERR_TYPE=1</expected>
          </step>
          <step num="2">
            <action>Read ERROR_ADDR and ERROR_INFO after first error</action>
            <expected>ERROR_ADDR=0x0010_0000, ERROR_INFO.ERR_TYPE=4'h1, ERR_WRITE=1</expected>
          </step>
          <step num="3">
            <action>Generate second error WITHOUT clearing first: address error at 0x0020_0000 (read)</action>
            <expected>Second error occurs but error registers should NOT update</expected>
          </step>
          <step num="4">
            <action>Read ERROR_ADDR and ERROR_INFO after second error</action>
            <expected>ERROR_ADDR still 0x0010_0000, ERROR_INFO still shows first error — second error NOT captured</expected>
          </step>
          <step num="5">
            <action>Verify STATUS has both errors flagged</action>
            <expected>STATUS.ADDR_ERR=1 (both errors set this bit, W1C sticky)</expected>
          </step>
          <step num="6">
            <action>Clear error: write W1C to STATUS, clearing ADDR_ERR</action>
            <expected>STATUS.ADDR_ERR=0, error cleared</expected>
          </step>
          <step num="7">
            <action>Generate third error: address error at 0x0030_0000</action>
            <expected>Error registers now update with new error (first was cleared)</expected>
          </step>
          <step num="8">
            <action>Read ERROR_ADDR after clearing and new error</action>
            <expected>ERROR_ADDR=0x0030_0000, new error captured after clear</expected>
          </step>
        </steps>
        <pass_criteria>1. First error captured in ERROR_ADDR/ERROR_INFO. 2. Subsequent errors do NOT overwrite until cleared. 3. After clear, new errors captured.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_011" name="burst_terminated_on_protocol_error">
        <req_ref>REQ_012</req_ref>
        <objective>Verify PSLVERR during burst terminates remaining beats (PERR-7)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge operational</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start INCR4 burst: HTRANS=2'b10, HBURST=3'b011, HADDR=0x0000_8000, HWRITE=1</action>
            <expected>INCR4 burst initiated</expected>
          </step>
          <step num="2">
            <action>Complete first beat: HWDATA=0x1111_1111, PSLVERR=0, PREADY=1</action>
            <expected>First APB transfer completes successfully at 0x8000</expected>
          </step>
          <step num="3">
            <action>Second beat: HWDATA=0x2222_2222, drive PSLVERR=1 and PREADY=1</action>
            <expected>Protocol error detected on second beat</expected>
          </step>
          <step num="4">
            <action>Sample HRESP during error response</action>
            <expected>HRESP=1 (ERROR), error propagated to AHB</expected>
          </step>
          <step num="5">
            <action>Monitor for beats 3 and 4: check if APB transfers initiated</action>
            <expected>No further APB transfers — PSEL=0, PENABLE=0, burst terminated</expected>
          </step>
          <step num="6">
            <action>Read ERROR_ADDR and ERROR_INFO</action>
            <expected>ERROR_ADDR=0x0000_8004, ERR_TYPE=4'h3 (protocol), ERR_BEAT captures beat number</expected>
          </step>
          <step num="7">
            <action>Verify beat 1 data preserved: read from 0x8000</action>
            <expected>HRDATA=0x1111_1111 (completed before error)</expected>
          </step>
          <step num="8">
            <action>Test recovery: new transfer to 0x9000</action>
            <expected>Transfer succeeds, bridge recovered from burst termination</expected>
          </step>
        </steps>
        <pass_criteria>1. PSLVERR on any beat terminates remaining burst. 2. Completed beats preserved. 3. Error registers capture correct beat. 4. Bridge recovers.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_012" name="apb_deassert_after_timeout">
        <req_ref>REQ_011</req_ref>
        <objective>Verify APB signals are deasserted (PSEL=0, PENABLE=0) after timeout error (TERR-4)</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn deasserted</condition>
          <condition>TIMEOUT_EN=1, TIMEOUT_VAL=000 (16-cycle timeout)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure timeout: write 0x0000_0081 to CTRL</action>
            <expected>16-cycle timeout enabled</expected>
          </step>
          <step num="2">
            <action>Initiate transfer: HADDR=0x0000_4000, HWRITE=1</action>
            <expected>Transfer begins, APB SETUP then ACCESS</expected>
          </step>
          <step num="3">
            <action>During ACCESS phase, verify PSEL=1 and PENABLE=1</action>
            <expected>APB transfer active: PSEL=1, PENABLE=1</expected>
          </step>
          <step num="4">
            <action>Hold PREADY=0 for 16+ cycles to trigger timeout</action>
            <expected>Timeout counter expires, timeout error detected</expected>
          </step>
          <step num="5">
            <action>Immediately after timeout, sample PSEL and PENABLE</action>
            <expected>PSEL=0, PENABLE=0 — APB transfer aborted per TERR-4</expected>
          </step>
          <step num="6">
            <action>Verify HRESP=1 on AHB side</action>
            <expected>HRESP=1 (ERROR) for timeout</expected>
          </step>
          <step num="7">
            <action>Read STATUS register</action>
            <expected>STATUS.TIMEOUT_ERR=1</expected>
          </step>
          <step num="8">
            <action>Verify bridge returns to IDLE and accepts new transfer</action>
            <expected>New transfer to 0x5000 succeeds, PSEL/PENABLE cycle correctly</expected>
          </step>
        </steps>
        <pass_criteria>1. PSEL and PENABLE deasserted immediately on timeout. 2. APB transfer cleanly aborted. 3. Bridge recovers for new transfers.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="main_datapath_tests" category="main_datapath" count="11">
      <test_case test_id="TEST_MAIN_DATAPATH_001" name="single_write_conversion">
        <req_ref>REQ_003</req_ref>
        <objective>Verify single AHB write converts to single APB write</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
          <condition>Bridge in IDLE state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HSIZE=3'b010, HSEL=1, HREADY_IN=1</action>
            <expected>AHB address phase captured</expected>
          </step>
          <step num="2">
            <action>At T2, drive HWDATA=0xDEAD_BEEF, observe APB signals</action>
            <expected>PSEL=1, PENABLE=0, PADDR=0x0000_1000, PWRITE=1, PWDATA=0xDEAD_BEEF (SETUP phase)</expected>
          </step>
          <step num="3">
            <action>At T3, observe APB signals</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_1000, PWRITE=1, PWDATA=0xDEAD_BEEF (ACCESS phase)</expected>
          </step>
          <step num="4">
            <action>Drive PREADY=1 at T3</action>
            <expected>APB transfer completes, HREADY_OUT=1</expected>
          </step>
          <step num="5">
            <action>At T4, observe APB signals</action>
            <expected>PSEL=0, PENABLE=0, return to IDLE</expected>
          </step>
          <step num="6">
            <action>Verify by reading back: HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=0</action>
            <expected>Read transfer initiated</expected>
          </step>
          <step num="7">
            <action>Sample PRDATA when PREADY=1 during read</action>
            <expected>PRDATA=0xDEAD_BEEF, confirming write success</expected>
          </step>
        </steps>
        <pass_criteria>1. Single AHB beat converts to single APB transfer. 2. Address and data forwarded correctly. 3. Read-back confirms write.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_002" name="address_forwarding">
        <req_ref>REQ_003</req_ref>
        <objective>Verify AHB address is correctly forwarded to APB</objective>
        <preconditions>
          <condition>HCLK running at 100MHz</condition>
          <condition>HRESETn and PRESETn deasserted</condition>
