  <features count="21">
    <feature req_id="REQ_001" name="single_clock_domain_bringup" category="bringup_init" pages="page 8">
      <description>The model assumes a single clock domain with PCLK commonly tied to HCLK for initialization simplicity.</description>
      <signals>HCLK, PCLK</signals>
      <requirements>
        <requirement text="The educational model assumes a single clock domain for simplicity with PCLK commonly tied to HCLK; reset returns the bridge to a clean idle state (Section 3.3, Section 6.1-6.2)." page="page 8" test_ref="TEST_BRINGUP_INIT_001"/>
        <requirement text="PCLK is commonly tied to HCLK in this example, implying a single clock domain with aligned edges (Table 3, Section 3.3)." page="page 8" test_ref="TEST_BRINGUP_INIT_002"/>
        <requirement text="Reset supports immediate re-use; the single clock domain (PCLK tied to HCLK) allows a clean idle state suitable for an immediate new transfer (Section 6.1, Section 3.3)." page="page 8" test_ref="TEST_BRINGUP_INIT_003"/>
        <requirement text="The model does not implement clock-domain crossing; a single clock domain is assumed (Section 1.3 scope exclusion, Section 3.3)." page="page 8" test_ref="TEST_BRINGUP_INIT_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_002" name="status_register_access" category="register_access" pages="page 9">
      <description>The STATUS register provides sticky error flags and read-only busy/ready status with W1C clearing.</description>
      <signals>ERR_INT, TIMEOUT_ERR, PSLVERR, ADDR_ERR, BUSY, READY</signals>
      <requirements>
        <requirement text="The STATUS register (offset 0xF04) resets to 0x00000001, with READY=1 and all sticky error flags (ERR_INT, TIMEOUT_ERR, PSLVERR, ADDR_ERR) and BUSY=0 (Table 6, Table 8)." page="page 9" test_ref="TEST_REGISTER_ACCESS_001"/>
        <requirement text="On observing a target-side error, the model sets sticky STATUS flags (e.g. PSLVERR, ERR_INT) which remain set until cleared (Table 6; Sec 7.2 error handling intent)." page="page 9" test_ref="TEST_REGISTER_ACCESS_002"/>
        <requirement text="STATUS sticky flags ERR_INT, TIMEOUT_ERR, PSLVERR, ADDR_ERR are R/W1C: writing 1 clears the bit, writing 0 leaves it unchanged (Table 4 R/W1C, Table 6)." page="page 9" test_ref="TEST_REGISTER_ACCESS_003"/>
        <requirement text="BUSY (bit1) and READY (bit0) are read-only status fields: BUSY=1 while processing traffic, READY=1 when available; writes to these bits have no effect (Table 6)." page="page 9" test_ref="TEST_REGISTER_ACCESS_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_003" name="ctrl_register_access" category="register_access" pages="page 9">
      <description>The CTRL register provides R/W enable and control knobs for bridge activity, timeout, and interrupt enables.</description>
      <signals>ENABLE, SOFT_RST, ERR_INT_EN, TIMEOUT_VAL, TIMEOUT_EN</signals>
      <requirements>
        <requirement text="CTRL register at offset 0xF00 has reset value 0x00000001 (ENABLE=1, all other knobs cleared: SOFT_RST=0, ERR_INT_EN=0, TIMEOUT_EN=0, TIMEOUT_VAL=3'b111). Per Table 5 and Table 8." page="page 9" test_ref="TEST_REGISTER_ACCESS_005"/>
        <requirement text="CTRL register R/W fields ENABLE, TIMEOUT_EN, TIMEOUT_VAL, ERR_INT_EN must accept writes and read back the written value. Per Table 5 (R/W access)." page="page 9" test_ref="TEST_REGISTER_ACCESS_006"/>
        <requirement text="Writing SOFT_RST (bit1) triggers a model-local reset that clears active transfer state and sticky status flags while preserving basic configuration. Per Table 5 and Section 6.3." page="page 9" test_ref="TEST_REGISTER_ACCESS_007"/>
        <requirement text="CTRL reserved bits 31:8 and bit2 are RO with reset 0 and must ignore writes. Per Table 5." page="page 9" test_ref="TEST_REGISTER_ACCESS_008"/>
      </requirements>
    </feature>
    <feature req_id="REQ_004" name="source_side_interface_signals" category="connectivity" pages="page 7">
      <description>The source-side interface exposes address, data, and control signals used as model input.</description>
      <signals>HCLK, HRESETn, HADDR, HTRANS, HWRITE, HSIZE, HBURST, HWDATA, HSEL, HREADY_IN, HRDATA, HREADY_OUT, HRESP</signals>
      <requirements>
        <requirement text="The source-side interface exposes HADDR[31:0] as a 32-bit address input used as model input (Table 2, source-side example signals)." page="page 7" test_ref="TEST_CONNECTIVITY_001"/>
        <requirement text="The source-side interface exposes HWDATA[31:0] as the 32-bit write payload, translated to the peripheral-side PWDATA (Table 2 / Table 3)." page="page 7" test_ref="TEST_CONNECTIVITY_002"/>
        <requirement text="HRDATA[31:0] is the source-side read payload returned by the model; read data is returned only after target-side completion (Section 8.3, Table 2)." page="page 7" test_ref="TEST_CONNECTIVITY_003"/>
        <requirement text="HCLK is the clock used for the example timing model; the bridge advances transfer phases on HCLK edges (Table 2, FLOW-1..FLOW-5)." page="page 7" test_ref="TEST_CONNECTIVITY_004"/>
        <requirement text="HRESETn is the active-low reset; asserting it returns the bridge to a clean idle state with defined reset values (Section 6.2, Table 8)." page="page 7" test_ref="TEST_CONNECTIVITY_005"/>
      </requirements>
    </feature>
    <feature req_id="REQ_005" name="captured_debug_registers" category="register_access" pages="page 9">
      <description>ERROR_ADDR and ERROR_INFO capture address and context for the most recent modeled error event.</description>
      <signals>ERROR_ADDR, ERROR_INFO</signals>
      <requirements>
        <requirement text="ERROR_ADDR (offset 0xF08, RO) captures the address associated with the most recent modeled error event (Table 4, Table 7)." page="page 9" test_ref="TEST_REGISTER_ACCESS_009"/>
        <requirement text="ERROR_INFO (offset 0xF0C, RO) captures context such as transfer direction, approximate beat index, and coarse error class (Table 7)." page="page 9" test_ref="TEST_REGISTER_ACCESS_010"/>
        <requirement text="On reset ERROR_ADDR=0x00000000 and ERROR_INFO=0x00000000 (Table 8 Example reset state)." page="page 9" test_ref="TEST_REGISTER_ACCESS_011"/>
        <requirement text="ERROR_ADDR and ERROR_INFO are RO registers (Access=RO, Table 4); writes must be ignored." page="page 9" test_ref="TEST_REGISTER_ACCESS_012"/>
        <requirement text="ERROR_ADDR captures the address of the MOST RECENT modeled error event (Table 7)." page="page 9" test_ref="TEST_REGISTER_ACCESS_013"/>
      </requirements>
    </feature>
    <feature req_id="REQ_006" name="peripheral_side_interface_signals" category="connectivity" pages="page 8">
      <description>The peripheral-side interface exposes a simpler two-phase transfer style as model output.</description>
      <signals>PCLK, PRESETn, PADDR, PSEL, PENABLE, PWRITE, PWDATA, PRDATA, PREADY, PSLVERR</signals>
      <requirements>
        <requirement text="PADDR is a 32-bit target-side address output that propagates the source-side address to the peripheral interface (Table 3, page 8)." page="page 8" test_ref="TEST_CONNECTIVITY_006"/>
        <requirement text="PWDATA is the 32-bit target-side write payload output carrying source-side write data to the peripheral (Table 3, page 8)." page="page 8" test_ref="TEST_CONNECTIVITY_007"/>
        <requirement text="PRDATA is the 32-bit target-side read payload input, returned to the source as HRDATA only after target-side completion (Table 3 page 8; FLOW-5 page 11)." page="page 8" test_ref="TEST_CONNECTIVITY_008"/>
        <requirement text="PCLK is the target-side clock, commonly tied to HCLK in this single-clock-domain model; all peripheral phase transitions are synchronous to PCLK (Table 3 page 8; section 3.3)." page="page 8" test_ref="TEST_CONNECTIVITY_009"/>
        <requirement text="PRESETn is the active-low target-side reset; on reset PSEL=0, PENABLE=0, PADDR=0x0000_0000, PWDATA=0x0000_0000 (Table 3 page 8; Table 8 reset state page 11)." page="page 8" test_ref="TEST_CONNECTIVITY_010"/>
      </requirements>
    </feature>
    <feature req_id="REQ_007" name="register_map" category="register_access" pages="page 8">
      <description>The example register map defines offsets, access types, and purposes for CTRL, STATUS, ERROR_ADDR, and ERROR_INFO.</description>
      <signals>CTRL, STATUS, ERROR_ADDR, ERROR_INFO</signals>
      <requirements>
        <requirement text="The CTRL register at offset 0xF00 is R/W with reset value 0x00000001 (ENABLE=1, TIMEOUT_EN=0, TIMEOUT_VAL=3'b111 per bit-field table but aggregate reset 0x00000001). Per Table 4 and Table 5." page="page 8" test_ref="TEST_REGISTER_ACCESS_014"/>
        <requirement text="The STATUS register at offset 0xF04 is R/W1C with reset value 0x00000001 (READY=1). Sticky error bits ERR_INT[7], TIMEOUT_ERR[6], PSLVERR[5], ADDR_ERR[4] are write-1-to-clear; BUSY[1] and READY[0] are RO. Per Table 4 and Table 6." page="page 8" test_ref="TEST_REGISTER_ACCESS_015"/>
        <requirement text="ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) are RO debug registers; ERROR_ADDR captures the address of the most recent modeled error, ERROR_INFO captures direction/beat-index/coarse error class. Reset value 0x00000000. Per Table 4 and Table 7." page="page 8" test_ref="TEST_REGISTER_ACCESS_016"/>
        <requirement text="The register map defines four offsets: CTRL=0xF00 (R/W), STATUS=0xF04 (R/W1C), ERROR_ADDR=0xF08 (RO), ERROR_INFO=0xF0C (RO). Per Table 4." page="page 8" test_ref="TEST_REGISTER_ACCESS_017"/>
      </requirements>
    </feature>
    <feature req_id="REQ_008" name="sequence_handling" category="main_datapath" pages="page 10">
      <description>The model supports simple ordered multi-transfer sequences where addresses may advance according to transfer size.</description>
      <signals>HTRANS, HBURST, HSIZE, HADDR</signals>
      <requirements>
        <requirement text="FLOW-1..FLOW-5: Each accepted source-side transfer is converted into one target-side operation. A NONSEQ (new) single transfer with HTRANS indicating new activity is captured and translated to a target setup then active phase." page="page 10" test_ref="TEST_MAIN_DATAPATH_001"/>
        <requirement text="Sequence handling: addresses may advance according to transfer size. HTRANS=SEQ continued stream with HSIZE word causes address to advance by 4 bytes per beat." page="page 10" test_ref="TEST_MAIN_DATAPATH_002"/>
        <requirement text="Sequence handling: address advance follows transfer size HSIZE. HSIZE=halfword (2B) causes sequential addresses to advance by 0x2 per beat." page="page 10" test_ref="TEST_MAIN_DATAPATH_003"/>
        <requirement text="Sequence handling: model tracks whether traffic is part of a continued stream and processes a related set of transfers in order. Verify data integrity end-to-end (write then read-back) with patterns." page="page 10" test_ref="TEST_MAIN_DATAPATH_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_009" name="transfer_timing" category="protocol" pages="page 10">
      <description>Representative transfer timing shows source capture, target setup, and target active phase progression.</description>
      <signals>HCLK, HREADY_OUT, PSEL, PENABLE, PREADY</signals>
      <requirements>
        <requirement text="Representative transfer timing shows source-side capture (FLOW-1) followed by translation into a target-side setup phase (FLOW-2). At target setup, PSEL is asserted and PENABLE remains deasserted." page="page 10" test_ref="TEST_PROTOCOL_001"/>
        <requirement text="FLOW-3 to FLOW-5: bridge advances to target active phase, and completes the transaction returning read data or error context when target indicates ready (PREADY=1)." page="page 10" test_ref="TEST_PROTOCOL_002"/>
        <requirement text="FLOW-4: bridge holds progress if the target side indicates it is not ready (PREADY=0). Source-side completion is delayed (completion held off by target latency)." page="page 10" test_ref="TEST_PROTOCOL_003"/>
        <requirement text="Example verification question: read data is returned only after target-side completion (FLOW-5). Source-side completion remains blocked while target stalls." page="page 10" test_ref="TEST_PROTOCOL_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_010" name="core_translation_behavior" category="main_datapath" pages="page 9-10">
      <description>Each accepted source-side transfer is converted into one target-side operation through capture, setup, active, and completion phases.</description>
      <signals>HADDR, HWDATA, PADDR, PWDATA, PSEL, PENABLE, HRDATA</signals>
      <requirements>
        <requirement text="Each accepted source-side write transfer is converted into one target-side write operation through capture (FLOW-1), setup (FLOW-2), active (FLOW-3), and completion (FLOW-5) phases." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_005"/>
        <requirement text="Each accepted source-side read transfer is converted to one target-side read; read data is returned to the source only after target-side completion (FLOW-5)." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_006"/>
        <requirement text="Captured source-side write payload is translated 1:1 onto the target-side write payload (FLOW-1 through FLOW-5) with full 32-bit data integrity." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_007"/>
        <requirement text="Source-side address (HADDR) is translated onto target-side address (PADDR) preserving the value across capture/setup/active phases for boundary addresses." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_008"/>
        <requirement text="Translation advances through target-side setup phase (PSEL=1,PENABLE=0) to active phase (PSEL=1,PENABLE=1) then completes, per FLOW-2/FLOW-3/FLOW-5." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_009"/>
      </requirements>
    </feature>
    <feature req_id="REQ_011" name="back_pressure_wait_behavior" category="main_datapath" pages="page 10-11">
      <description>When the target side is not ready the bridge keeps the target transfer active and delays source-side completion.</description>
      <signals>PREADY, HREADY_OUT, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="When the target side is not ready (PREADY=0) the bridge keeps the target transfer active and delays source-side completion (HREADY_OUT held low). Ref FLOW-4, Section 5.3/5.5." page="page 10-11" test_ref="TEST_MAIN_DATAPATH_010"/>
        <requirement text="Read data is returned to the source only after target-side completion; HREADY_OUT remains low while PREADY=0 across multiple wait cycles. Ref FLOW-4/FLOW-5, Section 5.3." page="page 10-11" test_ref="TEST_MAIN_DATAPATH_011"/>
        <requirement text="Each accepted source transfer maps to one target access; back-pressure holds completion. Verify data integrity of distinct patterns through stalled writes. Ref Section 5.1/5.3." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_012"/>
        <requirement text="If TIMEOUT_EN=1 and PREADY does not arrive within the programmed window, a timeout error is recorded; otherwise completion is held indefinitely. Ref CTRL.TIMEOUT_EN/TIMEOUT_VAL, STATUS.TIMEOUT_ERR, Section 5.3/7.1." page="page 9-12" test_ref="TEST_MAIN_DATAPATH_013"/>
      </requirements>
    </feature>
    <feature req_id="REQ_012" name="wait_state_timing" category="protocol" pages="page 11">
      <description>Representative wait-state timing shows delayed completion during a target stall through setup, wait, and complete phases.</description>
      <signals>PREADY, HREADY_OUT, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="When the target side is not ready (PREADY=0), the bridge keeps the target transfer active and delays source-side completion through setup, wait, and complete phases (Section 5.5, FLOW-4)." page="page 11" test_ref="TEST_PROTOCOL_005"/>
        <requirement text="During a target stall the bridge holds the target transfer active; setup/active/complete phase progression and signal stability must be preserved across multiple wait cycles (Section 5.5)." page="page 11" test_ref="TEST_PROTOCOL_006"/>
        <requirement text="Read data is returned only after target-side completion; source-side completion remains blocked while the target side stalls (Section 8.3 verification questions; Section 5.5)." page="page 11" test_ref="TEST_PROTOCOL_007"/>
        <requirement text="After a delayed completion the model becomes ready for new work; back-pressure releases and a subsequent transfer can begin (Section 5.3, Section 6.2 reset state HREADY_OUT=1)." page="page 11" test_ref="TEST_PROTOCOL_008"/>
      </requirements>
    </feature>
    <feature req_id="REQ_013" name="setup_active_state_machine" category="protocol" pages="page 14">
      <description>The simplified FSM transitions IDLE to SETUP to ACTIVE with stall self-loop and completion back to IDLE.</description>
      <signals>PSEL, PENABLE, PREADY</signals>
      <requirements>
        <requirement text="The simplified FSM transitions from IDLE to SETUP when an accepted request is received (Figure 5, Appendix B). On SETUP, PSEL=1 and PENABLE=0." page="page 14" test_ref="TEST_PROTOCOL_009"/>
        <requirement text="The FSM advances from SETUP to ACTIVE (Figure 5 'Advance'). In ACTIVE, PSEL=1 and PENABLE=1." page="page 14" test_ref="TEST_PROTOCOL_010"/>
        <requirement text="The FSM holds in ACTIVE via a self-loop on target stall (Figure 5 'Target stall'), i.e. when PREADY=0. Signals remain stable during the wait." page="page 14" test_ref="TEST_PROTOCOL_011"/>
        <requirement text="The FSM returns from ACTIVE to IDLE on completion (Figure 5 'Complete'), which occurs when PREADY=1. On completion PSEL and PENABLE deassert." page="page 14" test_ref="TEST_PROTOCOL_012"/>
        <requirement text="End-to-end FSM walk: IDLE-&gt;SETUP (accepted request)-&gt;ACTIVE (advance)-&gt;ACTIVE self-loop (PREADY=0)-&gt;IDLE (complete, PREADY=1), per Figure 5." page="page 14" test_ref="TEST_PROTOCOL_013"/>
      </requirements>
    </feature>
    <feature req_id="REQ_014" name="soft_reset" category="reset" pages="page 11-12">
      <description>A model-local soft reset triggered via control register clears active transfer state and sticky status while preserving basic configuration.</description>
      <signals>SOFT_RST, STATUS</signals>
      <requirements>
        <requirement text="SOFT_RST (CTRL bit 1) triggers a model-local reset that clears active transfer state. Soft reset clears in-flight work while preserving basic configuration where appropriate." page="page 11-12" test_ref="TEST_RESET_001"/>
        <requirement text="Soft reset clears sticky status flags. STATUS sticky error bits (ERR_INT[7], TIMEOUT_ERR[6], PSLVERR[5], ADDR_ERR[4]) are R/W1C and must be cleared by the soft reset action." page="page 11-12" test_ref="TEST_RESET_002"/>
        <requirement text="The soft reset action is intended to clear active transfer state and sticky status flags while preserving basic configuration where appropriate." page="page 11-12" test_ref="TEST_RESET_003"/>
        <requirement text="Soft reset returns the model to a clean idle state. Compare against full reset state (Table 8): CTRL=0x00000001, STATUS=0x00000001. Soft reset clears active transfer state and sticky status but preserves basic configuration, unlike HRESETn which restores all reset defaults." page="page 11-12" test_ref="TEST_RESET_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_015" name="hard_reset_initialization" category="reset" pages="page 11">
      <description>Reset returns the bridge to a clean idle state with defined reset values for outputs and registers.</description>
      <signals>HRESETn, PRESETn, HREADY_OUT, HRESP, HRDATA, PSEL, PENABLE, PADDR, PWDATA, CTRL, STATUS, ERROR_ADDR, ERROR_INFO</signals>
      <requirements>
        <requirement text="Reset returns the bridge to a clean idle state with defined reset values: HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000, CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000 (Table 8)." page="page 11" test_ref="TEST_RESET_005"/>
        <requirement text="Reset must cleanly abort in-flight work and return the bridge to idle (Reset Intent: reset during active transfer; Example Verification Question: Does reset cleanly abort in-flight work?)." page="page 11" test_ref="TEST_RESET_006"/>
        <requirement text="Reset interacts with sticky error state; reset returns the bridge to a clean idle state with STATUS=0x00000001 (all sticky error flags cleared) per Reset Intent and Table 8." page="page 11" test_ref="TEST_RESET_007"/>
        <requirement text="Reset followed by immediate re-use returns the bridge to a clean idle state ready for new activity (Reset Intent: reset followed by immediate re-use; HREADY_OUT reset value=1, STATUS.READY=1)." page="page 11" test_ref="TEST_RESET_008"/>
      </requirements>
    </feature>
    <feature req_id="REQ_016" name="address_error_scenario" category="error" pages="page 12">
      <description>An address error occurs when a request targets an unsupported or invalid range in the example map.</description>
      <signals>HADDR, ADDR_ERR, HRESP, ERROR_ADDR</signals>
      <requirements>
        <requirement text="An address error occurs when a request targets an unsupported or invalid range in the example map. The model records debug context, updates sticky status bits, and returns a simplified source-side error indication (Table 9, Section 7.1/7.2)." page="page 12" test_ref="TEST_ERROR_001"/>
        <requirement text="Address error is triggered when the request address falls just outside the supported/valid range of the example map (Section 7.1 Address error class). Boundary condition verification." page="page 12" test_ref="TEST_ERROR_002"/>
        <requirement text="Address error on a read transaction to an invalid range must set ADDR_ERR, return HRESP error, and ERROR_INFO must capture transfer direction (read) and coarse error class (Section 7.2 error handling intent, Table 7 captured debug state)." page="page 12" test_ref="TEST_ERROR_003"/>
        <requirement text="An address error must be detected even when an invalid-range request follows in-flight activity; reset must cleanly abort in-flight work and clear sticky error state (Section 6.1 reset intent, Section 7.2). ERROR_ADDR/ERROR_INFO capture the most recent error event." page="page 12" test_ref="TEST_ERROR_004"/>
      </requirements>
    </feature>
    <feature req_id="REQ_017" name="timeout_error_scenario" category="error" pages="page 12">
      <description>A timeout error occurs when target-side readiness does not arrive within the programmed observation window.</description>
      <signals>TIMEOUT_EN, TIMEOUT_VAL, TIMEOUT_ERR, PREADY, HRESP</signals>
      <requirements>
        <requirement text="A timeout error occurs when target-side readiness (PREADY) does not arrive within the programmed observation window. TIMEOUT_EN enables timeout behavior, TIMEOUT_VAL selects the window, and TIMEOUT_ERR (STATUS[6]) is set. HRESP returns simplified error indication." page="page 12" test_ref="TEST_ERROR_005"/>
        <requirement text="Timeout error detection is gated by TIMEOUT_EN. When TIMEOUT_EN=0, a target stall (PREADY=0) must NOT raise TIMEOUT_ERR; completion is simply delayed (back-pressure, sec 5.3)." page="page 12" test_ref="TEST_ERROR_006"/>
        <requirement text="When ERR_INT_EN(CTRL[3])=1 and a timeout error occurs, the sticky aggregated ERR_INT(STATUS[7]) interrupt-style indication is set in addition to TIMEOUT_ERR(STATUS[6]). Both are R/W1C and must be cleared independently." page="page 12" test_ref="TEST_ERROR_007"/>
        <requirement text="TIMEOUT_VAL(CTRL[6:4]) selects the observation window. A PREADY arriving on the last in-window cycle must complete OKAY (no error); PREADY arriving one cycle past the window must raise TIMEOUT_ERR. This exercises the boundary of the programmed window." page="page 12" test_ref="TEST_ERROR_008"/>
      </requirements>
    </feature>
    <feature req_id="REQ_018" name="target_error_scenario" category="error" pages="page 12">
      <description>A target error occurs when a peripheral-side error indication is observed during an active access.</description>
      <signals>PSLVERR, HRESP, ERROR_INFO</signals>
      <requirements>
        <requirement text="A target error occurs when a peripheral-side error indication (PSLVERR=1) is observed during an active access; the model records debug context, updates sticky status (STATUS.PSLVERR), returns simplified source-side error indication (HRESP=1), and captures ERROR_INFO (page 12, Sec 7.1-7.2)." page="page 12" test_ref="TEST_ERROR_009"/>
        <requirement text="Peripheral-side error (PSLVERR=1) observed during an active READ access must not return valid read data; HRESP=1 returned, ERROR_INFO captures direction=read, sticky STATUS.PSLVERR set (page 12, Sec 7.1-7.3, Fig 4)." page="page 12" test_ref="TEST_ERROR_010"/>
        <requirement text="Sticky error flags must be captured and preserved until explicitly cleared (W1C); a subsequent good transfer must not auto-clear STATUS.PSLVERR (page 12 Sec 7.2, page 13 Example Verification Questions)." page="page 12" test_ref="TEST_ERROR_011"/>
        <requirement text="When PSLVERR=1 is observed during the active phase of one beat of a multi-transfer sequence, the model captures ERROR_INFO (incl. approximate beat index), sets HRESP=1, and returns ready for re-test (page 12 Sec 7.2, page 9 Sec 4.5 ERROR_INFO beat index)." page="page 12" test_ref="TEST_ERROR_012"/>
      </requirements>
    </feature>
    <feature req_id="REQ_019" name="hresp_error_indication_output" category="protocol" pages="page 7">
      <description>HRESP source-side simplified status output indicating success or error on the source interface, distinct from internal error class detection and sticky status flags.</description>
      <signals></signals>
      <requirements>
        <requirement text="HRESP is a simplified source-side status indicator for success or error; on a successful transfer HRESP must indicate OK (HRESP=0) per Table 2, page 7." page="page 7" test_ref="TEST_PROTOCOL_014"/>
        <requirement text="HRESP indicates error when a target-side error (PSLVERR) is observed during an active access; HRESP is distinct from sticky STATUS.PSLVERR flag (Table 2 page 7, Table 9 error classes)." page="page 7" test_ref="TEST_PROTOCOL_015"/>
        <requirement text="HRESP indicates error for a timeout scenario when target readiness does not arrive within the programmed observation window (CTRL.TIMEOUT_EN/VAL, Table 9 timeout error)." page="page 7" test_ref="TEST_PROTOCOL_016"/>
        <requirement text="HRESP is a simplified success/error status output; during back-pressure (target stall) source completion is delayed and HRESP must remain stable (no spurious error) until completion (Table 2 page 7, Sec 5.3 / Fig 3)." page="page 7" test_ref="TEST_PROTOCOL_017"/>
      </requirements>
    </feature>
    <feature req_id="REQ_020" name="read_data_return_path" category="main_datapath" pages="page 9-10">
      <description>HRDATA read payload is returned to the source side only after target-side completion (PRDATA captured during target active phase). FLOW-5 returns read data; this read-data return behavior is distinct from the generic translation feature and is independently testable.</description>
      <signals></signals>
      <requirements>
        <requirement text="FLOW-5: Complete the transaction and return any read data. HRDATA read payload is returned to the source side only after target-side completion (PRDATA captured during target active phase)." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_014"/>
        <requirement text="Read data is returned only after target-side completion. The bridge holds the target transfer active and delays source-side completion when PREADY=0 (Section 5.3 / Example Verification Question: 'Is read data returned only after target-side completion?')." page="page 10-13" test_ref="TEST_MAIN_DATAPATH_015"/>
        <requirement text="PRDATA captured during target active phase is returned unchanged on HRDATA (32-bit data example). Verify data integrity across walking patterns." page="page 9-10" test_ref="TEST_MAIN_DATAPATH_016"/>
        <requirement text="Source-side read payload (HRDATA) returned by the model corresponds to PRDATA from the target access at the translated PADDR (32-bit address example, Table 2/Table 3)." page="page 7-10" test_ref="TEST_MAIN_DATAPATH_017"/>
        <requirement text="When PSLVERR is observed during an active access (Target error class, Table 9), the model returns a simplified source-side error indication via HRESP; read data return path behavior under error is independently testable." page="page 9-12" test_ref="TEST_MAIN_DATAPATH_018"/>
      </requirements>
    </feature>
    <feature req_id="REQ_021" name="error_response_timing" category="error" pages="page 12">
      <description>Representative error timing shows the target error and source-side error response window.</description>
      <signals>HRESP, PSLVERR, PSEL, PENABLE</signals>
      <requirements>
        <requirement text="Representative error timing: when the peripheral-side asserts PSLVERR during an active access, the model returns a simplified source-side error indication (HRESP=1) within the error response window (Section 7.3, Figure 4)." page="page 12" test_ref="TEST_ERROR_013"/>
        <requirement text="The simplified source-side error indication (HRESP) is signaled over an error response window aligned with completion; HREADY_OUT remains low until the window completes (Figure 4 error response window, Section 7.2)." page="page 12" test_ref="TEST_ERROR_014"/>
        <requirement text="Address error: a request targeting an unsupported/invalid range produces a source-side error indication (HRESP=1) and sets sticky STATUS.ADDR_ERR with captured ERROR_ADDR (Table 9, Section 7.1/7.2). PSEL/PENABLE may not reach a valid target access." page="page 12" test_ref="TEST_ERROR_015"/>
        <requirement text="After an error and recovery the model becomes ready for subsequent activity; sticky error state must not leak into following normal transfers (Section 7.2 'becomes ready for subsequent debug or re-test activity'; Figure 4 error response window)." page="page 12" test_ref="TEST_ERROR_016"/>
      </requirements>
    </feature>
  </features>

  <test_suites>
    <test_suite name="bringup_init_tests" category="bringup_init" count="4">
      <test_case test_id="TEST_BRINGUP_INIT_001" name="single_clock_domain_reset_bringup">
        <req_ref>REQ_001</req_ref>
        <objective>Verify that with PCLK tied to HCLK in a single clock domain, the bridge initializes to the documented clean idle reset state.</objective>
        <preconditions>
          <condition>HCLK free-running at fixed frequency</condition>
          <condition>PCLK physically tied to HCLK (same edges)</condition>
          <condition>HRESETn and PRESETn asserted low at start</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HCLK toggling and tie PCLK=HCLK; assert HRESETn=0 and PRESETn=0</action>
            <expected>Both reset domains active, bridge held in reset</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, observe that HCLK and PCLK rising edges are coincident (single clock domain assumption)</action>
            <expected>PCLK rising edge aligns exactly with HCLK rising edge, zero skew in model</expected>
          </step>
          <step num="3">
            <action>At T3, deassert HRESETn=1 and PRESETn=1 simultaneously on the same rising edge</action>
            <expected>Bridge begins exit from reset on same clock edge</expected>
          </step>
          <step num="4">
            <action>At T4, read back reset-state outputs: HREADY_OUT, HRESP, PSEL, PENABLE</action>
            <expected>HREADY_OUT=0x1, HRESP=0x0, PSEL=0x0, PENABLE=0x0 per Table 8</expected>
          </step>
          <step num="5">
            <action>At T5, read CTRL (0xF00) and STATUS (0xF04) registers and compare against documented reset values</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001 per Table 8</expected>
          </step>
          <step num="6">
            <action>At T6, verify debug capture registers ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000 (cleared)</expected>
          </step>
        </steps>
        <pass_criteria>1. PCLK and HCLK rising edges coincident every cycle (single clock domain). 2. HREADY_OUT=0x1, HRESP=0x0, PSEL=0x0, PENABLE=0x0 after reset. 3. CTRL=0x0000_0001 and STATUS=0x0000_0001. 4. ERROR_ADDR=0x0000_0000 and ERROR_INFO=0x0000_0000.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_BRINGUP_INIT_002" name="pclk_hclk_edge_alignment_check">
        <req_ref>REQ_001</req_ref>
        <objective>Verify that PCLK is edge-aligned to HCLK throughout bringup so no clock-domain-crossing behavior is exercised.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>PCLK tied to HCLK source</condition>
          <condition>HRESETn=1 and PRESETn=1 (post-reset idle)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, sample HCLK and PCLK levels at the rising edge of HCLK</action>
            <expected>PCLK=HCLK level (both transition together)</expected>
          </step>
          <step num="2">
            <action>At T2 through T5, on each HCLK rising edge, measure PCLK-to-HCLK skew</action>
            <expected>Measured skew = 0 cycles; PCLK rising edge index equals HCLK rising edge index</expected>
          </step>
          <step num="3">
            <action>At T3, drive a single transfer: HSEL=0x1, HTRANS=0b10 (new), HADDR=0x0000_1000 on HCLK edge</action>
            <expected>Source-side request captured on the same edge seen by PCLK domain</expected>
          </step>
          <step num="4">
            <action>At T4, verify peripheral-side PSEL=0x1 asserts referenced to the same clock edge (no synchronizer delay)</action>
            <expected>PSEL=0x1 appears with no extra CDC latency since PCLK==HCLK</expected>
          </step>
          <step num="5">
            <action>At T5, compare the cycle count of source capture versus target setup and prove they are within the same single-clock-domain timeline</action>
            <expected>Target setup occurs deterministically relative to HCLK with no clock-domain uncertainty</expected>
          </step>
        </steps>
        <pass_criteria>1. PCLK-to-HCLK skew measured as 0 across T1..T5. 2. No CDC latency observed on PSEL assertion. 3. Source capture and target setup track the single shared clock deterministically.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_BRINGUP_INIT_003" name="single_domain_reset_then_immediate_reuse">
        <req_ref>REQ_001</req_ref>
        <objective>Verify the bridge in single-clock-domain config returns to idle on reset and accepts a new transfer immediately afterward.</objective>
        <preconditions>
          <condition>HCLK running with PCLK=HCLK</condition>
          <condition>Model previously active or idle</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, assert HRESETn=0 and PRESETn=0 on the shared rising edge</action>
            <expected>Bridge enters reset, all outputs cleared</expected>
          </step>
          <step num="2">
            <action>At T2, deassert HRESETn=1 and PRESETn=1 together</action>
            <expected>Bridge in clean IDLE state, HREADY_OUT=0x1, STATUS=0x0000_0001 (READY=1, BUSY=0)</expected>
          </step>
          <step num="3">
            <action>At T3, immediately drive a new request: HSEL=0x1, HTRANS=0b10, HWRITE=0x1, HADDR=0x0000_2000, HWDATA=0x0000_DEAD</action>
            <expected>Request accepted on same clock domain, FSM moves IDLE-&gt;SETUP</expected>
          </step>
          <step num="4">
            <action>At T4, verify peripheral setup: PSEL=0x1, PENABLE=0x0, PADDR=0x0000_2000, PWRITE=0x1</action>
            <expected>Target setup phase entered correctly with PCLK==HCLK timing</expected>
          </step>
          <step num="5">
            <action>At T5, read STATUS (0xF04) and verify BUSY bit</action>
            <expected>STATUS BUSY=1 indicating model processing immediately after reset re-use</expected>
          </step>
        </steps>
        <pass_criteria>1. After reset deassert, HREADY_OUT=0x1 and STATUS=0x0000_0001. 2. New transfer accepted on the very next cycle with PADDR=0x0000_2000, PWRITE=0x1. 3. PSEL=0x1, PENABLE=0x0 in setup. 4. STATUS BUSY=1 after transfer accepted.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_BRINGUP_INIT_004" name="single_clock_domain_no_cdc_assumption">
        <req_ref>REQ_001</req_ref>
        <objective>Verify that bringup operates under one clock domain only and no CDC handling (synchronizers, async resets) is exercised.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>PCLK tied to HCLK</condition>
          <condition>Resets deasserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, confirm configuration: PCLK source == HCLK source (single domain)</action>
            <expected>Only one clock generator drives both HCLK and PCLK</expected>
          </step>
          <step num="2">
            <action>At T2, drive HSEL=0x1, HTRANS=0b10, HADDR=0x0000_3000 and observe propagation to PADDR</action>
            <expected>PADDR=0x0000_3000 appears with deterministic single-cycle alignment, no metastability window</expected>
          </step>
          <step num="3">
            <action>At T3, hold PREADY=0x1 and observe completion HREADY_OUT relative to the shared clock</action>
            <expected>Completion timing fully determined by single HCLK/PCLK edge with no async uncertainty</expected>
          </step>
          <step num="4">
            <action>At T4, verify HRDATA captured from PRDATA without any synchronizer pipeline delay</action>
            <expected>HRDATA equals PRDATA value sampled on the same clock domain edge</expected>
          </step>
          <step num="5">
            <action>At T5, prove no clock-domain-crossing flop chain exists by checking transfer latency is constant and reproducible across runs</action>
            <expected>Transfer latency is fixed and identical every run, confirming no CDC logic</expected>
          </step>
        </steps>
        <pass_criteria>1. Single clock source confirmed for HCLK and PCLK. 2. PADDR=0x0000_3000 propagates with zero CDC latency. 3. HRDATA matches PRDATA on same domain. 4. Transfer latency constant and reproducible (no CDC synchronizers present).</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="connectivity_tests" category="connectivity" count="10">
      <test_case test_id="TEST_CONNECTIVITY_001" name="source_address_bus_connectivity">
        <req_ref>REQ_004</req_ref>
        <objective>Verify the HADDR address bus is fully connected by driving minimum and maximum address values and confirming the bridge captures and translates them onto PADDR.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge of HCLK, drive HSEL=1, HTRANS=2'b10 (new), HWRITE=1, HSIZE=3'b010, HADDR=0x0000_0000, HREADY_IN=1</action>
            <expected>Source capture phase (FLOW-1); model accepts transfer, BUSY transitions toward 1</expected>
          </step>
          <step num="2">
            <action>At T2, allow target setup phase; observe peripheral-side outputs</action>
            <expected>PSEL=1, PADDR=0x0000_0000, PWRITE=1 (FLOW-2 target setup)</expected>
          </step>
          <step num="3">
            <action>At T3, drive next transfer HADDR=0xFFFF_FFFF, HTRANS=2'b10, HWRITE=1, HSIZE=3'b010</action>
            <expected>Model captures max address, source capture phase entered</expected>
          </step>
          <step num="4">
            <action>At T4, observe peripheral-side address output and compare to driven value</action>
            <expected>PADDR=0xFFFF_FFFF, PSEL=1</expected>
          </step>
          <step num="5">
            <action>Verify each captured PADDR exactly equals the HADDR driven at the corresponding source-capture cycle</action>
            <expected>PADDR matches HADDR for both 0x0000_0000 and 0xFFFF_FFFF with no bit truncation or stuck bits</expected>
          </step>
        </steps>
        <pass_criteria>1. HADDR=0x0000_0000 propagates to PADDR=0x0000_0000. 2. HADDR=0xFFFF_FFFF propagates to PADDR=0xFFFF_FFFF. 3. No stuck-at or swapped address bits observed (FLOW-1/FLOW-2).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_002" name="source_write_data_bus_connectivity">
        <req_ref>REQ_004</req_ref>
        <objective>Verify the HWDATA write data bus is fully connected by driving walking/boundary patterns and confirming they appear on PWDATA.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HSEL=1, HTRANS=2'b10, HWRITE=1, HSIZE=3'b010, HADDR=0x0000_1000, HREADY_IN=1</action>
            <expected>Source capture of write transfer (FLOW-1)</expected>
          </step>
          <step num="2">
            <action>At T2 (data phase), drive HWDATA=0xFFFF_FFFF</action>
            <expected>Model captures write payload; PWDATA=0xFFFF_FFFF on target active phase (FLOW-3)</expected>
          </step>
          <step num="3">
            <action>At T3, issue new write with HWDATA=0x0000_0000 to HADDR=0x0000_1004</action>
            <expected>PWDATA=0x0000_0000 on peripheral side</expected>
          </step>
          <step num="4">
            <action>At T4, issue new write with HWDATA=0xAAAA_AAAA to HADDR=0x0000_1008</action>
            <expected>PWDATA=0xAAAA_AAAA on peripheral side</expected>
          </step>
          <step num="5">
            <action>Compare each PWDATA value against the corresponding HWDATA driven</action>
            <expected>All three data patterns (0xFFFF_FFFF, 0x0000_0000, 0xAAAA_AAAA) propagate exactly with no bit corruption</expected>
          </step>
        </steps>
        <pass_criteria>1. HWDATA=0xFFFF_FFFF -&gt; PWDATA=0xFFFF_FFFF. 2. HWDATA=0x0000_0000 -&gt; PWDATA=0x0000_0000. 3. HWDATA=0xAAAA_AAAA -&gt; PWDATA=0xAAAA_AAAA. 4. No stuck or shorted data bits.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_003" name="source_read_data_loopback_verify">
        <req_ref>REQ_004</req_ref>
        <objective>Verify a write followed by a read returns matching data through HRDATA, confirming read-data bus connectivity and write/read correspondence.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>HSEL=1</condition>
          <condition>PRDATA reflects last written value at PADDR</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive write: HSEL=1, HTRANS=2'b10, HWRITE=1, HSIZE=3'b010, HADDR=0x0000_2000, HREADY_IN=1</action>
            <expected>Source capture of write (FLOW-1)</expected>
          </step>
          <step num="2">
            <action>At T2 data phase, drive HWDATA=0xAAAA_AAAA; wait for HREADY_OUT=1</action>
            <expected>PWDATA=0xAAAA_AAAA, write completes when PREADY=1, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="3">
            <action>At T3, drive read: HTRANS=2'b10, HWRITE=0, HADDR=0x0000_2000, HSEL=1</action>
            <expected>Source capture of read; PSEL=1, PWRITE=0, PADDR=0x0000_2000</expected>
          </step>
          <step num="4">
            <action>At T4, peripheral returns PRDATA=0xAAAA_AAAA with PREADY=1</action>
            <expected>Model forwards read data only after target completion (FLOW-5)</expected>
          </step>
          <step num="5">
            <action>At T5 when HREADY_OUT=1, capture HRDATA and compare to original write value</action>
            <expected>HRDATA=0xAAAA_AAAA, HRESP=0; read data equals written data</expected>
          </step>
        </steps>
        <pass_criteria>1. Write payload 0xAAAA_AAAA stored at PADDR=0x0000_2000. 2. HRDATA on read equals 0xAAAA_AAAA. 3. HRDATA valid only when HREADY_OUT=1 after target completion. 4. HRESP=0 (no error).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_004" name="source_clock_connectivity">
        <req_ref>REQ_004</req_ref>
        <objective>Verify HCLK is connected and that all state progression and signal captures occur synchronously on HCLK rising edges.</objective>
        <preconditions>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Before T1 hold HCLK static (no edges); drive HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_3000, HREADY_IN=1</action>
            <expected>No phase progression while HCLK is static; PSEL stays 0, no source capture occurs</expected>
          </step>
          <step num="2">
            <action>At T1, apply first HCLK rising edge</action>
            <expected>Source capture occurs (FLOW-1); model registers HADDR=0x0000_3000</expected>
          </step>
          <step num="3">
            <action>At T2 rising edge, observe target setup</action>
            <expected>PSEL=1, PADDR=0x0000_3000 (one phase advance per HCLK edge)</expected>
          </step>
          <step num="4">
            <action>At T3 rising edge, observe target active phase</action>
            <expected>PENABLE=1 (FLOW-3), demonstrating one-edge-per-phase advancement</expected>
          </step>
          <step num="5">
            <action>Count HCLK edges versus FSM transitions (IDLE-&gt;SETUP-&gt;ACTIVE) and verify each transition aligns to exactly one rising edge</action>
            <expected>Each FSM transition coincides with a single HCLK rising edge; no progression without a clock edge</expected>
          </step>
        </steps>
        <pass_criteria>1. No phase change while HCLK static. 2. IDLE-&gt;SETUP-&gt;ACTIVE each advance on consecutive HCLK rising edges. 3. All captures synchronous to HCLK; proves HCLK connectivity.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_005" name="source_reset_connectivity">
        <req_ref>REQ_004</req_ref>
        <objective>Verify HRESETn is connected by asserting reset and confirming all source-side and peripheral-side outputs assume their documented reset values.</objective>
        <preconditions>
          <condition>HCLK running</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HRESETn=0 (asserted) for at least 2 HCLK cycles</action>
            <expected>Model enters IDLE reset state</expected>
          </step>
          <step num="2">
            <action>At T2 while HRESETn=0, sample source-side outputs</action>
            <expected>HREADY_OUT=1, HRESP=0, HRDATA=0x0000_0000 (Table 8)</expected>
          </step>
          <step num="3">
            <action>At T3 while HRESETn=0, sample peripheral-side outputs</action>
            <expected>PSEL=0, PENABLE=0, PADDR=0x0000_0000, PWDATA=0x0000_0000</expected>
          </step>
          <step num="4">
            <action>At T4, deassert HRESETn=1 and read example registers</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="5">
            <action>At T5, drive a transfer (HSEL=1, HTRANS=2'b10, HADDR=0x0000_4000) and verify normal operation resumes; compare all sampled reset values to Table 8</action>
            <expected>FSM accepts new transfer (FLOW-1); reset values matched exactly, proving HRESETn connectivity</expected>
          </step>
        </steps>
        <pass_criteria>1. During HRESETn=0: HREADY_OUT=1, HRESP=0, HRDATA=0x0000_0000, PSEL=0, PENABLE=0. 2. CTRL=0x0000_0001 and STATUS=0x0000_0001 after reset. 3. Normal operation resumes after HRESETn=1 (Table 8).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_006" name="paddr_address_bus_connectivity">
        <req_ref>REQ_006</req_ref>
        <objective>Verify PADDR drives both minimum and maximum address values correctly through the peripheral-side interface.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, issue a source-side write transfer with HADDR=0x0000_0000, HWRITE=1, HSEL=1, HTRANS=2'b10 (New)</action>
            <expected>Bridge captures source address (FLOW-1)</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge PCLK), observe SETUP phase: PSEL=1, PENABLE=0, PADDR=0x0000_0000, PWRITE=1</action>
            <expected>PADDR=0x0000_0000 driven, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="3">
            <action>At T3 (rising edge PCLK), observe ACTIVE phase: PSEL=1, PENABLE=1, PADDR=0x0000_0000</action>
            <expected>PADDR holds 0x0000_0000 stable through active phase</expected>
          </step>
          <step num="4">
            <action>At T5, issue a second source-side write with HADDR=0xFFFF_FFFF, HWRITE=1, HSEL=1, HTRANS=2'b10</action>
            <expected>Bridge captures max address</expected>
          </step>
          <step num="5">
            <action>At T6 (SETUP), check PADDR=0xFFFF_FFFF, PSEL=1, PENABLE=0; at T7 (ACTIVE) check PADDR=0xFFFF_FFFF, PENABLE=1</action>
            <expected>PADDR=0xFFFF_FFFF propagated correctly with no bit stuck/tied</expected>
          </step>
          <step num="6">
            <action>Compare driven PADDR against captured source HADDR for both transfers</action>
            <expected>PADDR matches HADDR exactly for 0x0000_0000 and 0xFFFF_FFFF</expected>
          </step>
        </steps>
        <pass_criteria>1. PADDR=0x0000_0000 for min-address transfer. 2. PADDR=0xFFFF_FFFF for max-address transfer. 3. PSEL=1/PENABLE=0 in SETUP and PSEL=1/PENABLE=1 in ACTIVE. 4. PADDR equals captured HADDR in both cases (no stuck bits).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_007" name="pwdata_data_bus_connectivity">
        <req_ref>REQ_006</req_ref>
        <objective>Verify PWDATA correctly carries walking/boundary data patterns from source to peripheral side.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive source write transfer HADDR=0x0000_1000, HWRITE=1, HSEL=1, HWDATA=0xFFFF_FFFF, HTRANS=2'b10</action>
            <expected>Bridge captures write payload (FLOW-1)</expected>
          </step>
          <step num="2">
            <action>At T3 (ACTIVE phase, rising edge PCLK), observe PSEL=1, PENABLE=1, PWRITE=1, PWDATA=0xFFFF_FFFF</action>
            <expected>PWDATA=0xFFFF_FFFF driven on peripheral side</expected>
          </step>
          <step num="3">
            <action>Repeat at T5 with HWDATA=0x0000_0000; observe PWDATA at corresponding ACTIVE phase</action>
            <expected>PWDATA=0x0000_0000 driven correctly</expected>
          </step>
          <step num="4">
            <action>Repeat at T8 with HWDATA=0xAAAA_AAAA; observe PWDATA at corresponding ACTIVE phase</action>
            <expected>PWDATA=0xAAAA_AAAA driven correctly</expected>
          </step>
          <step num="5">
            <action>Repeat at T11 with HWDATA=0x5555_5555; observe PWDATA at corresponding ACTIVE phase</action>
            <expected>PWDATA=0x5555_5555 driven correctly</expected>
          </step>
          <step num="6">
            <action>Compare each driven PWDATA value against the captured source HWDATA</action>
            <expected>PWDATA matches HWDATA for all four patterns, proving no stuck/shorted data bits</expected>
          </step>
        </steps>
        <pass_criteria>1. PWDATA=0xFFFF_FFFF, 0x0000_0000, 0xAAAA_AAAA, 0x5555_5555 each match HWDATA. 2. PWRITE=1 during all writes. 3. PENABLE=1 in ACTIVE phase when PWDATA is sampled. 4. No data bit stuck-at fault detected.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_008" name="prdata_read_path_connectivity">
        <req_ref>REQ_006</req_ref>
        <objective>Verify peripheral read data on PRDATA is correctly returned and read-back matches the value placed on PRDATA.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, issue source read transfer HADDR=0x0000_2000, HWRITE=0, HSEL=1, HTRANS=2'b10</action>
            <expected>Bridge enters peripheral SETUP: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_2000</expected>
          </step>
          <step num="2">
            <action>At T2 (ACTIVE), drive PRDATA=0xDEAD_BEEF and PREADY=1 with PSEL=1, PENABLE=1</action>
            <expected>Peripheral presents read data 0xDEAD_BEEF with completion</expected>
          </step>
          <step num="3">
            <action>At T3, observe source-side HRDATA after completion (FLOW-5)</action>
            <expected>HRDATA=0xDEAD_BEEF, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="4">
            <action>Repeat read at T5 with PRDATA=0x0000_0000, PREADY=1</action>
            <expected>HRDATA=0x0000_0000 returned after ACTIVE completion</expected>
          </step>
          <step num="5">
            <action>Repeat read at T8 with PRDATA=0xFFFF_FFFF, PREADY=1</action>
            <expected>HRDATA=0xFFFF_FFFF returned after ACTIVE completion</expected>
          </step>
          <step num="6">
            <action>Compare returned HRDATA against the value driven on PRDATA for each read</action>
            <expected>HRDATA exactly equals PRDATA, proving the read data path connectivity</expected>
          </step>
        </steps>
        <pass_criteria>1. HRDATA matches PRDATA for 0xDEAD_BEEF, 0x0000_0000, 0xFFFF_FFFF. 2. Read data returned only after PENABLE=1 and PREADY=1 (target completion). 3. HRESP=0 on clean reads. 4. No read-data bus bit stuck.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_009" name="pclk_clock_connectivity">
        <req_ref>REQ_006</req_ref>
        <objective>Verify peripheral-side phase progression (SETUP-&gt;ACTIVE) advances only on PCLK rising edges.</objective>
        <preconditions>
          <condition>PRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Start PCLK toggling; at T1 issue source write HADDR=0x0000_3000, HWRITE=1, HSEL=1, HWDATA=0x1234_5678, HTRANS=2'b10</action>
            <expected>Transfer accepted on PCLK rising edge</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge of PCLK, observe SETUP: PSEL=1, PENABLE=0, PADDR=0x0000_3000</action>
            <expected>SETUP phase established synchronous to PCLK</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge of PCLK, observe ACTIVE: PSEL=1, PENABLE=1</action>
            <expected>PENABLE asserts exactly one PCLK cycle after PSEL (no async transition)</expected>
          </step>
          <step num="4">
            <action>Hold PCLK static (no edge) for 2 cycles while a new request is pending</action>
            <expected>PSEL/PENABLE/PADDR do not change while PCLK is static, proving phases are PCLK-gated</expected>
          </step>
          <step num="5">
            <action>Resume PCLK; verify next phase transition occurs on the following rising edge</action>
            <expected>Phase advances only on PCLK rising edge</expected>
          </step>
          <step num="6">
            <action>Check that no peripheral output toggles between PCLK edges</action>
            <expected>All peripheral signals stable except at PCLK rising edges, confirming clock connectivity</expected>
          </step>
        </steps>
        <pass_criteria>1. PENABLE asserts exactly 1 PCLK cycle after PSEL. 2. No peripheral phase change occurs while PCLK is static. 3. All transitions align to PCLK rising edges. 4. PADDR=0x0000_3000 stable across the transfer.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CONNECTIVITY_010" name="presetn_reset_connectivity">
        <req_ref>REQ_006</req_ref>
        <objective>Verify PRESETn forces peripheral outputs to their defined reset values and the interface recovers after deassertion.</objective>
        <preconditions>
          <condition>PCLK running</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, assert PRESETn=0 (active) while a transfer was in progress with PSEL=1, PENABLE=1, PADDR=0x0000_4000</action>
            <expected>Reset takes effect</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge PCLK with PRESETn=0), sample peripheral outputs</action>
            <expected>PSEL=0, PENABLE=0, PADDR=0x0000_0000, PWDATA=0x0000_0000 per reset state (Table 8)</expected>
          </step>
          <step num="3">
            <action>Hold PRESETn=0 for 3 PCLK cycles</action>
            <expected>Peripheral outputs remain at reset values (PSEL=0, PENABLE=0)</expected>
          </step>
          <step num="4">
            <action>At T6, deassert PRESETn=1 (rising-edge deassertion)</action>
            <expected>Interface returns to idle, ready for new activity</expected>
          </step>
          <step num="5">
            <action>At T8, issue a fresh source write HADDR=0x0000_4000, HWRITE=1, HWDATA=0xCAFE_F00D, HSEL=1, HTRANS=2'b10</action>
            <expected>New transfer proceeds: SETUP PSEL=1/PENABLE=0, then ACTIVE PSEL=1/PENABLE=1, PADDR=0x0000_4000</expected>
          </step>
          <step num="6">
            <action>Verify peripheral outputs were reset and that PADDR/PWDATA=0xCAFE_F00D drive correctly post-reset</action>
            <expected>Reset values confirmed and normal operation resumes, proving PRESETn connectivity</expected>
          </step>
        </steps>
        <pass_criteria>1. During PRESETn=0: PSEL=0, PENABLE=0, PADDR=0x0000_0000, PWDATA=0x0000_0000. 2. Outputs stay reset for full assertion period. 3. After PRESETn=1 deassertion, new transfer drives PADDR=0x0000_4000 and PWDATA=0xCAFE_F00D correctly.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="error_tests" category="error" count="16">
      <test_case test_id="TEST_ERROR_001" name="addr_error_basic_detection_capture">
        <req_ref>REQ_016</req_ref>
        <objective>Verify that a request to an invalid address range sets ADDR_ERR, returns HRESP error, captures ERROR_ADDR, and that the model recovers cleanly and shows a clean error log after recovery.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>Valid example address map known (e.g., legal region 0x0000_0000-0x0000_FFFF)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure device: write CTRL=0x00000001 (ENABLE=1, TIMEOUT_EN=0). Verify STATUS read-back.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001 (READY=1, BUSY=0, no sticky errors)</expected>
          </step>
          <step num="2">
            <action>At T2, send good traffic: drive HSEL=1, HTRANS=2'b10 (NONSEQ/New), HWRITE=1, HADDR=0x0000_1000, HSIZE=3'b010, HWDATA=0xCAFE_0001.</action>
            <expected>Source capture occurs, model accepts transfer, FLOW-1 to FLOW-5 proceed</expected>
          </step>
          <step num="3">
            <action>At T3-T4, allow target side to complete (PREADY=1, PSLVERR=0). Observe HREADY_OUT and HRESP.</action>
            <expected>HREADY_OUT=1 at completion, HRESP=0 (OKAY), good write completes</expected>
          </step>
          <step num="4">
            <action>At T5, read STATUS register (offset 0xF04) and verify clean error state.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0 (bit4), ERR_INT=0 (bit7), READY=1</expected>
          </step>
          <step num="5">
            <action>At T6, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) to confirm clean log.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="6">
            <action>At T7, inject address error: drive HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0xDEAD_0000 (unsupported/invalid range), HWDATA=0xBAD0_0001.</action>
            <expected>Model detects invalid-address scenario per Section 7.1 Address error class</expected>
          </step>
          <step num="7">
            <action>At T8, observe error detection on source side and STATUS update.</action>
            <expected>ADDR_ERR=1 (STATUS bit4), HRESP=1 (error indication), HREADY_OUT=1 to complete error response</expected>
          </step>
          <step num="8">
            <action>At T9, if ERR_INT_EN was enabled, check sticky interrupt aggregation. (CTRL.ERR_INT_EN=0 in this run, so ERR_INT reflects sticky aggregation only.) Read STATUS bit7.</action>
            <expected>ERR_INT=1 (bit7) sticky aggregated error set since an error class occurred</expected>
          </step>
          <step num="9">
            <action>At T10, read error log STATUS (0xF04) to verify error type captured.</action>
            <expected>ADDR_ERR=1 (bit4) set; TIMEOUT_ERR=0 (bit6); PSLVERR=0 (bit5) confirming address-class error only</expected>
          </step>
          <step num="10">
            <action>At T11, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) to verify captured address/context.</action>
            <expected>ERROR_ADDR=0xDEAD_0000 (captured invalid address), ERROR_INFO non-zero with direction=write and coarse error class=address</expected>
          </step>
          <step num="11">
            <action>At T12, clear interrupt/sticky flags: write STATUS=0x000000F0 (W1C clear of ERR_INT, TIMEOUT_ERR, PSLVERR, ADDR_ERR).</action>
            <expected>Write-1-to-clear accepted on R/W1C bits 7,6,5,4</expected>
          </step>
          <step num="12">
            <action>At T13, read STATUS to verify interrupt/sticky bits cleared.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0, ERR_INT=0, READY=1</expected>
          </step>
          <step num="13">
            <action>At T14, perform recovery: set CTRL.SOFT_RST=1 (write CTRL=0x00000003), then return CTRL=0x00000001.</action>
            <expected>Soft reset clears active transfer state and sticky status; basic config preserved</expected>
          </step>
          <step num="14">
            <action>At T15, read error log after recovery: ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C).</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000 (log clean post-recovery)</expected>
          </step>
          <step num="15">
            <action>At T16, reconfigure device: write CTRL=0x00000001, verify STATUS clean.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001</expected>
          </step>
          <step num="16">
            <action>At T17, send good traffic: HSEL=1, HTRANS=2'b10, HWRITE=0 (read), HADDR=0x0000_2000. Drive target PRDATA=0x1234_5678, PREADY=1, PSLVERR=0.</action>
            <expected>Transfer accepted, target read returns data after completion</expected>
          </step>
          <step num="17">
            <action>At T18, PROVE: verify data integrity (HRDATA=0x1234_5678, HRESP=0) AND error log clean (ADDR_ERR=0, ERROR_ADDR=0x00000000).</action>
            <expected>HRDATA=0x1234_5678, HRESP=0, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
        </steps>
        <pass_criteria>1. Good pre-error traffic completes with HRESP=0. 2. Invalid HADDR=0xDEAD_0000 sets ADDR_ERR=1 and HRESP=1. 3. ERROR_ADDR captures 0xDEAD_0000. 4. W1C clears sticky flags. 5. Soft reset recovery clears log. 6. Post-recovery good read returns HRDATA=0x1234_5678 with clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_002" name="addr_error_boundary_just_outside_valid_range">
        <req_ref>REQ_016</req_ref>
        <objective>Verify that the first address immediately above the highest valid range triggers ADDR_ERR while the last valid address does not, and that ERROR_ADDR captures the exact boundary-violating address.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>CTRL=0x00000001 (ENABLE=1)</condition>
          <condition>Assume valid region top = 0x0000_FFFF, register region 0xF00-0xF0C</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure: write CTRL=0x00000001. Read-back verify.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001</expected>
          </step>
          <step num="2">
            <action>At T2, send good traffic at last valid address: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_FFFC, HSIZE=3'b010, HWDATA=0xEDGE_0001.</action>
            <expected>Transfer accepted into valid range, FLOW-1 begins</expected>
          </step>
          <step num="3">
            <action>At T3-T4, complete with PREADY=1, PSLVERR=0. Observe HRESP/HREADY_OUT.</action>
            <expected>HRESP=0 (OKAY), HREADY_OUT=1, no address error (last valid address accepted)</expected>
          </step>
          <step num="4">
            <action>At T5, read STATUS (0xF04) to verify clean error log.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0 (bit4), ERR_INT=0 (bit7)</expected>
          </step>
          <step num="5">
            <action>At T6, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) confirm clean.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="6">
            <action>At T7, inject boundary error: drive HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0001_0000 (first address just outside valid range), HWDATA=0xOVER_0001.</action>
            <expected>Address-class error condition triggered per Section 7.1</expected>
          </step>
          <step num="7">
            <action>At T8, observe error detection.</action>
            <expected>ADDR_ERR=1 (STATUS bit4), HRESP=1, HREADY_OUT=1 to complete error response</expected>
          </step>
          <step num="8">
            <action>At T9, check sticky aggregated interrupt indication ERR_INT.</action>
            <expected>ERR_INT=1 (STATUS bit7) sticky set</expected>
          </step>
          <step num="9">
            <action>At T10, read error log STATUS (0xF04) to verify error type captured.</action>
            <expected>ADDR_ERR=1; TIMEOUT_ERR=0; PSLVERR=0 (address-class only)</expected>
          </step>
          <step num="10">
            <action>At T11, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C).</action>
            <expected>ERROR_ADDR=0x0001_0000 (exact boundary-violating address), ERROR_INFO indicates write direction and address error class</expected>
          </step>
          <step num="11">
            <action>At T12, clear interrupt: write STATUS=0x00000090 (W1C ERR_INT bit7 + ADDR_ERR bit4).</action>
            <expected>W1C accepted on bits 7 and 4</expected>
          </step>
          <step num="12">
            <action>At T13, read STATUS to verify cleared.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0, ERR_INT=0</expected>
          </step>
          <step num="13">
            <action>At T14, perform recovery via soft reset: write CTRL=0x00000003 then CTRL=0x00000001.</action>
            <expected>SOFT_RST clears in-flight state and sticky flags</expected>
          </step>
          <step num="14">
            <action>At T15, read error log after recovery.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="15">
            <action>At T16, reconfigure: CTRL=0x00000001, verify STATUS.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001</expected>
          </step>
          <step num="16">
            <action>At T17, send good traffic at last valid address again: HADDR=0x0000_FFFC, HWRITE=0, target PRDATA=0xABCD_1234, PREADY=1.</action>
            <expected>Read accepted, no address error</expected>
          </step>
          <step num="17">
            <action>At T18, PROVE: verify HRDATA=0xABCD_1234, HRESP=0, AND error log clean.</action>
            <expected>HRDATA=0xABCD_1234, HRESP=0, ADDR_ERR=0, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
        </steps>
        <pass_criteria>1. Last valid address 0x0000_FFFC completes with HRESP=0, ADDR_ERR=0. 2. First invalid address 0x0001_0000 sets ADDR_ERR=1, HRESP=1. 3. ERROR_ADDR captures exact 0x0001_0000. 4. Boundary discrimination correct. 5. Recovery clears log. 6. Post-recovery read returns 0xABCD_1234 with clean log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_003" name="addr_error_read_direction_context_capture">
        <req_ref>REQ_016</req_ref>
        <objective>Verify that an invalid-address READ transaction is detected, ERROR_ADDR captures the read address, ERROR_INFO captures read direction, and HRDATA is not treated as valid data.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>CTRL=0x00000001 (ENABLE=1)</condition>
          <condition>ERR_INT_EN configurable</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure with interrupt enable: write CTRL=0x00000009 (ENABLE=1 bit0, ERR_INT_EN=1 bit3). Read-back verify.</action>
            <expected>CTRL=0x00000009, STATUS=0x00000001</expected>
          </step>
          <step num="2">
            <action>At T2, send good read traffic: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_3000, HSIZE=3'b010. Drive PRDATA=0x5555_AAAA, PREADY=1, PSLVERR=0.</action>
            <expected>Read accepted, target returns data</expected>
          </step>
          <step num="3">
            <action>At T3-T4, complete transfer. Observe HRDATA and HRESP.</action>
            <expected>HRDATA=0x5555_AAAA, HRESP=0, HREADY_OUT=1 (good read completes)</expected>
          </step>
          <step num="4">
            <action>At T5, read STATUS (0xF04) verify clean.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0, ERR_INT=0</expected>
          </step>
          <step num="5">
            <action>At T6, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) confirm clean.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="6">
            <action>At T7, inject address error on READ: drive HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0xBEEF_0000 (invalid range read).</action>
            <expected>Address-class error triggered for read transaction</expected>
          </step>
          <step num="7">
            <action>At T8, observe error detection on source side.</action>
            <expected>ADDR_ERR=1 (STATUS bit4), HRESP=1, HRDATA must NOT be presented as valid (no target access launched)</expected>
          </step>
          <step num="8">
            <action>At T9, check interrupt asserted since ERR_INT_EN=1.</action>
            <expected>ERR_INT=1 (STATUS bit7) sticky interrupt-style indication asserted</expected>
          </step>
          <step num="9">
            <action>At T10, read error log STATUS (0xF04) verify error type.</action>
            <expected>ADDR_ERR=1 (bit4); PSLVERR=0; TIMEOUT_ERR=0 (address-class only)</expected>
          </step>
          <step num="10">
            <action>At T11, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) for read context.</action>
            <expected>ERROR_ADDR=0xBEEF_0000, ERROR_INFO indicates direction=read and coarse error class=address (per Table 7)</expected>
          </step>
          <step num="11">
            <action>At T12, clear interrupt: write STATUS=0x00000090 (W1C ERR_INT bit7 + ADDR_ERR bit4).</action>
            <expected>W1C clears bits 7 and 4</expected>
          </step>
          <step num="12">
            <action>At T13, read STATUS verify interrupt cleared.</action>
            <expected>STATUS=0x00000001, ERR_INT=0, ADDR_ERR=0</expected>
          </step>
          <step num="13">
            <action>At T14, perform recovery: soft reset write CTRL=0x0000000B (ENABLE=1, ERR_INT_EN=1, SOFT_RST=1) then CTRL=0x00000009.</action>
            <expected>SOFT_RST clears active state and sticky flags; ERR_INT_EN config preserved</expected>
          </step>
          <step num="14">
            <action>At T15, read error log after recovery.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="15">
            <action>At T16, reconfigure: write CTRL=0x00000009, verify STATUS.</action>
            <expected>CTRL=0x00000009, STATUS=0x00000001</expected>
          </step>
          <step num="16">
            <action>At T17, send good read traffic: HWRITE=0, HADDR=0x0000_4000, PRDATA=0x0F0F_F0F0, PREADY=1, PSLVERR=0.</action>
            <expected>Read accepted, target returns data</expected>
          </step>
          <step num="17">
            <action>At T18, PROVE: verify HRDATA=0x0F0F_F0F0, HRESP=0, AND error log clean.</action>
            <expected>HRDATA=0x0F0F_F0F0, HRESP=0, ADDR_ERR=0, ERR_INT=0, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
        </steps>
        <pass_criteria>1. Good read completes with HRDATA=0x5555_AAAA, HRESP=0. 2. Invalid read HADDR=0xBEEF_0000 sets ADDR_ERR=1, HRESP=1, no valid HRDATA. 3. ERR_INT=1 with ERR_INT_EN=1. 4. ERROR_ADDR=0xBEEF_0000, ERROR_INFO captures read direction. 5. Recovery clears log preserving config. 6. Post-recovery read returns 0x0F0F_F0F0 with clean log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_004" name="addr_error_during_active_transfer_with_reset_recovery">
        <req_ref>REQ_016</req_ref>
        <objective>Verify address error detection on a request following a valid in-flight transfer, then verify hard/soft reset cleanly aborts and clears sticky ADDR_ERR and captured debug registers.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>CTRL=0x00000001</condition>
          <condition>Valid region known</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure: write CTRL=0x00000001. Verify STATUS.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001 (READY=1, BUSY=0)</expected>
          </step>
          <step num="2">
            <action>At T2, send good traffic: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_5000, HWDATA=0x1111_2222. Drive PREADY=1, PSLVERR=0.</action>
            <expected>Transfer accepted, completes with HRESP=0</expected>
          </step>
          <step num="3">
            <action>At T3, verify good write completed and STATUS clean.</action>
            <expected>HREADY_OUT=1, HRESP=0, STATUS=0x00000001</expected>
          </step>
          <step num="4">
            <action>At T4, read STATUS (0xF04) verify clean error log.</action>
            <expected>STATUS=0x00000001, ADDR_ERR=0 (bit4), ERR_INT=0 (bit7)</expected>
          </step>
          <step num="5">
            <action>At T5, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) confirm clean.</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="6">
            <action>At T6, start a valid in-flight transfer then immediately issue invalid one: drive HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0xFEED_0000 (invalid range), HWDATA=0x3333_4444. Hold PREADY=0 initially to model active phase.</action>
            <expected>Model captures request; invalid-address detected per Section 7.1</expected>
          </step>
          <step num="7">
            <action>At T7, observe error detection.</action>
            <expected>ADDR_ERR=1 (STATUS bit4), HRESP=1, HREADY_OUT=1 to complete error response, BUSY may transition</expected>
          </step>
          <step num="8">
            <action>At T8, check sticky aggregated interrupt ERR_INT.</action>
            <expected>ERR_INT=1 (STATUS bit7)</expected>
          </step>
          <step num="9">
            <action>At T9, read error log STATUS (0xF04) verify error type captured.</action>
            <expected>ADDR_ERR=1; TIMEOUT_ERR=0; PSLVERR=0 (address-class)</expected>
          </step>
          <step num="10">
            <action>At T10, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C).</action>
            <expected>ERROR_ADDR=0xFEED_0000 (most recent error event), ERROR_INFO captures write direction and address error class</expected>
          </step>
          <step num="11">
            <action>At T11, clear interrupt: write STATUS=0x00000090 (W1C ERR_INT + ADDR_ERR).</action>
            <expected>W1C accepted on bits 7 and 4</expected>
          </step>
          <step num="12">
            <action>At T12, read STATUS verify interrupt cleared.</action>
            <expected>STATUS=0x00000001, ERR_INT=0, ADDR_ERR=0</expected>
          </step>
          <step num="13">
            <action>At T13, perform recovery via hard reset: assert HRESETn=0 (and PRESETn=0) for &gt;=2 cycles, then deassert to 1.</action>
            <expected>Reset returns model to clean idle: HREADY_OUT=1, HRESP=0, PSEL=0, PENABLE=0, CTRL=0x00000001, STATUS=0x00000001 (per Table 8)</expected>
          </step>
          <step num="14">
            <action>At T14, read error log after recovery: ERROR_ADDR (0xF08), ERROR_INFO (0xF0C).</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000 (cleared by reset per Table 8)</expected>
          </step>
          <step num="15">
            <action>At T15, reconfigure device after reset: write CTRL=0x00000001, verify STATUS.</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001</expected>
          </step>
          <step num="16">
            <action>At T16, send good traffic: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_6000, HWDATA=0x9999_8888, PREADY=1, PSLVERR=0; then read back HWRITE=0, HADDR=0x0000_6000, PRDATA=0x9999_8888.</action>
            <expected>Write then read complete cleanly</expected>
          </step>
          <step num="17">
            <action>At T17, PROVE: verify data integrity HRDATA=0x9999_8888, HRESP=0, AND error log clean (ADDR_ERR=0, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000).</action>
            <expected>HRDATA=0x9999_8888, HRESP=0, STATUS=0x00000001, ADDR_ERR=0, ERR_INT=0, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
        </steps>
        <pass_criteria>1. Pre-error good write completes HRESP=0. 2. Invalid HADDR=0xFEED_0000 following activity sets ADDR_ERR=1, HRESP=1. 3. ERROR_ADDR captures 0xFEED_0000. 4. Hard reset cleanly aborts in-flight work and resets all registers to Table 8 values. 5. ERROR_ADDR/ERROR_INFO cleared by reset. 6. Post-reset write/read of 0x9999_8888 succeeds with clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_005" name="timeout_error_basic_detection">
        <req_ref>REQ_017</req_ref>
        <objective>Verify a timeout error is detected, captured in STATUS, and logged when PREADY is never asserted within the programmed window.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>PRESETn deasserted</condition>
          <condition>Single clock domain assumed</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL: write 0x0000_00F1 to CTRL (offset 0xF00) =&gt; ENABLE=1, SOFT_RST=0, ERR_INT_EN=0, TIMEOUT_VAL=3'b111, TIMEOUT_EN=1</action>
            <expected>CTRL=0x0000_00F1, timeout behavior enabled, bridge enabled</expected>
          </step>
          <step num="2">
            <action>At T2, send a good write: drive HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x0000_1000, HWDATA=0xDEAD_BEEF; on target side allow PREADY=1 during active phase</action>
            <expected>Transfer accepted: PSEL=1 then PENABLE=1; PREADY=1; HREADY_OUT=1; HRESP=0 (OKAY)</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (offset 0xF04) and verify clean</action>
            <expected>STATUS=0x0000_0001 (READY=1, no sticky errors); TIMEOUT_ERR(bit6)=0, ERR_INT(bit7)=0</expected>
          </step>
          <step num="4">
            <action>At T4, inject timeout: drive HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x0000_2000, HWDATA=0xCAFE_0001; on target side hold PREADY=0 indefinitely (target stall)</action>
            <expected>Bridge captures source transfer (FLOW-1), enters target SETUP (PSEL=1, PENABLE=0) then ACTIVE (PENABLE=1); completion held, HREADY_OUT=0, BUSY(bit1)=1</expected>
          </step>
          <step num="5">
            <action>At T5..Tn, keep PREADY=0 and count cycles until the programmed observation window (TIMEOUT_VAL=3'b111) elapses</action>
            <expected>Timeout window expires; model declares timeout error condition; ERROR=1 internally</expected>
          </step>
          <step num="6">
            <action>At Tn+1, sample HRESP and HREADY_OUT on source side</action>
            <expected>HRESP=1 (error indication), HREADY_OUT=1 (completion released with error)</expected>
          </step>
          <step num="7">
            <action>At Tn+2, read STATUS (0xF04) and verify error type captured</action>
            <expected>STATUS bit6 TIMEOUT_ERR=1 (sticky); STATUS bit7 ERR_INT=0 (ERR_INT_EN was 0); READY bit0=1</expected>
          </step>
          <step num="8">
            <action>At Tn+3, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_2000 (captured failing address); ERROR_INFO captures direction=write and coarse error class=timeout</expected>
          </step>
          <step num="9">
            <action>At Tn+4, (interrupt not applicable since ERR_INT_EN=0) confirm no interrupt-style indication asserted</action>
            <expected>ERR_INT(bit7)=0; no sticky aggregated interrupt indication</expected>
          </step>
          <step num="10">
            <action>At Tn+5, clear sticky flag: write 0x0000_0040 to STATUS (W1C on bit6 TIMEOUT_ERR)</action>
            <expected>Write-1-to-clear accepted for bit6</expected>
          </step>
          <step num="11">
            <action>At Tn+6, read STATUS (0xF04) to verify clear</action>
            <expected>STATUS bit6 TIMEOUT_ERR=0; STATUS=0x0000_0001</expected>
          </step>
          <step num="12">
            <action>At Tn+7, perform recovery via soft reset: write CTRL=0x0000_00F3 (SOFT_RST=1), then write CTRL=0x0000_00F1 (SOFT_RST=0)</action>
            <expected>Soft reset clears active transfer state and sticky flags, preserves configuration; BUSY=0</expected>
          </step>
          <step num="13">
            <action>At Tn+8, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) after recovery</action>
            <expected>ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000 (cleared)</expected>
          </step>
          <step num="14">
            <action>At Tn+9, reconfigure CTRL=0x0000_00F1 (ENABLE=1, TIMEOUT_EN=1, TIMEOUT_VAL=3'b111) and read back</action>
            <expected>CTRL=0x0000_00F1; STATUS=0x0000_0001</expected>
          </step>
          <step num="15">
            <action>At Tn+10, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_3000, HWDATA=0x1234_5678 with PREADY=1; then PROVE integrity: verify PADDR=0x0000_3000, PWDATA=0x1234_5678, HRESP=0 and read STATUS</action>
            <expected>Transfer completes OKAY, HRESP=0, HREADY_OUT=1; STATUS=0x0000_0001 (TIMEOUT_ERR=0, ERR_INT=0) confirming error log clean and data integrity intact</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS clean (0x0000_0001) before injection. 2. With PREADY held 0 past TIMEOUT_VAL window, HRESP=1 and TIMEOUT_ERR(bit6)=1. 3. ERROR_ADDR=0x0000_2000 captured. 4. W1C clears TIMEOUT_ERR. 5. Soft reset clears ERROR_ADDR/ERROR_INFO. 6. Post-recovery good traffic completes OKAY with clean STATUS.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_006" name="timeout_disabled_no_error">
        <req_ref>REQ_017</req_ref>
        <objective>Verify that with TIMEOUT_EN=0 a prolonged PREADY=0 stall does not set TIMEOUT_ERR or HRESP, but instead holds completion (negative/control test).</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn/PRESETn deasserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL=0x0000_0071 (ENABLE=1, TIMEOUT_EN=0(bit7=0), TIMEOUT_VAL=3'b111)</action>
            <expected>CTRL=0x0000_0071; timeout behavior disabled</expected>
          </step>
          <step num="2">
            <action>At T2, send good read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_1000 with PREADY=1 and PRDATA=0xA5A5_A5A5</action>
            <expected>Transfer completes; HRDATA=0xA5A5_A5A5, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) verify clean</action>
            <expected>STATUS=0x0000_0001; TIMEOUT_ERR(bit6)=0, ERR_INT(bit7)=0</expected>
          </step>
          <step num="4">
            <action>At T4, inject stall: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_4000, HWDATA=0x0000_BEEF; hold PREADY=0 for many cycles (well beyond TIMEOUT_VAL window)</action>
            <expected>Target setup (PSEL=1,PENABLE=0) then active (PENABLE=1); completion held: HREADY_OUT=0, BUSY(bit1)=1</expected>
          </step>
          <step num="5">
            <action>At T5..Tn (cycles exceeding timeout window count), keep PREADY=0</action>
            <expected>No timeout fires because TIMEOUT_EN=0; HRESP remains 0; HREADY_OUT stays 0</expected>
          </step>
          <step num="6">
            <action>At Tn+1, (interrupt N/A) confirm no interrupt-style indication</action>
            <expected>ERR_INT(bit7)=0</expected>
          </step>
          <step num="7">
            <action>At Tn+2, read STATUS (0xF04) verify no error type captured</action>
            <expected>TIMEOUT_ERR(bit6)=0; only BUSY(bit1)=1 (transaction still pending)</expected>
          </step>
          <step num="8">
            <action>At Tn+3, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000 (no error logged)</expected>
          </step>
          <step num="9">
            <action>At Tn+4, release stall: drive PREADY=1</action>
            <expected>Target completes; FLOW-5 completion: HREADY_OUT=1, HRESP=0 (OKAY)</expected>
          </step>
          <step num="10">
            <action>At Tn+5, verify completion clean</action>
            <expected>PADDR=0x0000_4000, PWDATA=0x0000_BEEF written; HRESP=0; BUSY(bit1)=0</expected>
          </step>
          <step num="11">
            <action>At Tn+6, perform soft reset for hygiene: CTRL=0x0000_0073 then CTRL=0x0000_0071</action>
            <expected>Active state cleared, BUSY=0, config preserved</expected>
          </step>
          <step num="12">
            <action>At Tn+7, read ERROR_ADDR/ERROR_INFO after recovery</action>
            <expected>Both 0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At Tn+8, reconfigure CTRL=0x0000_0071 and read back</action>
            <expected>CTRL=0x0000_0071; STATUS=0x0000_0001</expected>
          </step>
          <step num="14">
            <action>At Tn+9, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_5000, HWDATA=0x0BAD_F00D with PREADY=1</action>
            <expected>Transfer completes OKAY, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>At Tn+10, PROVE: read STATUS (0xF04) and verify data path/error log</action>
            <expected>STATUS=0x0000_0001, TIMEOUT_ERR=0, ERR_INT=0; PADDR=0x0000_5000, PWDATA=0x0BAD_F00D confirming integrity and clean log</expected>
          </step>
        </steps>
        <pass_criteria>1. With TIMEOUT_EN=0, prolonged PREADY=0 never sets TIMEOUT_ERR(bit6). 2. HRESP stays 0 during stall. 3. Completion occurs only after PREADY=1. 4. ERROR_ADDR/INFO remain 0. 5. Post-recovery good traffic OKAY with clean STATUS.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_007" name="timeout_error_with_interrupt">
        <req_ref>REQ_017</req_ref>
        <objective>Verify timeout error sets both TIMEOUT_ERR and aggregated ERR_INT when interrupt indication is enabled, captures debug context, and both clear via W1C.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn/PRESETn deasserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL=0x0000_00F9 (ENABLE=1, ERR_INT_EN(bit3)=1, TIMEOUT_VAL=3'b111, TIMEOUT_EN(bit7)=1)</action>
            <expected>CTRL=0x0000_00F9; timeout and interrupt indication enabled</expected>
          </step>
          <step num="2">
            <action>At T2, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_1000, HWDATA=0x0000_0001 with PREADY=1</action>
            <expected>Transfer completes OKAY; HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) verify clean</action>
            <expected>STATUS=0x0000_0001; TIMEOUT_ERR(bit6)=0, ERR_INT(bit7)=0</expected>
          </step>
          <step num="4">
            <action>At T4, inject timeout: HSEL=1, HTRANS=2'b10, HWRITE=0 (read), HADDR=0x0000_6000; hold PREADY=0 indefinitely</action>
            <expected>Target active (PENABLE=1); completion held; HREADY_OUT=0, BUSY(bit1)=1</expected>
          </step>
          <step num="5">
            <action>At T5..Tn, keep PREADY=0 until observation window (TIMEOUT_VAL=3'b111) elapses</action>
            <expected>Timeout fires; ERROR=1 internally</expected>
          </step>
          <step num="6">
            <action>At Tn+1, sample HRESP and check interrupt</action>
            <expected>HRESP=1 (error); HREADY_OUT=1; ERR_INT(bit7) asserted (interrupt-style indication active)</expected>
          </step>
          <step num="7">
            <action>At Tn+2, read STATUS (0xF04) verify error type captured</action>
            <expected>STATUS bit6 TIMEOUT_ERR=1 AND bit7 ERR_INT=1; STATUS=0x0000_00C1</expected>
          </step>
          <step num="8">
            <action>At Tn+3, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_6000; ERROR_INFO captures direction=read, coarse class=timeout, approx beat index</expected>
          </step>
          <step num="9">
            <action>At Tn+4, clear interrupt: write STATUS=0x0000_0080 (W1C on bit7 ERR_INT)</action>
            <expected>W1C accepted for ERR_INT</expected>
          </step>
          <step num="10">
            <action>At Tn+5, read STATUS verify interrupt cleared</action>
            <expected>ERR_INT(bit7)=0; TIMEOUT_ERR(bit6) still=1 (not yet cleared); STATUS=0x0000_0041</expected>
          </step>
          <step num="11">
            <action>At Tn+6, perform recovery: write CTRL=0x0000_00FB (SOFT_RST=1) then CTRL=0x0000_00F9 (SOFT_RST=0); also write STATUS=0x0000_0040 (W1C TIMEOUT_ERR)</action>
            <expected>Active state cleared, BUSY=0; TIMEOUT_ERR(bit6)=0; config preserved</expected>
          </step>
          <step num="12">
            <action>At Tn+7, read STATUS and ERROR_ADDR/ERROR_INFO after recovery</action>
            <expected>STATUS=0x0000_0001; ERROR_ADDR=0x0000_0000; ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At Tn+8, reconfigure CTRL=0x0000_00F9 and read back</action>
            <expected>CTRL=0x0000_00F9; STATUS=0x0000_0001</expected>
          </step>
          <step num="14">
            <action>At Tn+9, send good read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_7000 with PREADY=1, PRDATA=0xFEED_FACE</action>
            <expected>Transfer completes; HRDATA=0xFEED_FACE; HRESP=0; HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>At Tn+10, PROVE: verify HRDATA matches PRDATA AND read STATUS for clean log</action>
            <expected>HRDATA=0xFEED_FACE (integrity proven); STATUS=0x0000_0001 (TIMEOUT_ERR=0, ERR_INT=0) confirming error log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS clean before injection. 2. Timeout sets BOTH TIMEOUT_ERR(bit6) and ERR_INT(bit7); STATUS=0x0000_00C1. 3. HRESP=1. 4. ERROR_ADDR=0x0000_6000. 5. ERR_INT clears independently via W1C leaving TIMEOUT_ERR=1. 6. After recovery STATUS=0x0000_0001 and post-traffic data integrity proven.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_008" name="timeout_window_boundary">
        <req_ref>REQ_017</req_ref>
        <objective>Verify the timeout window boundary: just-in-time PREADY completes without error, while one-cycle-late PREADY triggers TIMEOUT_ERR.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn/PRESETn deasserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL=0x0000_0091 (ENABLE=1, TIMEOUT_EN(bit7)=1, TIMEOUT_VAL=3'b001 small window)</action>
            <expected>CTRL=0x0000_0091; small timeout window selected</expected>
          </step>
          <step num="2">
            <action>At T2, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_1000, HWDATA=0x1111_2222 with PREADY=1</action>
            <expected>Transfer completes OKAY; HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) verify clean</action>
            <expected>STATUS=0x0000_0001; TIMEOUT_ERR(bit6)=0</expected>
          </step>
          <step num="4">
            <action>At T4, in-window case: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_8000, HWDATA=0x3333_4444; hold PREADY=0 then assert PREADY=1 on the LAST cycle within the window (cycle = TIMEOUT_VAL)</action>
            <expected>Completion occurs in-window: HREADY_OUT=1, HRESP=0 (OKAY); no timeout</expected>
          </step>
          <step num="5">
            <action>At T5, read STATUS verify no error after in-window completion</action>
            <expected>TIMEOUT_ERR(bit6)=0; STATUS=0x0000_0001</expected>
          </step>
          <step num="6">
            <action>At T6, (interrupt N/A, ERR_INT_EN=0) confirm no indication</action>
            <expected>ERR_INT(bit7)=0</expected>
          </step>
          <step num="7">
            <action>At T7, read ERROR_ADDR (0xF08) verify no log entry</action>
            <expected>ERROR_ADDR=0x0000_0000; ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="8">
            <action>At T8, out-of-window case: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_9000, HWDATA=0x5555_6666; hold PREADY=0 one cycle PAST the window then assert PREADY=1</action>
            <expected>Window expired before PREADY: TIMEOUT_ERR fires; HRESP=1; HREADY_OUT=1 with error</expected>
          </step>
          <step num="9">
            <action>At T9, read STATUS verify error captured</action>
            <expected>TIMEOUT_ERR(bit6)=1; STATUS bit6 set</expected>
          </step>
          <step num="10">
            <action>At T10, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_9000; ERROR_INFO captures direction=write, class=timeout</expected>
          </step>
          <step num="11">
            <action>At T11, clear sticky flag: write STATUS=0x0000_0040 (W1C bit6)</action>
            <expected>TIMEOUT_ERR cleared</expected>
          </step>
          <step num="12">
            <action>At T12, perform recovery soft reset: CTRL=0x0000_0093 then CTRL=0x0000_0091; read ERROR_ADDR/INFO</action>
            <expected>BUSY=0; ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At T13, reconfigure CTRL=0x0000_0091 and read back STATUS</action>
            <expected>CTRL=0x0000_0091; STATUS=0x0000_0001</expected>
          </step>
          <step num="14">
            <action>At T14, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_A000, HWDATA=0x7777_8888 with PREADY=1 in-window</action>
            <expected>Transfer completes OKAY; HRESP=0, HREADY_OUT=1; PADDR=0x0000_A000, PWDATA=0x7777_8888</expected>
          </step>
          <step num="15">
            <action>At T15, PROVE: verify data path AND read STATUS clean</action>
            <expected>PADDR=0x0000_A000, PWDATA=0x7777_8888 confirmed; STATUS=0x0000_0001 (TIMEOUT_ERR=0) confirming boundary handling correct and log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS clean before injection. 2. PREADY on last in-window cycle =&gt; HRESP=0, no TIMEOUT_ERR. 3. PREADY one cycle past window =&gt; HRESP=1, TIMEOUT_ERR(bit6)=1, ERROR_ADDR=0x0000_9000. 4. W1C clears flag. 5. Soft reset clears log. 6. Post-recovery good traffic OKAY with clean STATUS and proven data integrity.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_009" name="target_error_basic_pslverr_capture">
        <req_ref>REQ_018</req_ref>
        <objective>Verify a single target-side error (PSLVERR=1) during an active access is detected, propagated to HRESP, captured in ERROR_INFO/STATUS, and the model recovers cleanly with clean error log after recovery.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1 (reset deasserted)</condition>
          <condition>PRESETn=1</condition>
          <condition>single clock domain</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure device: write CTRL=0x0000_0001 (ENABLE=1, TIMEOUT_EN=0) via source-side write to offset 0xF00</action>
            <expected>CTRL=0x0000_0001, bridge enabled, STATUS.READY=1, STATUS.BUSY=0</expected>
          </step>
          <step num="2">
            <action>At T2, send good traffic: drive HSEL=1, HTRANS=2'b10(NONSEQ/New), HWRITE=1, HADDR=0x0000_1000, HSIZE=3'b010, HWDATA=0xCAFE_0001; advance through target setup (PSEL=1,PENABLE=0) then active (PENABLE=1) with PREADY=1, PSLVERR=0</action>
            <expected>Transfer completes, HREADY_OUT=1, HRESP=0, PWDATA=0xCAFE_0001, PADDR=0x0000_1000</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS register (offset 0xF04) — verify clean error log</action>
            <expected>STATUS=0x0000_0001 (READY=1, all sticky error bits PSLVERR/TIMEOUT_ERR/ADDR_ERR/ERR_INT=0)</expected>
          </step>
          <step num="4">
            <action>At T4, inject error: drive new active access HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_2000, HWDATA=0xDEAD_0002; at target active phase (PSEL=1, PENABLE=1) assert PSLVERR=1 with PREADY=1</action>
            <expected>Target error indication observed during active phase per FLOW-5, error capture triggered</expected>
          </step>
          <step num="5">
            <action>At T5 (rising edge after PSLVERR sampled), verify error detected on source side</action>
            <expected>HRESP=1 (simplified source-side error indication), STATUS.PSLVERR=1 (sticky), error response window active</expected>
          </step>
          <step num="6">
            <action>At T6, check sticky aggregated interrupt: read STATUS bit ERR_INT (bit 7) — assumes ERR_INT_EN=1 was set; if CTRL.ERR_INT_EN=0 skip assert</action>
            <expected>If ERR_INT_EN=1: STATUS.ERR_INT=1; else ERR_INT=0 (no interrupt enabled in this run)</expected>
          </step>
          <step num="7">
            <action>At T7, read error log type: read STATUS (0xF04) and verify error class captured</action>
            <expected>STATUS.PSLVERR=1 indicating target-error class observed, STATUS=0x0000_0021 (PSLVERR + READY)</expected>
          </step>
          <step num="8">
            <action>At T8, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) — verify address and transaction context captured</action>
            <expected>ERROR_ADDR=0x0000_2000, ERROR_INFO non-zero with direction=write and coarse error class=target-error</expected>
          </step>
          <step num="9">
            <action>At T9, clear interrupt: write STATUS=0x0000_0080 (W1C to ERR_INT bit 7)</action>
            <expected>Write-1-to-clear accepted on R/W1C field</expected>
          </step>
          <step num="10">
            <action>At T10, read STATUS — verify interrupt cleared</action>
            <expected>STATUS.ERR_INT=0</expected>
          </step>
          <step num="11">
            <action>At T11, perform recovery: clear sticky PSLVERR by writing STATUS=0x0000_0020 (W1C bit 5), then trigger soft reset via CTRL.SOFT_RST: write CTRL=0x0000_0003</action>
            <expected>STATUS.PSLVERR cleared, SOFT_RST action clears active transfer state and sticky flags per Sec 6.3</expected>
          </step>
          <step num="12">
            <action>At T12, read error log after recovery: read STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>STATUS=0x0000_0001 (clean), ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At T13, reconfigure device: write CTRL=0x0000_0001 (re-enable, SOFT_RST self-cleared)</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1, BUSY=0</expected>
          </step>
          <step num="14">
            <action>At T14, send good traffic: HSEL=1, HTRANS=2'b10, HWRITE=0(read), HADDR=0x0000_3000; target active PSEL=1,PENABLE=1, PREADY=1, PSLVERR=0, PRDATA=0xBEEF_0003</action>
            <expected>Read completes, HRDATA=0xBEEF_0003, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>At T15, PROVE: compare HRDATA=0xBEEF_0003 against driven PRDATA AND read STATUS to confirm clean log</action>
            <expected>Data integrity proven: HRDATA==0xBEEF_0003; STATUS=0x0000_0001 (no sticky errors); error log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=1 asserted on PSLVERR=1 during active phase. 2. STATUS.PSLVERR sticky set. 3. ERROR_ADDR=0x0000_2000 and ERROR_INFO captured. 4. W1C clears interrupt and sticky bits. 5. Soft reset recovers to clean state. 6. Post-recovery read data integrity proven (HRDATA=0xBEEF_0003) AND STATUS=0x0000_0001.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_010" name="target_error_during_read_access">
        <req_ref>REQ_018</req_ref>
        <objective>Verify target error injected on a read transfer is captured with read direction in ERROR_INFO, HRDATA is not treated as valid completion, and recovery restores clean operation.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>ERR_INT_EN enabled for interrupt path</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure: write CTRL=0x0000_0009 (ENABLE=1, ERR_INT_EN=1)</action>
            <expected>CTRL=0x0000_0009, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>At T2, send good read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_4000; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0,PRDATA=0x1234_5678</action>
            <expected>HRDATA=0x1234_5678, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) — verify clean</action>
            <expected>STATUS=0x0000_0001, all sticky error bits=0</expected>
          </step>
          <step num="4">
            <action>At T4, inject error on read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_4004; at target active phase (PSEL=1,PENABLE=1) assert PSLVERR=1, PREADY=1, PRDATA=0xFFFF_FFFF (garbage)</action>
            <expected>Target error observed during active read, error capture triggered, read data deemed invalid</expected>
          </step>
          <step num="5">
            <action>At T5 (rising edge), verify error detected</action>
            <expected>HRESP=1, STATUS.PSLVERR=1, error response window asserted; HRDATA not used as valid completion</expected>
          </step>
          <step num="6">
            <action>At T6, check interrupt asserted (ERR_INT_EN=1)</action>
            <expected>STATUS.ERR_INT=1 (sticky aggregated error)</expected>
          </step>
          <step num="7">
            <action>At T7, read error log type: read STATUS</action>
            <expected>STATUS=0x0000_00A1 (ERR_INT=1, PSLVERR=1, READY=1), target-error class captured</expected>
          </step>
          <step num="8">
            <action>At T8, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_4004, ERROR_INFO encodes direction=read and coarse error class=target-error</expected>
          </step>
          <step num="9">
            <action>At T9, clear interrupt: write STATUS=0x0000_0080 (W1C bit 7)</action>
            <expected>ERR_INT clear accepted</expected>
          </step>
          <step num="10">
            <action>At T10, read STATUS — verify interrupt cleared</action>
            <expected>STATUS.ERR_INT=0, STATUS=0x0000_0021 (PSLVERR still sticky)</expected>
          </step>
          <step num="11">
            <action>At T11, recovery: write STATUS=0x0000_0020 (W1C PSLVERR), then CTRL=0x0000_000B (SOFT_RST=1, ENABLE=1, ERR_INT_EN=1)</action>
            <expected>PSLVERR cleared, soft reset clears active/sticky state per Sec 6.3</expected>
          </step>
          <step num="12">
            <action>At T12, read error log after recovery: STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>STATUS=0x0000_0009 (clean, ENABLE+ERR_INT_EN), ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At T13, reconfigure: write CTRL=0x0000_0009 (SOFT_RST self-cleared, ENABLE=1, ERR_INT_EN=1)</action>
            <expected>CTRL=0x0000_0009, STATUS.READY=1</expected>
          </step>
          <step num="14">
            <action>At T14, send good read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_5000; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0,PRDATA=0x0BADF00D</action>
            <expected>HRDATA=0x0BADF00D, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>At T15, PROVE: compare HRDATA=0x0BADF00D vs driven PRDATA AND read STATUS for clean log</action>
            <expected>HRDATA==0x0BADF00D (integrity proven); STATUS=0x0000_0009 (no sticky errors set); error log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. PSLVERR on read sets HRESP=1 and STATUS.PSLVERR. 2. ERROR_INFO captures direction=read. 3. ERROR_ADDR=0x0000_4004. 4. ERR_INT asserts and clears via W1C. 5. Soft reset recovery clears log. 6. Post-recovery read integrity proven (HRDATA=0x0BADF00D) with clean STATUS.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_011" name="target_error_sticky_persistence_no_clear">
        <req_ref>REQ_018</req_ref>
        <objective>Verify the sticky behavior of STATUS.PSLVERR after a target error — flag persists across subsequent good (non-error) traffic and is only removed by W1C/soft reset.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure: write CTRL=0x0000_0001 (ENABLE=1)</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>At T2, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_6000, HWDATA=0xA5A5_0001; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0</action>
            <expected>HRESP=0, HREADY_OUT=1, PWDATA=0xA5A5_0001</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) — verify clean</action>
            <expected>STATUS=0x0000_0001, STATUS.PSLVERR=0</expected>
          </step>
          <step num="4">
            <action>At T4, inject target error: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_6010, HWDATA=0xA5A5_0002; at target active PSEL=1,PENABLE=1 assert PSLVERR=1, PREADY=1</action>
            <expected>Target error observed, capture triggered</expected>
          </step>
          <step num="5">
            <action>At T5 (rising edge), verify error detected</action>
            <expected>HRESP=1, STATUS.PSLVERR=1 (bit 5 set sticky)</expected>
          </step>
          <step num="6">
            <action>At T6, check aggregated interrupt (ERR_INT_EN=0 in this run)</action>
            <expected>STATUS.ERR_INT=0 (interrupt disabled), but STATUS.PSLVERR=1 remains</expected>
          </step>
          <step num="7">
            <action>At T7, read error log type: read STATUS</action>
            <expected>STATUS=0x0000_0021 (PSLVERR=1, READY=1)</expected>
          </step>
          <step num="8">
            <action>At T8, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_6010, ERROR_INFO direction=write, class=target-error</expected>
          </step>
          <step num="9">
            <action>At T9, send a subsequent GOOD transfer WITHOUT clearing: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_6020, HWDATA=0xA5A5_0003; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0</action>
            <expected>Good transfer completes HRESP=0, but sticky STATUS.PSLVERR must NOT auto-clear</expected>
          </step>
          <step num="10">
            <action>At T10, read STATUS — verify sticky persistence (interrupt path not applicable, verify flag retained)</action>
            <expected>STATUS=0x0000_0021, STATUS.PSLVERR still=1 (preserved, not auto-cleared by good traffic)</expected>
          </step>
          <step num="11">
            <action>At T11, perform recovery: write STATUS=0x0000_0020 (W1C bit 5) to clear PSLVERR</action>
            <expected>W1C accepted, STATUS.PSLVERR cleared</expected>
          </step>
          <step num="12">
            <action>At T12, read error log after recovery: STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>STATUS=0x0000_0001 (clean); ERROR_ADDR and ERROR_INFO retain last-captured 0x0000_6010 until next error (RO, not cleared by W1C of STATUS) — verify documented behavior</expected>
          </step>
          <step num="13">
            <action>At T13, reconfigure with soft reset to fully clear debug regs: write CTRL=0x0000_0003 (SOFT_RST=1, ENABLE=1), then re-read CTRL</action>
            <expected>Soft reset clears ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000; CTRL.SOFT_RST self-clears, CTRL=0x0000_0001</expected>
          </step>
          <step num="14">
            <action>At T14, send good write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_7000, HWDATA=0xC0DE_0004; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0</action>
            <expected>HRESP=0, HREADY_OUT=1, PWDATA=0xC0DE_0004</expected>
          </step>
          <step num="15">
            <action>At T15, PROVE: read-back via target PRDATA path on HADDR=0x0000_7000 returns 0xC0DE_0004 AND read STATUS for clean log</action>
            <expected>Data integrity proven: returned data==0xC0DE_0004; STATUS=0x0000_0001 (no sticky errors); ERROR_ADDR/ERROR_INFO=0x0000_0000; error log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS.PSLVERR set sticky on target error. 2. Sticky flag persists across a subsequent good transfer (no auto-clear). 3. W1C clears STATUS.PSLVERR. 4. Soft reset clears ERROR_ADDR/ERROR_INFO. 5. ERROR_ADDR=0x0000_6010 captured. 6. Post-recovery integrity proven (0xC0DE_0004) AND clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_012" name="target_error_mid_sequence_active_phase">
        <req_ref>REQ_018</req_ref>
        <objective>Verify target error injected on a specific beat of an ordered multi-transfer sequence is captured with beat index/context in ERROR_INFO and that error capture does not corrupt earlier completed beats.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>sequence handling enabled</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure: write CTRL=0x0000_0009 (ENABLE=1, ERR_INT_EN=1)</action>
            <expected>CTRL=0x0000_0009, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>At T2, send good sequence beat0: HSEL=1, HTRANS=2'b10(NONSEQ), HWRITE=1, HADDR=0x0000_8000, HSIZE=3'b010, HBURST=3'b011(INCR4), HWDATA=0x1111_0000; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0</action>
            <expected>Beat0 completes, HRESP=0, PWDATA=0x1111_0000, PADDR=0x0000_8000</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04) — verify clean before injection</action>
            <expected>STATUS=0x0000_0001, all sticky error bits=0</expected>
          </step>
          <step num="4">
            <action>At T4, send good sequence beat1: HTRANS=2'b11(SEQ), HADDR=0x0000_8004, HWDATA=0x1111_0001; target active PSEL=1,PENABLE=1,PREADY=1,PSLVERR=0</action>
            <expected>Beat1 completes, HRESP=0, PWDATA=0x1111_0001, PADDR=0x0000_8004</expected>
          </step>
          <step num="5">
            <action>At T5, inject error on beat2: HTRANS=2'b11(SEQ), HADDR=0x0000_8008, HWDATA=0x1111_0002; at target active phase PSEL=1,PENABLE=1 assert PSLVERR=1, PREADY=1</action>
            <expected>Target error observed during active phase of beat2, error detected; STATUS.PSLVERR=1, HRESP=1</expected>
          </step>
          <step num="6">
            <action>At T6, check interrupt asserted (ERR_INT_EN=1)</action>
            <expected>STATUS.ERR_INT=1</expected>
          </step>
          <step num="7">
            <action>At T7, read error log type: read STATUS</action>
            <expected>STATUS=0x0000_00A1 (ERR_INT=1, PSLVERR=1, READY=1), target-error class captured</expected>
          </step>
          <step num="8">
            <action>At T8, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x0000_8008 (beat2 address), ERROR_INFO encodes direction=write, beat index≈2, class=target-error</expected>
          </step>
          <step num="9">
            <action>At T9, clear interrupt: write STATUS=0x0000_0080 (W1C bit 7)</action>
            <expected>ERR_INT clear accepted</expected>
          </step>
          <step num="10">
            <action>At T10, read STATUS — verify interrupt cleared</action>
            <expected>STATUS.ERR_INT=0, STATUS=0x0000_0021 (PSLVERR sticky retained)</expected>
          </step>
          <step num="11">
            <action>At T11, recovery: write STATUS=0x0000_0020 (W1C PSLVERR), then CTRL=0x0000_000B (SOFT_RST=1) to abort in-flight sequence</action>
            <expected>PSLVERR cleared, soft reset aborts remaining beats and clears active/sticky state per Sec 6.3</expected>
          </step>
          <step num="12">
            <action>At T12, read error log after recovery: STATUS, ERROR_ADDR, ERROR_INFO</action>
            <expected>STATUS=0x0000_0009 (clean), ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>At T13, reconfigure: write CTRL=0x0000_0009 (SOFT_RST self-cleared)</action>
            <expected>CTRL=0x0000_0009, STATUS.READY=1, BUSY=0</expected>
          </step>
          <step num="14">
            <action>At T14, send good sequence (no error): beat0 HTRANS=2'b10 HADDR=0x0000_9000 HWDATA=0x2222_0000, beat1 HTRANS=2'b11 HADDR=0x0000_9004 HWDATA=0x2222_0001; all target active PREADY=1, PSLVERR=0</action>
            <expected>All beats complete in-order, HRESP=0, PADDR advances 0x0000_9000→0x0000_9004, PWDATA matches</expected>
          </step>
          <step num="15">
            <action>At T15, PROVE: verify each beat's PWDATA equals driven HWDATA (0x2222_0000, 0x2222_0001) in-order AND read STATUS for clean log</action>
            <expected>Data integrity proven: all beat data match and ordered; STATUS=0x0000_0009 (no sticky errors); ERROR_ADDR/ERROR_INFO=0x0000_0000; error log clean</expected>
          </step>
        </steps>
        <pass_criteria>1. Earlier beats (0,1) complete cleanly before error. 2. PSLVERR on beat2 sets HRESP=1 and STATUS.PSLVERR. 3. ERROR_ADDR=0x0000_8008 and ERROR_INFO beat index≈2 captured. 4. ERR_INT asserts and W1C clears. 5. Soft reset aborts sequence and clears log. 6. Post-recovery in-order sequence integrity proven (0x2222_0000/0x2222_0001) AND clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_013" name="target_error_response_window_basic">
        <req_ref>REQ_021</req_ref>
        <objective>Verify a target error (PSLVERR) during the active phase produces HRESP=1 on the source side within the error response window, and the error is logged and recoverable.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>PRESETn deasserted</condition>
          <condition>Bridge ENABLE=1 (CTRL=0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure device: write CTRL=0x0000_0001 (ENABLE=1, TIMEOUT_EN=0) at offset 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1 (STATUS=0x0000_0001)</expected>
          </step>
          <step num="2">
            <action>Send good traffic: at T1 drive HTRANS=2'b10 (New/NONSEQ), HADDR=0x0000_1000, HWRITE=1, HWDATA=0x0000_AAAA, HSEL=1, HREADY_IN=1; let target respond PREADY=1, PSLVERR=0</action>
            <expected>Bridge maps to target: PSEL=1, PENABLE=0 (setup) then PENABLE=1 (active); HREADY_OUT=1 on completion, HRESP=0</expected>
          </step>
          <step num="3">
            <action>Read error status register STATUS at 0xF04 — verify clean</action>
            <expected>STATUS=0x0000_0001 (READY=1, no PSLVERR/TIMEOUT_ERR/ADDR_ERR/ERR_INT sticky bits set)</expected>
          </step>
          <step num="4">
            <action>Inject error: at T1 drive HTRANS=2'b10, HADDR=0x0000_2000, HWRITE=1, HWDATA=0x0000_BEEF, HSEL=1; at T3 target enters active phase with PSEL=1, PENABLE=1; at T4 target asserts PSLVERR=1 with PREADY=1</action>
            <expected>Target error captured: PSLVERR=1 sampled at active phase (Figure 4 Target error at T3/T4)</expected>
          </step>
          <step num="5">
            <action>Verify error detected: sample HRESP on source side within error response window (T5–T6 per Figure 4)</action>
            <expected>HRESP=1 (error indication) asserted, HREADY_OUT=1 at completion of error response window</expected>
          </step>
          <step num="6">
            <action>Check interrupt: read STATUS.ERR_INT (bit 7) — applicable only if CTRL.ERR_INT_EN was set; here ERR_INT_EN=0 so aggregated interrupt not driven externally</action>
            <expected>STATUS.PSLVERR (bit 5) sticky=1; STATUS.ERR_INT=0 since ERR_INT_EN=0</expected>
          </step>
          <step num="7">
            <action>Read error log: read STATUS at 0xF04 — verify error type captured</action>
            <expected>STATUS=0x0000_0021 (PSLVERR bit5=1, READY bit0=1), confirming target error class</expected>
          </step>
          <step num="8">
            <action>Read error info: read ERROR_ADDR at 0xF08 and ERROR_INFO at 0xF0C</action>
            <expected>ERROR_ADDR=0x0000_2000 (captured offending address), ERROR_INFO encodes direction=write and coarse class=target-error</expected>
          </step>
          <step num="9">
            <action>Clear interrupt/sticky: write 1 to STATUS.PSLVERR (W1C) — write STATUS=0x0000_0020 at 0xF04</action>
            <expected>Write-1-to-clear accepted for bit 5</expected>
          </step>
          <step num="10">
            <action>Verify cleared: read STATUS at 0xF04</action>
            <expected>STATUS=0x0000_0001 (PSLVERR bit5 cleared, READY=1)</expected>
          </step>
          <step num="11">
            <action>Perform recovery: trigger soft reset by writing CTRL.SOFT_RST=1 (CTRL=0x0000_0003) at 0xF00</action>
            <expected>Active transfer state cleared, sticky flags cleared, PSEL=0, PENABLE=0, HREADY_OUT=1</expected>
          </step>
          <step num="12">
            <action>Read error log after recovery: read STATUS=0xF04, ERROR_ADDR=0xF08, ERROR_INFO=0xF0C</action>
            <expected>STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>Reconfigure device: write CTRL=0x0000_0001 (re-enable) at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1</expected>
          </step>
          <step num="14">
            <action>Send good traffic: at T1 drive HTRANS=2'b10, HADDR=0x0000_1004, HWRITE=0 (read), HSEL=1; target responds PREADY=1, PSLVERR=0, PRDATA=0x1234_5678</action>
            <expected>PSEL=1, PENABLE=1 in active phase; HRDATA=0x1234_5678 returned only after target completion, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>PROVE: compare returned HRDATA against expected 0x1234_5678 AND re-read STATUS=0xF04, ERROR_ADDR=0xF08, ERROR_INFO=0xF0C</action>
            <expected>HRDATA=0x1234_5678 (data integrity OK); STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000 (error log clean)</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS clean before injection (0x0000_0001). 2. PSLVERR=1 during PSEL=1,PENABLE=1 active phase causes HRESP=1 within error response window. 3. Sticky STATUS.PSLVERR set and ERROR_ADDR=0x0000_2000 captured. 4. W1C clears sticky flag. 5. Soft reset recovery clears all error state. 6. Post-recovery good read returns HRDATA=0x1234_5678 with HRESP=0 and clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_014" name="error_response_two_cycle_window_hresp_timing">
        <req_ref>REQ_021</req_ref>
        <objective>Verify the precise cycle timing of HRESP assertion relative to PSLVERR sampling and the error response window before HREADY_OUT completes.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge ENABLE=1 (CTRL=0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure: write CTRL=0x0000_0001 at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>Send good traffic: at T1 drive HTRANS=2'b10, HADDR=0x0000_3000, HWRITE=1, HWDATA=0x0000_0F0F, HSEL=1, HREADY_IN=1; target PREADY=1, PSLVERR=0</action>
            <expected>PSEL=1 setup at T2, PENABLE=1 active at T3, HREADY_OUT=1 at completion, HRESP=0</expected>
          </step>
          <step num="3">
            <action>Read STATUS at 0xF04 — verify clean</action>
            <expected>STATUS=0x0000_0001 (no sticky error bits)</expected>
          </step>
          <step num="4">
            <action>Inject error: at T1 drive HTRANS=2'b10, HADDR=0x0000_3100, HWRITE=1, HWDATA=0x0000_DEAD, HSEL=1; bridge drives PSEL=1,PENABLE=0 at T2; PSEL=1,PENABLE=1 at T3 (active); target asserts PSLVERR=1, PREADY=1 at T3</action>
            <expected>PSLVERR=1 sampled at rising edge of T3 during PSEL=1,PENABLE=1</expected>
          </step>
          <step num="5">
            <action>Verify error detected: sample HRESP at T4 and T5 (error response window per Figure 4)</action>
            <expected>HRESP=1 asserted at T4, held through error response window (T5–T6); HREADY_OUT held low during window then asserted=1 at window close</expected>
          </step>
          <step num="6">
            <action>Check interrupt: enable interrupt first by writing CTRL=0x0000_0009 (ENABLE=1, ERR_INT_EN=1) then re-inject; read STATUS.ERR_INT (bit 7)</action>
            <expected>After re-injection with ERR_INT_EN=1, STATUS.ERR_INT=1 (aggregated sticky interrupt indication)</expected>
          </step>
          <step num="7">
            <action>Read error log: read STATUS at 0xF04 — verify error type</action>
            <expected>STATUS shows PSLVERR (bit5)=1 and ERR_INT (bit7)=1 -&gt; STATUS=0x0000_00A1</expected>
          </step>
          <step num="8">
            <action>Read error info: ERROR_ADDR at 0xF08, ERROR_INFO at 0xF0C</action>
            <expected>ERROR_ADDR=0x0000_3100, ERROR_INFO encodes direction=write, target-error class</expected>
          </step>
          <step num="9">
            <action>Clear interrupt: write 1 to ERR_INT and PSLVERR (W1C) — write STATUS=0x0000_00A0 at 0xF04</action>
            <expected>W1C accepted for bits 7 and 5</expected>
          </step>
          <step num="10">
            <action>Verify interrupt cleared: read STATUS at 0xF04</action>
            <expected>STATUS=0x0000_0001 (ERR_INT and PSLVERR cleared, READY=1)</expected>
          </step>
          <step num="11">
            <action>Perform recovery: write CTRL.SOFT_RST=1 (CTRL=0x0000_000B = ENABLE+ERR_INT_EN+SOFT_RST) at 0xF00</action>
            <expected>Active state cleared, PSEL=0, PENABLE=0, HRESP=0, HREADY_OUT=1, sticky flags cleared</expected>
          </step>
          <step num="12">
            <action>Read error log after recovery: STATUS=0xF04, ERROR_ADDR=0xF08, ERROR_INFO=0xF0C</action>
            <expected>STATUS=0x0000_0009 (config preserved: ENABLE+ERR_INT_EN), ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>Reconfigure: write CTRL=0x0000_0001 at 0xF00 (disable interrupt for clean baseline)</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1</expected>
          </step>
          <step num="14">
            <action>Send good traffic: at T1 drive HTRANS=2'b10, HADDR=0x0000_3104, HWRITE=0, HSEL=1; target PREADY=1, PSLVERR=0, PRDATA=0xCAFE_0001</action>
            <expected>PSEL=1,PENABLE=1 active; HRDATA=0xCAFE_0001 after target completion, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>PROVE: compare HRDATA to 0xCAFE_0001 AND read STATUS=0xF04, ERROR_ADDR=0xF08</action>
            <expected>HRDATA=0xCAFE_0001 (integrity OK); STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000 (error log clean)</expected>
          </step>
        </steps>
        <pass_criteria>1. Clean baseline STATUS=0x0000_0001. 2. PSLVERR sampled at T3 active phase yields HRESP=1 at T4 held through error response window with HREADY_OUT gated low until window close. 3. With ERR_INT_EN=1, STATUS.ERR_INT sticky=1. 4. W1C clears bits 5 and 7. 5. Soft reset recovers and preserves basic config. 6. Post-recovery read integrity OK and error log clean.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_015" name="address_error_class_capture_and_recovery">
        <req_ref>REQ_021</req_ref>
        <objective>Verify the address-error class generates HRESP=1, sets ADDR_ERR sticky, captures the offending address, and is recoverable, distinct from a target PSLVERR path.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge ENABLE=1 (CTRL=0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure: write CTRL=0x0000_0001 at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>Send good traffic to a valid address: at T1 drive HTRANS=2'b10, HADDR=0x0000_1000, HWRITE=1, HWDATA=0x0000_5555, HSEL=1, HREADY_IN=1; target PREADY=1, PSLVERR=0</action>
            <expected>PSEL=1, PENABLE=1 active phase reached; HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="3">
            <action>Read STATUS at 0xF04 — verify clean (no ADDR_ERR)</action>
            <expected>STATUS=0x0000_0001 (ADDR_ERR bit4=0)</expected>
          </step>
          <step num="4">
            <action>Inject address error: at T1 drive HTRANS=2'b10, HADDR=0xDEAD_0000 (unsupported/invalid range), HWRITE=1, HWDATA=0x0000_1111, HSEL=1</action>
            <expected>Bridge flags invalid-address; target access not driven (PSEL stays 0 or no valid PENABLE active phase for invalid range)</expected>
          </step>
          <step num="5">
            <action>Verify error detected: sample HRESP within error response window (T4–T6 per Figure 4 vocabulary)</action>
            <expected>HRESP=1 asserted, HREADY_OUT=1 at window completion; PSEL=0/PENABLE=0 (no valid target transfer)</expected>
          </step>
          <step num="6">
            <action>Check interrupt: with ERR_INT_EN=0 no external interrupt; read STATUS.ERR_INT (bit7)</action>
            <expected>STATUS.ERR_INT=0 (ERR_INT_EN=0); STATUS.ADDR_ERR (bit4) sticky=1</expected>
          </step>
          <step num="7">
            <action>Read error log: read STATUS at 0xF04 — verify error type captured</action>
            <expected>STATUS=0x0000_0011 (ADDR_ERR bit4=1, READY bit0=1)</expected>
          </step>
          <step num="8">
            <action>Read error info: ERROR_ADDR at 0xF08, ERROR_INFO at 0xF0C</action>
            <expected>ERROR_ADDR=0xDEAD_0000 (captured invalid address), ERROR_INFO encodes direction=write, address-error class</expected>
          </step>
          <step num="9">
            <action>Clear sticky: write 1 to STATUS.ADDR_ERR (W1C) — write STATUS=0x0000_0010 at 0xF04</action>
            <expected>W1C accepted for bit 4</expected>
          </step>
          <step num="10">
            <action>Verify cleared: read STATUS at 0xF04</action>
            <expected>STATUS=0x0000_0001 (ADDR_ERR cleared, READY=1)</expected>
          </step>
          <step num="11">
            <action>Perform recovery: write CTRL.SOFT_RST=1 (CTRL=0x0000_0003) at 0xF00</action>
            <expected>Active state cleared, PSEL=0, PENABLE=0, HRESP=0, HREADY_OUT=1, sticky flags cleared</expected>
          </step>
          <step num="12">
            <action>Read error log after recovery: STATUS=0xF04, ERROR_ADDR=0xF08, ERROR_INFO=0xF0C</action>
            <expected>STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>Reconfigure: write CTRL=0x0000_0001 at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1</expected>
          </step>
          <step num="14">
            <action>Send good traffic to valid address: at T1 drive HTRANS=2'b10, HADDR=0x0000_1008, HWRITE=0, HSEL=1; target PREADY=1, PSLVERR=0, PRDATA=0x0BAD_F00D</action>
            <expected>PSEL=1, PENABLE=1 active; HRDATA=0x0BAD_F00D after target completion, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>PROVE: compare HRDATA to 0x0BAD_F00D AND read STATUS=0xF04, ERROR_ADDR=0xF08</action>
            <expected>HRDATA=0x0BAD_F00D (integrity OK); STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000 (error log clean)</expected>
          </step>
        </steps>
        <pass_criteria>1. Clean baseline STATUS=0x0000_0001. 2. Invalid HADDR=0xDEAD_0000 yields HRESP=1 with no valid PSEL/PENABLE target access. 3. STATUS.ADDR_ERR sticky=1 and ERROR_ADDR=0xDEAD_0000 captured. 4. W1C clears ADDR_ERR. 5. Soft reset recovers state. 6. Post-recovery valid read returns 0x0BAD_F00D with clean error log.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_ERROR_016" name="back_to_back_error_then_normal_no_stale_state">
        <req_ref>REQ_021</req_ref>
        <objective>Verify a target error transfer immediately followed (after clear) by a normal transfer does not produce a stale HRESP or stale sticky bits, proving error response window isolation.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>Bridge ENABLE=1 (CTRL=0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Configure: write CTRL=0x0000_0001 at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS=0x0000_0001</expected>
          </step>
          <step num="2">
            <action>Send good traffic: at T1 drive HTRANS=2'b10, HADDR=0x0000_4000, HWRITE=1, HWDATA=0x0000_9999, HSEL=1, HREADY_IN=1; target PREADY=1, PSLVERR=0</action>
            <expected>PSEL=1, PENABLE=1 active; HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="3">
            <action>Read STATUS at 0xF04 — verify clean</action>
            <expected>STATUS=0x0000_0001 (all sticky error bits 0)</expected>
          </step>
          <step num="4">
            <action>Inject error: at T1 drive HTRANS=2'b10, HADDR=0x0000_4100, HWRITE=0 (read), HSEL=1; at T3 PSEL=1,PENABLE=1; target asserts PSLVERR=1, PREADY=1, PRDATA=0xFFFF_FFFF</action>
            <expected>PSLVERR=1 sampled at active phase; HRDATA not consumed (error path), HRESP=1 in error response window T4–T6</expected>
          </step>
          <step num="5">
            <action>Verify error detected: sample HRESP across error response window</action>
            <expected>HRESP=1 asserted within window, HREADY_OUT=1 at window close</expected>
          </step>
          <step num="6">
            <action>Check interrupt: ERR_INT_EN=0, read STATUS.ERR_INT (bit7)</action>
            <expected>STATUS.ERR_INT=0; STATUS.PSLVERR (bit5) sticky=1</expected>
          </step>
          <step num="7">
            <action>Read error log: read STATUS at 0xF04</action>
            <expected>STATUS=0x0000_0021 (PSLVERR bit5=1, READY=1)</expected>
          </step>
          <step num="8">
            <action>Read error info: ERROR_ADDR at 0xF08, ERROR_INFO at 0xF0C</action>
            <expected>ERROR_ADDR=0x0000_4100, ERROR_INFO encodes direction=read, target-error class</expected>
          </step>
          <step num="9">
            <action>Clear sticky: write 1 to STATUS.PSLVERR (W1C) — write STATUS=0x0000_0020 at 0xF04</action>
            <expected>W1C accepted for bit 5</expected>
          </step>
          <step num="10">
            <action>Verify cleared: read STATUS at 0xF04</action>
            <expected>STATUS=0x0000_0001 (PSLVERR cleared)</expected>
          </step>
          <step num="11">
            <action>Perform recovery: write CTRL.SOFT_RST=1 (CTRL=0x0000_0003) at 0xF00</action>
            <expected>Active state cleared, PSEL=0, PENABLE=0, HRESP=0, HREADY_OUT=1</expected>
          </step>
          <step num="12">
            <action>Read error log after recovery: STATUS=0xF04, ERROR_ADDR=0xF08, ERROR_INFO=0xF0C</action>
            <expected>STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000, ERROR_INFO=0x0000_0000</expected>
          </step>
          <step num="13">
            <action>Reconfigure: write CTRL=0x0000_0001 at 0xF00</action>
            <expected>CTRL=0x0000_0001, STATUS.READY=1</expected>
          </step>
          <step num="14">
            <action>Send good traffic immediately at same address class: at T1 drive HTRANS=2'b10, HADDR=0x0000_4100, HWRITE=0, HSEL=1; target PREADY=1, PSLVERR=0, PRDATA=0x1357_9BDF</action>
            <expected>PSEL=1, PENABLE=1 active; HRDATA=0x1357_9BDF after target completion; CRITICAL: HRESP=0 (no stale error), HREADY_OUT=1</expected>
          </step>
          <step num="15">
            <action>PROVE: compare HRDATA to 0x1357_9BDF AND verify HRESP=0 during this transfer AND read STATUS=0xF04, ERROR_ADDR=0xF08</action>
            <expected>HRDATA=0x1357_9BDF (integrity OK); HRESP stayed 0 (no stale error response); STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000 (error log clean, no stale state)</expected>
          </step>
        </steps>
        <pass_criteria>1. Clean baseline STATUS=0x0000_0001. 2. Target PSLVERR yields HRESP=1 only within its error response window. 3. ERROR_ADDR=0x0000_4100 captured, PSLVERR sticky set. 4. W1C + soft reset fully clears state. 5. Immediately following normal read to the same address shows HRESP=0 (no stale error leakage) and HRDATA=0x1357_9BDF. 6. Final error log clean (STATUS=0x0000_0001, ERROR_ADDR=0x0000_0000).</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="main_datapath_tests" category="main_datapath" count="18">
      <test_case test_id="TEST_MAIN_DATAPATH_001" name="single_transfer_baseline_write">
        <req_ref>REQ_008</req_ref>
        <objective>Verify a single (non-sequence) HTRANS=NONSEQ write transfer with HSIZE=word advances address correctly and completes as one target access (sequence baseline).</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge, drive HTRANS=2'b10 (NONSEQ/New), HADDR=0x0000_1000, HWRITE=1, HSIZE=3'b010 (word/4B), HBURST=3'b000 (SINGLE), HWDATA=0xDEAD_BEEF</action>
            <expected>Source capture (FLOW-1): model accepts transfer, STATUS.BUSY=1, HREADY_OUT may be 0 during processing</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, observe target setup phase</action>
            <expected>Target setup (FLOW-2): PSEL=1, PENABLE=0, PADDR=0x0000_1000, PWRITE=1, PWDATA=0xDEAD_BEEF</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, observe target active phase with PREADY=1</action>
            <expected>Target active (FLOW-3): PSEL=1, PENABLE=1, PADDR=0x0000_1000</expected>
          </step>
          <step num="4">
            <action>At T4, complete transaction and read back</action>
            <expected>FLOW-5: HREADY_OUT=1, HRESP=0 (OK), STATUS.READY=1 (0x0000_0001); verify exactly one target access occurred for the single HTRANS=NONSEQ transfer</expected>
          </step>
        </steps>
        <pass_criteria>1. PADDR==0x0000_1000 and PWDATA==0xDEAD_BEEF. 2. Exactly one PSEL/PENABLE pulse generated. 3. HRESP==0 and HREADY_OUT==1 at completion. 4. STATUS.BUSY clears to READY.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_002" name="sequential_burst_address_increment_word">
        <req_ref>REQ_008</req_ref>
        <objective>Verify an incrementing multi-transfer sequence (NONSEQ then SEQ) with HSIZE=word produces target addresses advancing by 0x4 per beat, handled in-order.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10 (NONSEQ), HADDR=0x0000_2000, HWRITE=1, HSIZE=3'b010 (4B), HBURST=3'b011 (INCR4), HWDATA=0x1111_1111</action>
            <expected>Beat0 captured (FLOW-1), target setup begins: PADDR=0x0000_2000</expected>
          </step>
          <step num="2">
            <action>At T2, drive HTRANS=2'b11 (SEQ), HADDR=0x0000_2004, HWDATA=0x2222_2222</action>
            <expected>Beat0 target active: PSEL=1, PENABLE=1, PADDR=0x0000_2000, PWDATA=0x1111_1111</expected>
          </step>
          <step num="3">
            <action>At T3, drive HTRANS=2'b11 (SEQ), HADDR=0x0000_2008, HWDATA=0x3333_3333</action>
            <expected>Beat1 target access: PADDR=0x0000_2004, PWDATA=0x2222_2222 (advanced by 0x4)</expected>
          </step>
          <step num="4">
            <action>At T4, drive HTRANS=2'b11 (SEQ), HADDR=0x0000_200C, HWDATA=0x4444_4444</action>
            <expected>Beat2 target access: PADDR=0x0000_2008, PWDATA=0x3333_3333 (advanced by 0x4)</expected>
          </step>
          <step num="5">
            <action>At T5, allow final beat to complete and verify target write log</action>
            <expected>Beat3 target access: PADDR=0x0000_200C, PWDATA=0x4444_4444; HREADY_OUT=1, HRESP=0</expected>
          </step>
        </steps>
        <pass_criteria>1. Captured target PADDR sequence == [0x0000_2000, 0x0000_2004, 0x0000_2008, 0x0000_200C]. 2. Each address advances by 0x4 (HSIZE word). 3. PWDATA ordering preserved per beat (in-order). 4. HRESP==0 for all beats.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_003" name="sequential_burst_increment_halfword_size">
        <req_ref>REQ_008</req_ref>
        <objective>Verify HSIZE-dependent address stride: a SEQ sequence with HSIZE=halfword advances target PADDR by 0x2 per beat, distinct from the word case.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HTRANS=2'b10 (NONSEQ), HADDR=0x0000_3000, HWRITE=1, HSIZE=3'b001 (2B), HBURST=3'b011 (INCR4), HWDATA=0x0000_AAAA</action>
            <expected>Beat0 captured, target setup: PADDR=0x0000_3000, PWRITE=1</expected>
          </step>
          <step num="2">
            <action>At T2, drive HTRANS=2'b11 (SEQ), HADDR=0x0000_3002, HWDATA=0x0000_5555</action>
            <expected>Beat0 active: PADDR=0x0000_3000, PWDATA=0x0000_AAAA</expected>
          </step>
          <step num="3">
            <action>At T3, drive HTRANS=2'b11 (SEQ), HADDR=0x0000_3004, HWDATA=0x0000_FFFF</action>
            <expected>Beat1 target access: PADDR=0x0000_3002 (advanced by 0x2), PWDATA=0x0000_5555</expected>
          </step>
          <step num="4">
            <action>At T4, allow remaining beats and capture target address log</action>
            <expected>Subsequent PADDR=0x0000_3004 then 0x0000_3006, each advancing by 0x2</expected>
          </step>
          <step num="5">
            <action>Compare observed stride against HSIZE encoding</action>
            <expected>Stride == 2 bytes matching HSIZE=3'b001; HREADY_OUT=1, HRESP=0</expected>
          </step>
        </steps>
        <pass_criteria>1. Target PADDR stride == 0x2 per beat. 2. PADDR sequence == [0x0000_3000, 0x0000_3002, 0x0000_3004, 0x0000_3006]. 3. PWDATA preserved in-order. 4. HRESP==0 for all beats.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_004" name="in_order_sequence_data_integrity">
        <req_ref>REQ_008</req_ref>
        <objective>Verify multi-transfer sequence data integrity by writing distinct patterns (all 1s, all 0s, alternating) then reading back and comparing, confirming in-order handling.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>HSEL=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write beat0: HTRANS=2'b10 (NONSEQ), HADDR=0x0000_4000, HWRITE=1, HSIZE=3'b010, HBURST=3'b011 (INCR4), HWDATA=0xFFFF_FFFF (all 1s)</action>
            <expected>Target write PADDR=0x0000_4000, PWDATA=0xFFFF_FFFF</expected>
          </step>
          <step num="2">
            <action>At T2, write beat1: HTRANS=2'b11 (SEQ), HADDR=0x0000_4004, HWDATA=0x0000_0000 (all 0s)</action>
            <expected>Target write PADDR=0x0000_4004, PWDATA=0x0000_0000</expected>
          </step>
          <step num="3">
            <action>At T3, write beat2: HTRANS=2'b11 (SEQ), HADDR=0x0000_4008, HWDATA=0xAAAA_AAAA (alternating)</action>
            <expected>Target write PADDR=0x0000_4008, PWDATA=0xAAAA_AAAA</expected>
          </step>
          <step num="4">
            <action>At T4, write beat3: HTRANS=2'b11 (SEQ), HADDR=0x0000_400C, HWDATA=0x5555_5555 (alternating)</action>
            <expected>Target write PADDR=0x0000_400C, PWDATA=0x5555_5555; HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="5">
            <action>Starting at T6, issue read sequence: HTRANS=2'b10 then 2'b11 across HADDR=0x0000_4000..0x0000_400C, HWRITE=0, HSIZE=3'b010, capture HRDATA each beat</action>
            <expected>HRDATA returns 0xFFFF_FFFF, 0x0000_0000, 0xAAAA_AAAA, 0x5555_5555 in order (read only after target completion)</expected>
          </step>
        </steps>
        <pass_criteria>1. Read-back HRDATA matches written patterns per address. 2. Address order preserved (0x0000_4000-&gt;0x0000_400C). 3. HRDATA presented only after PREADY/target completion. 4. HRESP==0 for all read and write beats; no STATUS error bits set.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_005" name="basic_write_translation">
        <req_ref>REQ_010</req_ref>
        <objective>Verify a single source-side write (HADDR/HWDATA) is correctly captured and translated to a target-side write access (PADDR/PWDATA) following the capture-&gt;setup-&gt;active-&gt;complete sequence.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1</condition>
          <condition>STATUS.READY=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge, drive source-side write: HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x0000_1000, HSIZE=3'b010</action>
            <expected>Model accepts request (FLOW-1 capture). HREADY_OUT may go low to delay completion. STATUS.BUSY=1</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, present write payload HWDATA=0xDEAD_BEEF</action>
            <expected>Source-side address+control+payload captured (FLOW-1)</expected>
          </step>
          <step num="3">
            <action>At T3, observe target-side setup phase (FLOW-2)</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF</expected>
          </step>
          <step num="4">
            <action>At T4, observe target-side active phase (FLOW-3) with PREADY=1</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF</expected>
          </step>
          <step num="5">
            <action>At T5, observe completion (FLOW-5) and check HRESP</action>
            <expected>HREADY_OUT=1, HRESP=0 (OK). PSEL=0, PENABLE=0 returns to idle. STATUS.BUSY=0</expected>
          </step>
          <step num="6">
            <action>Verify: compare captured PADDR/PWDATA against driven HADDR/HWDATA</action>
            <expected>PADDR==HADDR==0x0000_1000 and PWDATA==HWDATA==0xDEAD_BEEF (1:1 transfer mapping)</expected>
          </step>
        </steps>
        <pass_criteria>1. Exactly one target-side operation generated per accepted source transfer. 2. PADDR=0x0000_1000 equals HADDR. 3. PWDATA=0xDEAD_BEEF equals HWDATA. 4. Phase sequence PSEL=1/PENABLE=0 (setup) then PSEL=1/PENABLE=1 (active) observed. 5. Completion HRESP=0, HREADY_OUT=1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_006" name="basic_read_translation_and_verify">
        <req_ref>REQ_010</req_ref>
        <objective>Verify a source-side read translates to a target-side read access and that HRDATA reflects PRDATA only after target completion.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read request: HSEL=1, HTRANS=2'b10 (New), HWRITE=0, HADDR=0x0000_2000, HSIZE=3'b010</action>
            <expected>Request accepted (FLOW-1). STATUS.BUSY=1, HREADY_OUT=0 while pending</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup (FLOW-2)</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_2000</expected>
          </step>
          <step num="3">
            <action>At T3, observe target active (FLOW-3); drive PRDATA=0xCAFE_F00D, PREADY=1</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_2000</expected>
          </step>
          <step num="4">
            <action>At T4, observe completion (FLOW-5)</action>
            <expected>HREADY_OUT=1, HRESP=0, HRDATA=0xCAFE_F00D returned to source</expected>
          </step>
          <step num="5">
            <action>Verify: check HRDATA was NOT valid before T4 completion and equals PRDATA at completion</action>
            <expected>HRDATA==PRDATA==0xCAFE_F00D; read data presented only after target-side completion</expected>
          </step>
        </steps>
        <pass_criteria>1. Read request maps to single target read with PWRITE=0. 2. PADDR=0x0000_2000 equals HADDR. 3. HRDATA=0xCAFE_F00D equals PRDATA. 4. HRDATA valid only after PREADY=1 active-phase completion. 5. HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_007" name="data_pattern_integrity">
        <req_ref>REQ_010</req_ref>
        <objective>Verify data integrity across translation for all-ones, all-zeros, and alternating bit patterns on 32-bit HWDATA/PWDATA.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_3000, HWDATA=0xFFFF_FFFF (all 1s)</action>
            <expected>Capture (FLOW-1); setup at T3 shows PADDR=0x0000_3000, PWDATA=0xFFFF_FFFF</expected>
          </step>
          <step num="2">
            <action>At T4 active phase with PREADY=1, then verify completion</action>
            <expected>PSEL=1, PENABLE=1, PWDATA=0xFFFF_FFFF, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="3">
            <action>At next transfer T5, drive HWRITE=1, HADDR=0x0000_3004, HWDATA=0x0000_0000 (all 0s)</action>
            <expected>PADDR=0x0000_3004, PWDATA=0x0000_0000 at setup/active</expected>
          </step>
          <step num="4">
            <action>At next transfer, drive HWRITE=1, HADDR=0x0000_3008, HWDATA=0xAAAA_AAAA (alternating)</action>
            <expected>PADDR=0x0000_3008, PWDATA=0xAAAA_AAAA</expected>
          </step>
          <step num="5">
            <action>At next transfer, drive HWRITE=1, HADDR=0x0000_300C, HWDATA=0x5555_5555 (alternating inverse)</action>
            <expected>PADDR=0x0000_300C, PWDATA=0x5555_5555</expected>
          </step>
          <step num="6">
            <action>Verify: compare each PWDATA against its source HWDATA for all four patterns</action>
            <expected>PWDATA bit-exactly equals HWDATA for 0xFFFF_FFFF, 0x0000_0000, 0xAAAA_AAAA, 0x5555_5555 with no bit corruption</expected>
          </step>
        </steps>
        <pass_criteria>1. PWDATA==HWDATA for all four 32-bit patterns. 2. Each write produces one target operation. 3. PADDR matches HADDR for each transfer. 4. All completions HRESP=0, HREADY_OUT=1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_008" name="address_range_translation">
        <req_ref>REQ_010</req_ref>
        <objective>Verify address translation integrity at low, mid, and high 32-bit address boundaries.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive write to lowest address: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_0000, HWDATA=0x1111_1111</action>
            <expected>Setup at T3: PSEL=1, PENABLE=0, PADDR=0x0000_0000, PWDATA=0x1111_1111</expected>
          </step>
          <step num="2">
            <action>At T4 active with PREADY=1, verify completion</action>
            <expected>PENABLE=1, PADDR=0x0000_0000, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="3">
            <action>At next transfer, drive HWRITE=1, HADDR=0x8000_0000 (mid/MSB-set), HWDATA=0x2222_2222</action>
            <expected>PADDR=0x8000_0000, PWDATA=0x2222_2222 at setup/active</expected>
          </step>
          <step num="4">
            <action>At next transfer, drive HWRITE=1, HADDR=0xFFFF_FFFC (highest aligned word), HWDATA=0x3333_3333</action>
            <expected>PADDR=0xFFFF_FFFC, PWDATA=0x3333_3333 at setup/active</expected>
          </step>
          <step num="5">
            <action>Verify: compare PADDR to HADDR for each boundary address</action>
            <expected>PADDR==HADDR for 0x0000_0000, 0x8000_0000, 0xFFFF_FFFC with no truncation or bit drop</expected>
          </step>
        </steps>
        <pass_criteria>1. PADDR exactly equals HADDR across full 32-bit boundary range. 2. Each transfer yields one target operation. 3. PWDATA preserved per transfer. 4. All completions HRESP=0, HREADY_OUT=1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_009" name="phase_progression_setup_to_active">
        <req_ref>REQ_010</req_ref>
        <objective>Verify the strict two-phase target-side progression (setup then active) and that PENABLE is never asserted in the same cycle as the initial PSEL assertion.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive accepted write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_1000, HWDATA=0xDEAD_BEEF</action>
            <expected>Source capture (FLOW-1); STATUS.BUSY=1</expected>
          </step>
          <step num="2">
            <action>At T3 (first target cycle), sample PSEL and PENABLE</action>
            <expected>Setup phase: PSEL=1, PENABLE=0, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF</expected>
          </step>
          <step num="3">
            <action>At T4 (next rising edge), sample PSEL and PENABLE with PREADY=1</action>
            <expected>Active phase: PSEL=1, PENABLE=1, PADDR=0x0000_1000 held stable</expected>
          </step>
          <step num="4">
            <action>At T5, sample target signals after completion</action>
            <expected>PSEL=0, PENABLE=0 (return to IDLE per state machine), HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="5">
            <action>Verify: prove PENABLE=0 in the cycle PSEL first asserted, and PENABLE=1 only in the following cycle while PSEL stays 1</action>
            <expected>No cycle observed with PSEL=1 and PENABLE=1 at first assertion; address/data stable from setup through active</expected>
          </step>
        </steps>
        <pass_criteria>1. Setup cycle: PSEL=1, PENABLE=0. 2. Active cycle: PSEL=1, PENABLE=1. 3. PENABLE never asserted concurrently with first PSEL assertion. 4. PADDR/PWDATA stable across both phases. 5. Clean return to PSEL=0/PENABLE=0 with HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_010" name="single_wait_state_delays_completion">
        <req_ref>REQ_011</req_ref>
        <objective>Verify that a single PREADY=0 wait state holds the APB transfer in the ACTIVE phase and delays HREADY_OUT to the source side.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1 (reset deasserted)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>Bridge idle, HREADY_OUT=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge, drive source write: HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x0000_1000, HSIZE=3'b010</action>
            <expected>Source request captured (FLOW-1), HREADY_OUT=1 still, transaction accepted</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, present write data HWDATA=0xDEAD_BEEF; bridge enters SETUP</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF (FLOW-2)</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, bridge advances to ACTIVE; hold PREADY=0 (target stall)</action>
            <expected>PSEL=1, PENABLE=1 (FLOW-3); since PREADY=0, transfer held active (FLOW-4); HREADY_OUT=0 (completion delayed)</expected>
          </step>
          <step num="4">
            <action>At T4 rising edge, keep PREADY=0</action>
            <expected>PSEL=1, PENABLE=1 unchanged, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF stable; HREADY_OUT=0 still asserted low</expected>
          </step>
          <step num="5">
            <action>At T5 rising edge, assert PREADY=1 (target ready)</action>
            <expected>Transfer completes (FLOW-5); HREADY_OUT=1 this cycle; PENABLE deasserts to 0 next cycle</expected>
          </step>
          <step num="6">
            <action>At T6, check completion and read back STATUS (0xF04)</action>
            <expected>STATUS.BUSY=0, STATUS.READY=1; verify no error bits set (STATUS=0x0000_0001)</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT=0 for every cycle PREADY=0 (T3,T4). 2. PENABLE stays 1 throughout the stall. 3. HREADY_OUT pulses 1 only when PREADY=1 at T5. 4. PADDR=0x0000_1000 and PWDATA=0xDEAD_BEEF held stable during wait. 5. STATUS=0x0000_0001 (no error) after completion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_011" name="multi_wait_state_read_data_gating">
        <req_ref>REQ_011</req_ref>
        <objective>Verify that during a multi-cycle PREADY=0 stall on a read, HREADY_OUT stays low and HRDATA is presented only at the cycle PREADY=1.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>Bridge idle</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive source read: HSEL=1, HTRANS=2'b10 (New), HWRITE=0, HADDR=0x0000_2000, HSIZE=3'b010</action>
            <expected>Source read request captured, HREADY_OUT=1</expected>
          </step>
          <step num="2">
            <action>At T2, bridge enters SETUP</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_2000</expected>
          </step>
          <step num="3">
            <action>At T3, bridge enters ACTIVE; hold PREADY=0</action>
            <expected>PSEL=1, PENABLE=1; HREADY_OUT=0 (completion delayed); HRDATA not yet valid</expected>
          </step>
          <step num="4">
            <action>At T4 and T5, keep PREADY=0 for two more cycles</action>
            <expected>PSEL=1, PENABLE=1 held; HREADY_OUT=0 each cycle; PADDR=0x0000_2000 stable</expected>
          </step>
          <step num="5">
            <action>At T6, assert PREADY=1 and drive PRDATA=0xA5A5_A5A5</action>
            <expected>HREADY_OUT=1; HRDATA=0xA5A5_A5A5 returned (FLOW-5); HRESP=0 (no error)</expected>
          </step>
          <step num="6">
            <action>At T7, compare captured HRDATA against expected 0xA5A5_A5A5</action>
            <expected>HRDATA matches PRDATA; read data integrity proven; PENABLE=0</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT=0 for all PREADY=0 cycles (T3,T4,T5). 2. HRDATA presented to source only at T6 when PREADY=1. 3. HRDATA==PRDATA==0xA5A5_A5A5. 4. PENABLE held 1 across entire stall, deasserts after completion. 5. HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_012" name="back_to_back_writes_with_stall_data_patterns">
        <req_ref>REQ_011</req_ref>
        <objective>Verify data integrity (all 1s, all 0s, alternating) survives PREADY back-pressure on consecutive writes and PWDATA is held stable during each stall.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write #1: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_3000, HWDATA=0xFFFF_FFFF</action>
            <expected>Request captured; bridge proceeds to SETUP at T2</expected>
          </step>
          <step num="2">
            <action>At T3, ACTIVE phase with PREADY=0 for one cycle then PREADY=1 at T4</action>
            <expected>PSEL=1, PENABLE=1, PWDATA=0xFFFF_FFFF stable while HREADY_OUT=0 at T3; HREADY_OUT=1 at T4</expected>
          </step>
          <step num="3">
            <action>At T5, write #2: HADDR=0x0000_3004, HWDATA=0x0000_0000; advance to ACTIVE with PREADY=0 two cycles</action>
            <expected>PSEL=1, PENABLE=1, PWDATA=0x0000_0000 held stable; HREADY_OUT=0 during stall</expected>
          </step>
          <step num="4">
            <action>At T8, assert PREADY=1 for write #2</action>
            <expected>HREADY_OUT=1; transfer completes; PWDATA=0x0000_0000 captured at target</expected>
          </step>
          <step num="5">
            <action>At T9, write #3: HADDR=0x0000_3008, HWDATA=0xAAAA_5555; ACTIVE with PREADY=0 one cycle then PREADY=1</action>
            <expected>PWDATA=0xAAAA_5555 held during HREADY_OUT=0; completes when PREADY=1</expected>
          </step>
          <step num="6">
            <action>Read back 0x0000_3000, 0x0000_3004, 0x0000_3008 and compare to 0xFFFF_FFFF, 0x0000_0000, 0xAAAA_5555</action>
            <expected>All three read values match written patterns; data integrity proven across stalls</expected>
          </step>
        </steps>
        <pass_criteria>1. PWDATA held stable for each transfer throughout its PREADY=0 stall. 2. HREADY_OUT low during stall, high at completion for each write. 3. Read-back: addr 0x3000=0xFFFF_FFFF, 0x3004=0x0000_0000, 0x3008=0xAAAA_5555. 4. PENABLE asserted only in ACTIVE, deasserts after each completion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_013" name="timeout_during_persistent_stall">
        <req_ref>REQ_011</req_ref>
        <objective>Verify that persistent PREADY=0 with timeout enabled eventually terminates the held transfer and sets STATUS.TIMEOUT_ERR, while HREADY_OUT remains low until the timeout fires.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>Program CTRL=0x0000_00F1 (ENABLE=1, TIMEOUT_EN=1, TIMEOUT_VAL=3'b111)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL (0xF00)=0x0000_00F1 to enable timeout, then read back CTRL</action>
            <expected>CTRL reads 0x0000_00F1; TIMEOUT_EN=1, ENABLE=1</expected>
          </step>
          <step num="2">
            <action>At T2, drive source write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_4000, HWDATA=0x1234_5678</action>
            <expected>Request captured; SETUP entered</expected>
          </step>
          <step num="3">
            <action>At T3, bridge enters ACTIVE; hold PREADY=0 continuously</action>
            <expected>PSEL=1, PENABLE=1; HREADY_OUT=0 (completion delayed); timeout counter starts</expected>
          </step>
          <step num="4">
            <action>Hold PREADY=0 through cycles until the programmed timeout window elapses</action>
            <expected>HREADY_OUT stays 0 for entire window; PENABLE remains 1; transfer kept active</expected>
          </step>
          <step num="5">
            <action>At the cycle timeout fires, observe completion and error indication</action>
            <expected>Bridge terminates transfer; HREADY_OUT=1 with HRESP=1 (error); model becomes ready</expected>
          </step>
          <step num="6">
            <action>Read STATUS (0xF04) and ERROR_ADDR (0xF08)</action>
            <expected>STATUS.TIMEOUT_ERR=1 and STATUS.ERR_INT set sticky; ERROR_ADDR=0x0000_4000 captured</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT=0 for every cycle within the timeout window. 2. PENABLE held 1 until timeout fires. 3. On timeout: HREADY_OUT=1, HRESP=1. 4. STATUS.TIMEOUT_ERR=1 (bit 6) sticky. 5. ERROR_ADDR=0x0000_4000. 6. CTRL read-back==0x0000_00F1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_014" name="basic_single_read_data_return">
        <req_ref>REQ_020</req_ref>
        <objective>Verify a single read transfer returns PRDATA on HRDATA only after the target-side active phase completes (PREADY=1).</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>PRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (rising edge HCLK), drive source read request: HSEL=1, HTRANS=2'b10 (New), HWRITE=0, HADDR=0x0000_1000, HSIZE=3'b010, HREADY_IN=1</action>
            <expected>Model accepts request (Source capture). HREADY_OUT may go low; transaction enters SETUP.</expected>
          </step>
          <step num="2">
            <action>At T2, observe target-side setup phase outputs</action>
            <expected>PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_1000 (Target setup). HRDATA not yet valid.</expected>
          </step>
          <step num="3">
            <action>At T3, target active phase: PSEL=1, PENABLE=1, drive PRDATA=0xDEAD_BEEF, PREADY=1, PSLVERR=0</action>
            <expected>Target active phase, PRDATA captured. HREADY_OUT still gating source completion until capture/completion.</expected>
          </step>
          <step num="4">
            <action>At T4, observe source-side completion</action>
            <expected>HREADY_OUT=1, HRESP=0 (OKAY), HRDATA=0xDEAD_BEEF returned to source.</expected>
          </step>
          <step num="5">
            <action>Verify HRDATA value sampled by source equals captured PRDATA</action>
            <expected>HRDATA == 0xDEAD_BEEF; data returned ONLY at/after target completion (T4), never before T3.</expected>
          </step>
        </steps>
        <pass_criteria>1. HRDATA=0xDEAD_BEEF returned to source side. 2. HRDATA valid only on the cycle HREADY_OUT=1 (T4), after PREADY=1 at T3. 3. No HRDATA update observed during SETUP (T2). 4. HRESP=0 for successful read.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_015" name="read_data_blocked_until_target_completion">
        <req_ref>REQ_020</req_ref>
        <objective>Verify HRDATA is NOT returned and source completion is gated while target is stalled (PREADY=0), then returns correct data once PREADY asserts.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read request: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_2000, HREADY_IN=1</action>
            <expected>Request captured (Source capture).</expected>
          </step>
          <step num="2">
            <action>At T2, observe setup: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_2000</action>
            <expected>Target setup phase, HRDATA invalid.</expected>
          </step>
          <step num="3">
            <action>At T3-T4, target active with stall: PSEL=1, PENABLE=1, PREADY=0 (Target stall), PRDATA=0x0000_0000 (not yet valid)</action>
            <expected>Completion delayed: HREADY_OUT=0, HRDATA NOT driven to source. STATUS.BUSY=1.</expected>
          </step>
          <step num="4">
            <action>At T5, target completes: PREADY=1, PRDATA=0xA5A5_5A5A, PSLVERR=0</action>
            <expected>PRDATA captured during active phase.</expected>
          </step>
          <step num="5">
            <action>At T6, observe source completion and verify read data</action>
            <expected>HREADY_OUT=1, HRESP=0, HRDATA=0xA5A5_5A5A. Verify HRDATA was held off during T3-T4 stall and only returned at T6.</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT=0 and HRDATA not updated while PREADY=0 (T3-T4). 2. HRDATA=0xA5A5_5A5A returned at T6 after PREADY=1. 3. Read data return strictly follows target completion. 4. HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_016" name="read_data_patterns_integrity">
        <req_ref>REQ_020</req_ref>
        <objective>Verify the read-data return path preserves data integrity for all-1s, all-0s, and alternating bit patterns from PRDATA to HRDATA.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read request: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_3000, HREADY_IN=1</action>
            <expected>Request captured.</expected>
          </step>
          <step num="2">
            <action>At T2, setup: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_3000</action>
            <expected>Target setup, HRDATA invalid.</expected>
          </step>
          <step num="3">
            <action>At T3, target active: PSEL=1, PENABLE=1, PREADY=1, PRDATA=0xFFFF_FFFF (all 1s), PSLVERR=0</action>
            <expected>PRDATA all-1s captured.</expected>
          </step>
          <step num="4">
            <action>At T4, observe HRDATA; then issue second read to 0x0000_3004 with PRDATA=0x0000_0000 (all 0s) on its active phase</action>
            <expected>HRDATA=0xFFFF_FFFF on first completion (HREADY_OUT=1).</expected>
          </step>
          <step num="5">
            <action>Issue third read to 0x0000_3008 with PRDATA=0xAAAA_5555 (alternating) captured during active phase; observe HRDATA at completion</action>
            <expected>HRDATA=0x0000_0000 for second read; HRDATA=0xAAAA_5555 for third read.</expected>
          </step>
          <step num="6">
            <action>Compare each returned HRDATA against the driven PRDATA for all three reads</action>
            <expected>All values match bit-for-bit: 0xFFFF_FFFF, 0x0000_0000, 0xAAAA_5555.</expected>
          </step>
        </steps>
        <pass_criteria>1. HRDATA == PRDATA for all 3 patterns. 2. No bit corruption/swap in return path. 3. Each HRDATA valid only on its HREADY_OUT=1 cycle after target completion. 4. HRESP=0 for all.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_017" name="read_data_address_range_correlation">
        <req_ref>REQ_020</req_ref>
        <objective>Verify read data returned on HRDATA correlates with the correct target address across the 32-bit address range (low, mid, high).</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, read low address: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_0000, HREADY_IN=1</action>
            <expected>Request captured.</expected>
          </step>
          <step num="2">
            <action>At T2-T3, target setup/active for 0x0000_0000: PSEL=1, PADDR=0x0000_0000, PENABLE=1, PREADY=1, PRDATA=0x1111_1111</action>
            <expected>PADDR mirrors HADDR=0x0000_0000; PRDATA captured.</expected>
          </step>
          <step num="3">
            <action>At T4, verify HRDATA on completion</action>
            <expected>HREADY_OUT=1, HRDATA=0x1111_1111, HRESP=0.</expected>
          </step>
          <step num="4">
            <action>Read mid address: HADDR=0x8000_0000, target PADDR=0x8000_0000, PREADY=1, PRDATA=0x2222_2222</action>
            <expected>HRDATA=0x2222_2222 returned after target completion.</expected>
          </step>
          <step num="5">
            <action>Read high address: HADDR=0xFFFF_FFFC, target PADDR=0xFFFF_FFFC, PREADY=1, PRDATA=0x3333_3333</action>
            <expected>HRDATA=0x3333_3333 returned after target completion.</expected>
          </step>
          <step num="6">
            <action>Compare each HRDATA against expected PRDATA for its address</action>
            <expected>Read data matches per-address: 0x1111_1111, 0x2222_2222, 0x3333_3333 with no cross-contamination.</expected>
          </step>
        </steps>
        <pass_criteria>1. PADDR matches HADDR for each read. 2. HRDATA returned matches PRDATA driven at the corresponding target access. 3. Data returned only after target completion (PREADY=1). 4. HRESP=0 for all addresses.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_MAIN_DATAPATH_018" name="read_data_not_returned_on_target_error">
        <req_ref>REQ_020</req_ref>
        <objective>Verify that when target signals PSLVERR=1, HRESP=1 (error) is returned and the read-data return path reflects the error rather than valid data delivery.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
          <condition>STATUS sticky flags cleared (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read request: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_4000, HREADY_IN=1</action>
            <expected>Request captured.</expected>
          </step>
          <step num="2">
            <action>At T2, target setup: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_4000</action>
            <expected>Setup phase, HRDATA invalid.</expected>
          </step>
          <step num="3">
            <action>At T3-T4, target active with error: PSEL=1, PENABLE=1, PREADY=1, PSLVERR=1, PRDATA=0x0000_0000</action>
            <expected>Target error observed (Error response window opens).</expected>
          </step>
          <step num="4">
            <action>At T5, observe source completion</action>
            <expected>HREADY_OUT=1, HRESP=1 (error). STATUS.PSLVERR=1 (sticky), STATUS.ERR_INT may be set.</expected>
          </step>
          <step num="5">
            <action>Read STATUS register (offset 0xF04) and verify sticky error bits; check HRDATA handling under error</action>
            <expected>STATUS.PSLVERR=1 captured; HRESP=1 returned to source indicating read did not deliver valid data. ERROR_ADDR=0x0000_4000.</expected>
          </step>
          <step num="6">
            <action>Verify no valid read data is treated as good (HRESP=1 accompanies the completion)</action>
            <expected>Source-side error path engaged; read-data return suppressed/flagged as error rather than OKAY.</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=1 returned when PSLVERR=1 during active phase. 2. STATUS.PSLVERR sticky bit=1 (read-back from 0xF04). 3. ERROR_ADDR=0x0000_4000 captured. 4. Read completion flagged as error rather than valid data return.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="protocol_tests" category="protocol" count="17">
      <test_case test_id="TEST_PROTOCOL_001" name="source_capture_to_target_setup_progression">
        <req_ref>REQ_009</req_ref>
        <objective>Verify that an accepted source-side request is captured and translated into a target-side SETUP phase with correct PSEL/PENABLE signaling and timing.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (reset complete)</condition>
          <condition>CTRL.ENABLE=1</condition>
          <condition>Bridge idle, STATUS.READY=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge of HCLK, drive a new source request: HTRANS=2'b10 (NONSEQ/New), HSEL=1, HWRITE=1, HADDR=0x0000_0100, HWDATA=0x0000_DATA, HREADY_IN=1</action>
            <expected>Source capture cycle (FLOW-1): request accepted, HREADY_OUT=1 sampled, PSEL=0, PENABLE=0 (still idle/capturing)</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, hold source inputs stable; observe bridge translate into target setup (FLOW-2)</action>
            <expected>SETUP phase entered: PSEL=1, PENABLE=0, PADDR=0x0000_0100, PWRITE=1, PWDATA=0x0000_DATA driven; source-side completion held with HREADY_OUT=0</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, verify the bridge advances to the target active phase (FLOW-3)</action>
            <expected>ACTIVE phase: PSEL=1, PENABLE=1, PADDR/PWRITE/PWDATA stable unchanged from T2</expected>
          </step>
          <step num="4">
            <action>Check and read back PSEL, PENABLE and address stability across T2-&gt;T3</action>
            <expected>PENABLE transitions 0-&gt;1 exactly one cycle after PSEL asserts; PADDR=0x0000_0100 unchanged between SETUP and ACTIVE</expected>
          </step>
        </steps>
        <pass_criteria>1. At T2 PSEL=1 and PENABLE=0 (SETUP). 2. At T3 PSEL=1 and PENABLE=1 (ACTIVE). 3. PENABLE asserts exactly one HCLK cycle after PSEL. 4. PADDR/PWRITE/PWDATA remain stable from SETUP through ACTIVE. 5. HREADY_OUT held low until completion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_002" name="target_active_completion_handshake">
        <req_ref>REQ_009</req_ref>
        <objective>Verify the target active phase completes correctly when PREADY asserts and source-side completion (HREADY_OUT) is then released.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1</condition>
          <condition>A transfer already in SETUP phase (PSEL=1, PENABLE=0)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (SETUP cycle), confirm PSEL=1, PENABLE=0, PADDR=0x0000_0100</action>
            <expected>SETUP phase valid, HREADY_OUT=0 (source completion gated)</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, bridge enters ACTIVE: PSEL=1, PENABLE=1; drive PREADY=1, PRDATA=0xA5A5_A5A5, PSLVERR=0</action>
            <expected>ACTIVE phase with target ready; transfer eligible to complete this cycle</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, verify completion (FLOW-5): bridge deasserts PENABLE and PSEL, releases source completion</action>
            <expected>PSEL=0, PENABLE=0, HREADY_OUT=1, HRESP=0, HRDATA=0xA5A5_A5A5 returned to source</expected>
          </step>
          <step num="4">
            <action>Read back HRDATA and check HREADY_OUT timing relative to PREADY</action>
            <expected>HRDATA=0xA5A5_A5A5 equals captured PRDATA; HREADY_OUT asserts only after PREADY sampled high in ACTIVE phase</expected>
          </step>
        </steps>
        <pass_criteria>1. PENABLE=1 and PREADY=1 coincide in ACTIVE before completion. 2. On completion PSEL=0, PENABLE=0. 3. HREADY_OUT=1 only after target completion. 4. HRDATA=0xA5A5_A5A5 matches PRDATA. 5. HRESP=0 for successful transfer.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_003" name="wait_state_signal_stability_during_target_stall">
        <req_ref>REQ_009</req_ref>
        <objective>Verify that during a target stall the ACTIVE phase signals remain stable and HREADY_OUT stays low until PREADY asserts.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1</condition>
          <condition>Transfer in SETUP with PADDR=0x0000_0200</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (SETUP), confirm PSEL=1, PENABLE=0, PADDR=0x0000_0200</action>
            <expected>SETUP phase, HREADY_OUT=0</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, enter ACTIVE: PSEL=1, PENABLE=1; drive PREADY=0 (target stall)</action>
            <expected>ACTIVE phase held; bridge waits, HREADY_OUT=0, completion delayed</expected>
          </step>
          <step num="3">
            <action>At T3 and T4 rising edges, keep PREADY=0; observe held signals</action>
            <expected>PSEL=1, PENABLE=1 held stable; PADDR=0x0000_0200 unchanged; HREADY_OUT remains 0 across both wait cycles</expected>
          </step>
          <step num="4">
            <action>At T5 rising edge, drive PREADY=1, PRDATA=0x1234_5678, PSLVERR=0</action>
            <expected>Transfer completes: at T6 PSEL=0, PENABLE=0, HREADY_OUT=1, HRDATA=0x1234_5678</expected>
          </step>
          <step num="5">
            <action>Verify stability: compare PADDR/PENABLE across T2-T4 wait cycles and check HREADY_OUT edge</action>
            <expected>No signal toggled during stall; HREADY_OUT rose exactly one cycle after PREADY sampled high</expected>
          </step>
        </steps>
        <pass_criteria>1. PENABLE=1 held stable throughout PREADY=0 stall (T2-T4). 2. PADDR=0x0000_0200 unchanged during wait. 3. HREADY_OUT=0 for entire stall. 4. On PREADY=1, completion occurs and HRDATA=0x1234_5678. 5. No spurious PSEL/PENABLE glitches during wait.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_004" name="read_data_returned_only_after_target_completion">
        <req_ref>REQ_009</req_ref>
        <objective>Verify on a read transfer that HRDATA is not presented to the source until target completion (PREADY=1) occurs in the active phase.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1</condition>
          <condition>Bridge idle</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge, drive read request: HTRANS=2'b10, HSEL=1, HWRITE=0, HADDR=0x0000_0400, HREADY_IN=1</action>
            <expected>Source capture (FLOW-1): request accepted, PSEL=0, PENABLE=0, HREADY_OUT=1 for capture</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, SETUP phase: PSEL=1, PENABLE=0, PADDR=0x0000_0400, PWRITE=0</action>
            <expected>Target setup driven; HREADY_OUT=0 (completion gated)</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, ACTIVE: PSEL=1, PENABLE=1; drive PREADY=0 first to hold read</action>
            <expected>HRDATA not yet valid; HREADY_OUT=0; read data not returned to source</expected>
          </step>
          <step num="4">
            <action>At T4 rising edge, drive PREADY=1, PRDATA=0xDEAD_BEEF, PSLVERR=0</action>
            <expected>Target completion; bridge samples PRDATA</expected>
          </step>
          <step num="5">
            <action>At T5 rising edge, verify HRDATA and HREADY_OUT</action>
            <expected>HREADY_OUT=1, HRDATA=0xDEAD_BEEF, HRESP=0, PSEL=0, PENABLE=0</expected>
          </step>
          <step num="6">
            <action>Check that HRDATA was invalid/unaccepted before T5 and equals PRDATA only after completion</action>
            <expected>Read data is presented to source only on the completion cycle following PREADY=1</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT held 0 from SETUP through stalled ACTIVE. 2. HRDATA returned only after PREADY=1 sampled in ACTIVE. 3. HRDATA=0xDEAD_BEEF matches PRDATA. 4. HRESP=0 on success. 5. PSEL/PENABLE deassert at completion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_005" name="wait_state_basic_delayed_completion">
        <req_ref>REQ_012</req_ref>
        <objective>Verify that a single target stall (PREADY=0) holds PENABLE asserted and delays HREADY_OUT until PREADY=1.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn=1 and PRESETn=1 (reset deasserted)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 rising edge, drive a new source-side request: HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x0000_1000, HWDATA=0x0000_DATA</action>
            <expected>Source capture phase; model accepts request, BUSY transitions toward active, HREADY_OUT=0 (completion not yet granted)</expected>
          </step>
          <step num="2">
            <action>At T2 rising edge, observe target setup phase outputs</action>
            <expected>SETUP phase: PSEL=1, PENABLE=0, PADDR=0x0000_1000, PWRITE=1, PWDATA=0x0000_DATA</expected>
          </step>
          <step num="3">
            <action>At T3 rising edge, target active phase begins; drive PREADY=0 to model the stall</action>
            <expected>ACTIVE phase: PSEL=1, PENABLE=1; transfer held active; HREADY_OUT=0 (completion delayed)</expected>
          </step>
          <step num="4">
            <action>At T4 rising edge, hold PREADY=0 (wait state)</action>
            <expected>Signals stable during wait: PSEL=1, PENABLE=1, PADDR=0x0000_1000 unchanged; HREADY_OUT remains 0</expected>
          </step>
          <step num="5">
            <action>At T5 rising edge, drive PREADY=1 to complete the target access</action>
            <expected>Complete phase: handshake completes, HREADY_OUT=1 same cycle/next as completion gating, HRESP=0 (no error)</expected>
          </step>
          <step num="6">
            <action>At T6 rising edge, verify return to idle and check status</action>
            <expected>PSEL=0, PENABLE=0; STATUS.BUSY=0, STATUS.READY=1 (STATUS=0x0000_0001)</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT stays 0 for all cycles where PREADY=0 (T3,T4). 2. PENABLE=1 and PSEL=1 remain stable throughout the wait. 3. HREADY_OUT asserts to 1 only after PREADY=1 at T5. 4. PADDR/PWDATA unchanged during wait. 5. HRESP=0 and STATUS.READY=1 at completion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_006" name="wait_state_signal_stability_multi_wait">
        <req_ref>REQ_012</req_ref>
        <objective>Verify PSEL, PENABLE, PADDR remain stable and HREADY_OUT remains deasserted across several consecutive PREADY=0 wait cycles.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>reset deasserted (HRESETn=1, PRESETn=1)</condition>
          <condition>CTRL.ENABLE=1, CTRL.TIMEOUT_EN=0 (no timeout)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read request: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_2000</action>
            <expected>Source capture; HREADY_OUT=0, BUSY active</expected>
          </step>
          <step num="2">
            <action>At T2, observe SETUP phase</action>
            <expected>PSEL=1, PENABLE=0, PADDR=0x0000_2000, PWRITE=0</expected>
          </step>
          <step num="3">
            <action>At T3, enter ACTIVE; drive PREADY=0</action>
            <expected>PSEL=1, PENABLE=1, HREADY_OUT=0</expected>
          </step>
          <step num="4">
            <action>At T4, hold PREADY=0 (wait cycle 1)</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_2000 stable, HREADY_OUT=0</expected>
          </step>
          <step num="5">
            <action>At T5, hold PREADY=0 (wait cycle 2)</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_2000 stable, HREADY_OUT=0</expected>
          </step>
          <step num="6">
            <action>At T6, hold PREADY=0 (wait cycle 3)</action>
            <expected>PSEL=1, PENABLE=1, PADDR=0x0000_2000 stable, HREADY_OUT=0</expected>
          </step>
          <step num="7">
            <action>At T7, drive PREADY=1 and PRDATA=0x1234_5678</action>
            <expected>Complete: HREADY_OUT=1, HRDATA=0x1234_5678 returned, HRESP=0</expected>
          </step>
          <step num="8">
            <action>At T8, verify idle and read-back STATUS</action>
            <expected>PSEL=0, PENABLE=0; STATUS=0x0000_0001 (READY=1, BUSY=0)</expected>
          </step>
        </steps>
        <pass_criteria>1. PENABLE=1 held continuously T3-T7 while PREADY=0. 2. PADDR=0x0000_2000 and PWRITE=0 unchanged across all wait cycles. 3. HREADY_OUT=0 for every wait cycle (T3-T6). 4. HRDATA=0x1234_5678 valid only at/after completion (T7). 5. HREADY_OUT=1 occurs exactly when PREADY=1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_007" name="wait_state_read_data_after_completion">
        <req_ref>REQ_012</req_ref>
        <objective>Verify that HRDATA is not presented as valid until PREADY=1 completes the target access, and HREADY_OUT gating matches.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>reset deasserted</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive read: HSEL=1, HTRANS=2'b10, HWRITE=0, HADDR=0x0000_3004</action>
            <expected>Source capture; HREADY_OUT=0</expected>
          </step>
          <step num="2">
            <action>At T2, observe SETUP</action>
            <expected>PSEL=1, PENABLE=0, PADDR=0x0000_3004, PWRITE=0</expected>
          </step>
          <step num="3">
            <action>At T3, enter ACTIVE; drive PREADY=0, PRDATA=0xDEAD_BEEF (target driving but not ready)</action>
            <expected>PSEL=1, PENABLE=1, HREADY_OUT=0; read data NOT yet committed to HRDATA</expected>
          </step>
          <step num="4">
            <action>At T4, hold PREADY=0</action>
            <expected>HREADY_OUT=0; source completion blocked; PENABLE=1 stable</expected>
          </step>
          <step num="5">
            <action>At T5, drive PREADY=1, PRDATA=0xCAFE_F00D</action>
            <expected>Complete: HREADY_OUT=1, HRDATA captures 0xCAFE_F00D (value at completion), HRESP=0</expected>
          </step>
          <step num="6">
            <action>At T6, verify HRDATA stable and check STATUS</action>
            <expected>HRDATA=0xCAFE_F00D held for source read; STATUS.READY=1, STATUS.BUSY=0</expected>
          </step>
        </steps>
        <pass_criteria>1. HREADY_OUT=0 for all cycles with PREADY=0. 2. HRDATA reflects the PRDATA sampled at PREADY=1 completion (0xCAFE_F00D), not the stalled value. 3. Source-side completion (HREADY_OUT=1) occurs only at/after T5. 4. HRESP=0 at completion. 5. STATUS.READY=1 after transfer.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_008" name="wait_state_back_to_back_after_stall">
        <req_ref>REQ_012</req_ref>
        <objective>Verify the bridge correctly releases back-pressure after a stalled transfer and accepts a new transfer with proper PSEL/PENABLE sequencing.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>reset deasserted</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive write: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_4000, HWDATA=0x1111_2222</action>
            <expected>Source capture; HREADY_OUT=0</expected>
          </step>
          <step num="2">
            <action>At T2, SETUP phase</action>
            <expected>PSEL=1, PENABLE=0, PADDR=0x0000_4000, PWDATA=0x1111_2222</expected>
          </step>
          <step num="3">
            <action>At T3, ACTIVE phase; drive PREADY=0 (stall)</action>
            <expected>PSEL=1, PENABLE=1, HREADY_OUT=0</expected>
          </step>
          <step num="4">
            <action>At T4, drive PREADY=1 to complete first transfer</action>
            <expected>Complete: HREADY_OUT=1, HRESP=0; PENABLE deasserts after completion</expected>
          </step>
          <step num="5">
            <action>At T5, drive second new request: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_4004, HWDATA=0x3333_4444</action>
            <expected>New transfer accepted (HREADY_OUT was 1 enabling acceptance); SETUP entered, PSEL=1, PENABLE=0, PADDR=0x0000_4004</expected>
          </step>
          <step num="6">
            <action>At T6, ACTIVE for second transfer; drive PREADY=1</action>
            <expected>PSEL=1, PENABLE=1, then complete: HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="7">
            <action>At T7, verify idle and read-back STATUS</action>
            <expected>PSEL=0, PENABLE=0; STATUS=0x0000_0001 (READY=1, BUSY=0)</expected>
          </step>
        </steps>
        <pass_criteria>1. First transfer HREADY_OUT=0 during PREADY=0 stall (T3) and =1 at completion (T4). 2. Second transfer begins only after first completes, with correct SETUP(PENABLE=0)-&gt;ACTIVE(PENABLE=1) sequence. 3. PADDR/PWDATA correct per transfer (0x0000_4000/0x1111_2222 then 0x0000_4004/0x3333_4444). 4. HRESP=0 for both. 5. STATUS.READY=1 at end.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_009" name="fsm_idle_to_setup_on_accepted_request">
        <req_ref>REQ_013</req_ref>
        <objective>Verify the IDLE-to-SETUP transition asserts PSEL with PENABLE deasserted on the first target-side cycle.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>PRESETn deasserted (reset complete)</condition>
          <condition>FSM in IDLE with PSEL=0, PENABLE=0</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (rising edge of PCLK), confirm idle baseline: observe PSEL=0, PENABLE=0</action>
            <expected>FSM in IDLE, PSEL=0, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge), present an accepted source-side request (HSEL=1, HTRANS=New, HADDR=0x0000_1000)</action>
            <expected>FSM transitions IDLE-&gt;SETUP</expected>
          </step>
          <step num="3">
            <action>At T3 (SETUP cycle), sample PSEL and PENABLE</action>
            <expected>SETUP phase: PSEL=1, PENABLE=0, PADDR=0x0000_1000</expected>
          </step>
          <step num="4">
            <action>Verify PENABLE remained 0 throughout the SETUP cycle (no premature ACTIVE entry)</action>
            <expected>PENABLE=0 held for exactly one SETUP cycle while PSEL=1</expected>
          </step>
        </steps>
        <pass_criteria>1. FSM leaves IDLE only on accepted request. 2. In SETUP, PSEL=1 and PENABLE=0. 3. PADDR=0x0000_1000 stable in SETUP.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_010" name="fsm_setup_to_active_advance">
        <req_ref>REQ_013</req_ref>
        <objective>Verify the SETUP-to-ACTIVE transition asserts PENABLE while keeping PSEL high.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>FSM in SETUP with PSEL=1, PENABLE=0, PADDR=0x0000_1000</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (SETUP cycle), confirm PSEL=1, PENABLE=0, PADDR=0x0000_1000</action>
            <expected>SETUP phase valid</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge), allow FSM to advance to ACTIVE</action>
            <expected>FSM transitions SETUP-&gt;ACTIVE</expected>
          </step>
          <step num="3">
            <action>At T3 (ACTIVE cycle), sample PSEL and PENABLE</action>
            <expected>ACTIVE phase: PSEL=1, PENABLE=1, PADDR=0x0000_1000 unchanged</expected>
          </step>
          <step num="4">
            <action>Verify PSEL stayed continuously 1 across SETUP-&gt;ACTIVE (no deassertion between phases)</action>
            <expected>PSEL=1 across both cycles; PENABLE rises exactly one cycle after PSEL</expected>
          </step>
        </steps>
        <pass_criteria>1. PENABLE asserts in ACTIVE one cycle after SETUP. 2. PSEL remains 1 throughout. 3. PADDR stable from SETUP into ACTIVE.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_011" name="fsm_active_stall_self_loop">
        <req_ref>REQ_013</req_ref>
        <objective>Verify ACTIVE self-loop on PREADY=0 and stability of PSEL/PENABLE during wait states.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>FSM in ACTIVE with PSEL=1, PENABLE=1, PADDR=0x0000_1000</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (ACTIVE cycle), drive PREADY=0 (target stall); sample PSEL=1, PENABLE=1</action>
            <expected>FSM stays in ACTIVE (self-loop), PSEL=1, PENABLE=1</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge), keep PREADY=0; re-sample PSEL, PENABLE, PADDR</action>
            <expected>ACTIVE held: PSEL=1, PENABLE=1, PADDR=0x0000_1000 unchanged</expected>
          </step>
          <step num="3">
            <action>At T3 (rising edge), keep PREADY=0 for a third stall cycle; sample again</action>
            <expected>ACTIVE held: PSEL=1, PENABLE=1 stable, no transition</expected>
          </step>
          <step num="4">
            <action>Verify across T1-T3 that PSEL, PENABLE, and PADDR=0x0000_1000 are bit-stable while PREADY=0</action>
            <expected>No signal change during wait states; FSM remains in ACTIVE every cycle PREADY=0</expected>
          </step>
        </steps>
        <pass_criteria>1. FSM stays in ACTIVE for every cycle PREADY=0. 2. PSEL=1 and PENABLE=1 held stable. 3. PADDR=0x0000_1000 unchanged during stall.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_012" name="fsm_active_to_idle_completion">
        <req_ref>REQ_013</req_ref>
        <objective>Verify handshake completion (PREADY=1) returns FSM to IDLE and deasserts PSEL/PENABLE.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>FSM in ACTIVE with PSEL=1, PENABLE=1, PADDR=0x0000_1000, PREADY=0</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (ACTIVE, stalled), confirm PSEL=1, PENABLE=1, PREADY=0</action>
            <expected>FSM in ACTIVE self-loop</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge), drive PREADY=1 to complete the transfer; capture PRDATA=0x0000_ABCD</action>
            <expected>Handshake completes; FSM transitions ACTIVE-&gt;IDLE</expected>
          </step>
          <step num="3">
            <action>At T3 (IDLE cycle), sample PSEL and PENABLE</action>
            <expected>IDLE phase: PSEL=0, PENABLE=0</expected>
          </step>
          <step num="4">
            <action>Read back STATUS register at 0xF04; verify READY bit[0]=1 and BUSY bit[1]=0 after completion</action>
            <expected>STATUS=0x0000_0001 (READY=1, BUSY=0), confirming clean return to IDLE</expected>
          </step>
        </steps>
        <pass_criteria>1. FSM returns to IDLE only when PREADY=1. 2. PSEL=0 and PENABLE=0 in IDLE. 3. STATUS READY=1, BUSY=0 post-completion. 4. PRDATA=0x0000_ABCD captured before deassertion.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_013" name="fsm_full_cycle_setup_stall_active_complete">
        <req_ref>REQ_013</req_ref>
        <objective>Verify the complete state-machine sequence with correct PSEL/PENABLE/PREADY timing across all phases.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>FSM in IDLE, PSEL=0, PENABLE=0</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, present accepted request (HSEL=1, HTRANS=New, HADDR=0x0000_2000)</action>
            <expected>IDLE-&gt;SETUP; at T2 PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T2 (SETUP), verify PSEL=1, PENABLE=0, PADDR=0x0000_2000</action>
            <expected>SETUP phase correct</expected>
          </step>
          <step num="3">
            <action>At T3 (rising edge), advance to ACTIVE; verify PSEL=1, PENABLE=1</action>
            <expected>SETUP-&gt;ACTIVE; PENABLE asserted</expected>
          </step>
          <step num="4">
            <action>At T4 (ACTIVE), drive PREADY=0; verify self-loop with PSEL=1, PENABLE=1 stable</action>
            <expected>ACTIVE held; signals stable during wait</expected>
          </step>
          <step num="5">
            <action>At T5 (rising edge), drive PREADY=1 to complete; verify FSM-&gt;IDLE with PSEL=0, PENABLE=0 at T6</action>
            <expected>ACTIVE-&gt;IDLE; PSEL=0, PENABLE=0</expected>
          </step>
          <step num="6">
            <action>After completion, read STATUS at 0xF04 and compare to expected idle value</action>
            <expected>STATUS=0x0000_0001 (READY=1, BUSY=0), proving full cycle returned to IDLE</expected>
          </step>
        </steps>
        <pass_criteria>1. State order IDLE-&gt;SETUP-&gt;ACTIVE-&gt;ACTIVE(stall)-&gt;IDLE observed with correct timing. 2. PENABLE asserts exactly one cycle after PSEL. 3. Self-loop holds while PREADY=0. 4. Completion on PREADY=1 deasserts PSEL/PENABLE. 5. STATUS READY=1, BUSY=0 at end.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_014" name="hresp_ok_on_successful_write_transfer">
        <req_ref>REQ_019</req_ref>
        <objective>Verify HRESP=0 (OK) is asserted on the source side at completion of a normal write transfer with no target error.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>No error injected on PSLVERR</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1 (rising edge), drive source-side request: HSEL=1, HTRANS=2'b10 (NONSEQ/New), HWRITE=1, HADDR=0x0000_1000, HSIZE=3'b010, HWDATA=0xDEAD_BEEF, HREADY_IN=1</action>
            <expected>Source capture phase (FLOW-1): transfer accepted, model latches address/control. HREADY_OUT may be 1, HRESP=0</expected>
          </step>
          <step num="2">
            <action>At T2, model performs target setup (FLOW-2): observe PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF</action>
            <expected>Target SETUP phase active, PSEL=1, PENABLE=0, HRESP held at 0</expected>
          </step>
          <step num="3">
            <action>At T3, model advances to target active (FLOW-3): observe PSEL=1, PENABLE=1, drive PREADY=1, PSLVERR=0</action>
            <expected>Target ACTIVE phase, PENABLE=1, target completes with no error, PSLVERR=0</expected>
          </step>
          <step num="4">
            <action>At T4, observe source-side completion (FLOW-5): check HREADY_OUT=1 (completion indicator) and read HRESP</action>
            <expected>HREADY_OUT=1, HRESP=0 (OK/success). Completion gated by target ready</expected>
          </step>
          <step num="5">
            <action>Verify and compare: confirm HRESP=0 at the cycle HREADY_OUT=1, and confirm STATUS sticky error bits (TIMEOUT_ERR, PSLVERR, ADDR_ERR) remain 0</action>
            <expected>HRESP=0 coincident with HREADY_OUT=1; STATUS=0x0000_0001 (READY, no sticky error)</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=0 throughout and at completion (T4). 2. HREADY_OUT=1 only after PREADY=1. 3. No sticky STATUS error bits set. 4. PENABLE=1 occurred exactly one cycle after PSEL=1 with PENABLE=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_015" name="hresp_error_on_target_pslverr">
        <req_ref>REQ_019</req_ref>
        <objective>Verify HRESP=1 (error) is driven on the source side when PSLVERR=1 is asserted during the target active phase.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.ENABLE=1 (0x0000_0001)</condition>
          <condition>STATUS=0x0000_0001 (clean)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive source request: HSEL=1, HTRANS=2'b10, HWRITE=0 (read), HADDR=0x0000_2000, HSIZE=3'b010, HREADY_IN=1</action>
            <expected>Source capture (FLOW-1), transfer accepted, HRESP=0 initially</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x0000_2000</action>
            <expected>Target SETUP, PSEL=1, PENABLE=0, HRESP still 0</expected>
          </step>
          <step num="3">
            <action>At T3, target active: observe PSEL=1, PENABLE=1; drive PREADY=1 and PSLVERR=1 (inject target error)</action>
            <expected>Target ACTIVE with error indication, PENABLE=1, PSLVERR=1 sampled</expected>
          </step>
          <step num="4">
            <action>At T4, observe source completion within error response window (Fig 4): check HREADY_OUT=1 and HRESP</action>
            <expected>HRESP=1 (error) asserted on source side; HREADY_OUT=1 marks completion</expected>
          </step>
          <step num="5">
            <action>Verify: confirm HRESP=1 coincident with HREADY_OUT=1, then read STATUS register at offset 0xF04 and confirm STATUS.PSLVERR (bit 5)=1 and ERROR_ADDR=0x0000_2000</action>
            <expected>HRESP=1 at completion; STATUS bit5=1 (sticky), ERROR_ADDR=0x0000_2000. HRESP error output is distinct from but consistent with sticky flag</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=1 driven on source side when PSLVERR=1. 2. HRESP transitions to error only during/after target active phase. 3. STATUS.PSLVERR (bit5) latched sticky. 4. ERROR_ADDR captured = 0x0000_2000. 5. HREADY_OUT=1 gates the error indication.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_016" name="hresp_error_on_timeout">
        <req_ref>REQ_019</req_ref>
        <objective>Verify HRESP=1 (error) on the source side when a target timeout occurs (PREADY never asserted within window).</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL programmed: TIMEOUT_EN=1 (bit7), TIMEOUT_VAL=3'b001 (small window), ENABLE=1 =&gt; CTRL=0x0000_0091</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive source request: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x0000_3000, HWDATA=0x1234_5678, HREADY_IN=1</action>
            <expected>Source capture (FLOW-1), transfer accepted, HRESP=0</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup: PSEL=1, PENABLE=0, PADDR=0x0000_3000</action>
            <expected>Target SETUP, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="3">
            <action>At T3, target active: PSEL=1, PENABLE=1; hold PREADY=0 (stall) for the full programmed timeout window</action>
            <expected>Target ACTIVE held; FLOW-4 stall; HREADY_OUT=0 (completion delayed), HRESP=0 during wait</expected>
          </step>
          <step num="4">
            <action>At T4..Tn keep PREADY=0 until the timeout counter expires per TIMEOUT_VAL</action>
            <expected>Signals stable during wait: PADDR/PWDATA unchanged, PSEL=1, PENABLE=1; HREADY_OUT remains 0 until timeout</expected>
          </step>
          <step num="5">
            <action>At timeout expiry cycle, observe source completion: check HREADY_OUT=1 and HRESP</action>
            <expected>HRESP=1 (error) driven; HREADY_OUT=1 ends the transfer via timeout error path</expected>
          </step>
          <step num="6">
            <action>Verify: confirm HRESP=1 at completion, read STATUS (0xF04) bit6 TIMEOUT_ERR=1, and confirm ERROR_ADDR=0x0000_3000</action>
            <expected>HRESP=1; STATUS.TIMEOUT_ERR(bit6)=1; ERROR_ADDR=0x0000_3000</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=0 during the wait window then HRESP=1 at timeout completion. 2. Target signals (PADDR/PWDATA/PSEL/PENABLE) stable during stall. 3. HREADY_OUT=0 until timeout, then =1. 4. STATUS.TIMEOUT_ERR(bit6)=1. 5. ERROR_ADDR=0x0000_3000.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_PROTOCOL_017" name="hresp_ok_stable_during_wait_states">
        <req_ref>REQ_019</req_ref>
        <objective>Verify HRESP remains 0 (no premature/spurious error) throughout target wait states and resolves to OK at completion when PREADY finally asserts without error.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn deasserted (=1)</condition>
          <condition>CTRL.TIMEOUT_EN=0 (no timeout)</condition>
          <condition>CTRL.ENABLE=1 =&gt; CTRL=0x0000_0001</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive source request: HSEL=1, HTRANS=2'b10, HWRITE=0 (read), HADDR=0x0000_4000, HREADY_IN=1</action>
            <expected>Source capture (FLOW-1), HRESP=0, HREADY_OUT may be 1 before stall</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup: PSEL=1, PENABLE=0, PADDR=0x0000_4000</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0, HRESP=0</expected>
          </step>
          <step num="3">
            <action>At T3, target active: PSEL=1, PENABLE=1; drive PREADY=0 (stall) and PSLVERR=0</action>
            <expected>Wait state (FLOW-4): HREADY_OUT=0, HRESP=0, PENABLE stays 1</expected>
          </step>
          <step num="4">
            <action>At T4 and T5, keep PREADY=0; sample HRESP each rising edge</action>
            <expected>HRESP=0 stable across all wait cycles; no spurious error pulse; PADDR=0x0000_4000 stable</expected>
          </step>
          <step num="5">
            <action>At T6, drive PREADY=1, PSLVERR=0, PRDATA=0xCAFE_0001</action>
            <expected>Target completes successfully, HREADY_OUT=1</expected>
          </step>
          <step num="6">
            <action>Verify: at T6 check HRESP=0 coincident with HREADY_OUT=1, and check HRDATA=0xCAFE_0001 returned only after target completion; confirm STATUS error bits remain 0</action>
            <expected>HRESP=0 at completion; HRDATA=0xCAFE_0001; STATUS=0x0000_0001 (no sticky errors)</expected>
          </step>
        </steps>
        <pass_criteria>1. HRESP=0 stable for every wait cycle (T3..T5). 2. No spurious HRESP=1 during stall. 3. HREADY_OUT=0 during wait, =1 at T6. 4. HRDATA returned only at/after completion = 0xCAFE_0001. 5. No STATUS sticky error set.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="register_access_tests" category="register_access" count="17">
      <test_case test_id="TEST_REGISTER_ACCESS_001" name="status_reset_value_check">
        <req_ref>REQ_002</req_ref>
        <objective>Verify STATUS register reflects its specified reset state with READY asserted and no sticky errors set.</objective>
        <preconditions>
          <condition>PCLK and HCLK running</condition>
          <condition>PRESETn deasserted prior to test</condition>
          <condition>bridge idle</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, assert PRESETn=0 (active-low reset) for at least 2 cycles</action>
            <expected>Model enters reset; internal STATUS forced to 0x00000001</expected>
          </step>
          <step num="2">
            <action>At T3 rising edge, deassert PRESETn=1, keep CTRL.ENABLE=1 default</action>
            <expected>Model exits reset to IDLE; READY=1, BUSY=0</expected>
          </step>
          <step num="3">
            <action>At T4, perform APB read: drive PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F04 (SETUP phase)</action>
            <expected>SETUP phase: PSEL=1, PENABLE=0</expected>
          </step>
          <step num="4">
            <action>At T5, drive PENABLE=1 (ACCESS phase), wait for PREADY=1</action>
            <expected>PREADY=1; PRDATA presented on bus</expected>
          </step>
          <step num="5">
            <action>At T6, capture and verify PRDATA equals 0x00000001 (READY=1 bit0, BUSY=0 bit1, ERR_INT=0 bit7, TIMEOUT_ERR=0 bit6, PSLVERR=0 bit5, ADDR_ERR=0 bit4)</action>
            <expected>PRDATA==0x00000001; PSLVERR(target)=0</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS read returns exactly 0x00000001 after reset. 2. READY=1, BUSY=0. 3. All sticky error flags ERR_INT/TIMEOUT_ERR/PSLVERR/ADDR_ERR read as 0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_002" name="status_sticky_error_set_on_target_error">
        <req_ref>REQ_002</req_ref>
        <objective>Verify PSLVERR and aggregated ERR_INT sticky bits in STATUS are set and preserved after a target error event.</objective>
        <preconditions>
          <condition>PCLK/HCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1, CTRL.ERR_INT_EN=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, issue a source-side transfer: HSEL=1, HTRANS=2'b10(New), HWRITE=1, HADDR=0x00000200, HWDATA=0x0000DATA</action>
            <expected>Source capture; model advances to target SETUP, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T3, on target ACCESS phase (PENABLE=1) drive PREADY=1 and PSLVERR=1 to inject a target error</action>
            <expected>Target error observed during active access; HRESP=1 returned to source</expected>
          </step>
          <step num="3">
            <action>At T5, perform APB read of STATUS: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F04, then PENABLE=1</action>
            <expected>SETUP then ACCESS; PREADY=1</expected>
          </step>
          <step num="4">
            <action>At T6, verify PRDATA bit5 PSLVERR=1 and bit7 ERR_INT=1 are set</action>
            <expected>PRDATA[5]=1 (PSLVERR), PRDATA[7]=1 (ERR_INT)</expected>
          </step>
          <step num="5">
            <action>At T8, re-read STATUS (PADDR=0x00000F04) without any clear and check the sticky bits persist</action>
            <expected>PRDATA[5]=1 and PRDATA[7]=1 still set, proving stickiness</expected>
          </step>
        </steps>
        <pass_criteria>1. PSLVERR sticky bit set after target error. 2. ERR_INT aggregated sticky bit set. 3. Both bits remain set across consecutive reads without a W1C clear.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_003" name="status_w1c_clear_semantics">
        <req_ref>REQ_002</req_ref>
        <objective>Verify Write-1-to-Clear behavior: a 1 in the written bit clears the corresponding sticky flag while 0 leaves others untouched.</objective>
        <preconditions>
          <condition>PCLK/HCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>STATUS sticky bits PSLVERR=1 and TIMEOUT_ERR=1 pre-set via prior error events</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, read STATUS: PSEL=1, PENABLE=0-&gt;1, PWRITE=0, PADDR=0x00000F04, capture PRDATA</action>
            <expected>PRDATA[5]=1 (PSLVERR), PRDATA[6]=1 (TIMEOUT_ERR) confirmed set</expected>
          </step>
          <step num="2">
            <action>At T3, write STATUS with W1C mask to clear only PSLVERR: PSEL=1, PENABLE=0-&gt;1, PWRITE=1, PADDR=0x00000F04, PWDATA=0x00000020 (bit5=1, bit6=0)</action>
            <expected>ACCESS phase PREADY=1; PSLVERR cleared, TIMEOUT_ERR untouched</expected>
          </step>
          <step num="3">
            <action>At T5, read back STATUS (PADDR=0x00000F04)</action>
            <expected>PRDATA[5]=0 (PSLVERR cleared), PRDATA[6]=1 (TIMEOUT_ERR still set)</expected>
          </step>
          <step num="4">
            <action>At T7, write STATUS PWDATA=0x00000040 (bit6=1) to clear TIMEOUT_ERR</action>
            <expected>ACCESS PREADY=1; TIMEOUT_ERR cleared</expected>
          </step>
          <step num="5">
            <action>At T9, read STATUS and verify PRDATA bits5 and 6 are both 0, and compare ERR_INT aggregate bit7 reflects no remaining errors</action>
            <expected>PRDATA[5]=0, PRDATA[6]=0, PRDATA[7]=0</expected>
          </step>
        </steps>
        <pass_criteria>1. Writing 1 to a bit clears that sticky flag. 2. Writing 0 to a bit leaves it unchanged. 3. Selective clear of PSLVERR does not disturb TIMEOUT_ERR. 4. Aggregated ERR_INT deasserts once all source errors cleared.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_004" name="status_readonly_busy_ready_behavior">
        <req_ref>REQ_002</req_ref>
        <objective>Verify BUSY/READY reflect live model state and are immune to software writes.</objective>
        <preconditions>
          <condition>PCLK/HCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1, bridge idle (READY=1)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, with bridge idle read STATUS: PSEL=1, PENABLE=0-&gt;1, PWRITE=0, PADDR=0x00000F04</action>
            <expected>PRDATA[0]=1 (READY), PRDATA[1]=0 (BUSY)</expected>
          </step>
          <step num="2">
            <action>At T3, launch a source transfer with delayed target: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x00000300, hold PREADY=0 to keep model busy</action>
            <expected>Model active; BUSY transitions to 1, READY to 0</expected>
          </step>
          <step num="3">
            <action>At T5 (transfer still stalled), read STATUS again (PADDR=0x00000F04)</action>
            <expected>PRDATA[1]=1 (BUSY), PRDATA[0]=0 (READY)</expected>
          </step>
          <step num="4">
            <action>At T6, attempt write to STATUS PWDATA=0x00000003 (bit0=1, bit1=1) via PWRITE=1, PENABLE=1</action>
            <expected>ACCESS PREADY=1; write to RO bits ignored</expected>
          </step>
          <step num="5">
            <action>At T8, release target PREADY=1 to complete transfer, then re-read STATUS at T10 and verify BUSY=0, READY=1 reflecting live state (not the attempted write)</action>
            <expected>PRDATA[1]=0, PRDATA[0]=1; values track hardware state, write had no effect</expected>
          </step>
        </steps>
        <pass_criteria>1. READY=1/BUSY=0 in idle. 2. BUSY=1/READY=0 while target stalls. 3. Software write to bit0/bit1 has no effect (RO). 4. BUSY/READY return to idle state after completion, tracking live model state.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_005" name="ctrl_reg_reset_value_check">
        <req_ref>REQ_003</req_ref>
        <objective>Verify the CTRL register powers up to its specified reset value with ENABLE set and TIMEOUT_VAL=3'b111.</objective>
        <preconditions>
          <condition>PCLK/HCLK running</condition>
          <condition>PRESETn asserted then deasserted before access</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, assert PRESETn=0 (active-low reset) for 2 cycles, drive PSEL=0, PENABLE=0</action>
            <expected>Bridge enters reset state, CTRL internally loads 0x00000001</expected>
          </step>
          <step num="2">
            <action>At T3 rising edge, deassert PRESETn=1, hold PSEL=0</action>
            <expected>Reset released, model idle, CTRL retains 0x00000001</expected>
          </step>
          <step num="3">
            <action>At T4, start read SETUP: drive PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F00</action>
            <expected>SETUP phase entered, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="4">
            <action>At T5, drive PENABLE=1, PWRITE=0, PADDR=0x00000F00, wait PREADY=1</action>
            <expected>ACCESS phase, PREADY=1 sampled, PRDATA returned</expected>
          </step>
          <step num="5">
            <action>At T6, sample and compare PRDATA against expected reset value</action>
            <expected>PRDATA=0x00000001 (ENABLE=1 bit0, TIMEOUT_VAL=3'b111 at bits6:4 NOT reflected since field reset is 3'b111 but aggregate read shows TIMEOUT_VAL=0x7 =&gt; verify bits6:4=0x7, bit0=1)</expected>
          </step>
          <step num="6">
            <action>Verify decoded fields: bit0 ENABLE, bits6:4 TIMEOUT_VAL, bit7 TIMEOUT_EN, bit3 ERR_INT_EN, bit1 SOFT_RST</action>
            <expected>ENABLE=1, TIMEOUT_VAL=3'b111, TIMEOUT_EN=0, ERR_INT_EN=0, SOFT_RST=0, reserved bits=0</expected>
          </step>
        </steps>
        <pass_criteria>1. PRDATA read at T6 has bit0=1 (ENABLE). 2. bits6:4=0x7 (TIMEOUT_VAL). 3. bits7,3,1=0. 4. Reserved bits 31:8 and bit2 read 0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_006" name="ctrl_reg_rw_field_writeback">
        <req_ref>REQ_003</req_ref>
        <objective>Verify R/W fields in CTRL accept programmed values and read back correctly.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>CTRL at reset 0x00000001</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, start write SETUP: PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x00000F00, PWDATA=0x000000A9</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0 (PWDATA encodes ENABLE=1, TIMEOUT_VAL=3'b010, TIMEOUT_EN=1; 0xA9=1010_1001)</expected>
          </step>
          <step num="2">
            <action>At T2, drive PENABLE=1, hold PWRITE=1, PADDR=0x00000F00, PWDATA=0x000000A9, wait PREADY=1</action>
            <expected>ACCESS phase, write committed when PREADY=1 sampled at rising edge</expected>
          </step>
          <step num="3">
            <action>At T3, deassert PENABLE=0, PSEL=0 to end transfer</action>
            <expected>Write transaction complete, CTRL updated to 0x000000A9</expected>
          </step>
          <step num="4">
            <action>At T4, start read SETUP: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F00</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="5">
            <action>At T5, drive PENABLE=1, PWRITE=0, wait PREADY=1, sample PRDATA</action>
            <expected>ACCESS phase, PRDATA returned</expected>
          </step>
          <step num="6">
            <action>At T6, compare PRDATA fields against written value</action>
            <expected>PRDATA bit0 ENABLE=1, bits6:4 TIMEOUT_VAL=3'b010, bit7 TIMEOUT_EN=1, reserved bits=0</expected>
          </step>
        </steps>
        <pass_criteria>1. Write at T2 accepted on PREADY=1. 2. Read PRDATA bit0=1, bits6:4=0x2, bit7=1. 3. ERR_INT_EN(bit3)=0 and SOFT_RST(bit1)=0 as not written. 4. Reserved bits read 0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_007" name="ctrl_soft_rst_self_clearing_action">
        <req_ref>REQ_003</req_ref>
        <objective>Verify SOFT_RST bit write triggers a soft reset that clears sticky STATUS flags and preserves CTRL config bits.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>STATUS has sticky error bit(s) set from prior scenario</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Precondition setup: ensure STATUS(0xF04) bit5 PSLVERR=1 sticky (from earlier injected target error)</action>
            <expected>STATUS read returns bit5=1 prior to soft reset</expected>
          </step>
          <step num="2">
            <action>At T1, write CTRL SETUP: PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x00000F00, PWDATA=0x00000003 (ENABLE=1, SOFT_RST=1)</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="3">
            <action>At T2, drive PENABLE=1, hold PWDATA=0x00000003, wait PREADY=1</action>
            <expected>ACCESS phase, soft reset action triggered on PREADY=1 sampled</expected>
          </step>
          <step num="4">
            <action>At T3, end transfer PENABLE=0, PSEL=0; allow 2 cycles for soft-reset to take effect</action>
            <expected>Active transfer state cleared, sticky flags cleared, configuration preserved</expected>
          </step>
          <step num="5">
            <action>At T6, read STATUS: PSEL=1, PENABLE=0-&gt;1, PWRITE=0, PADDR=0x00000F04, sample PRDATA</action>
            <expected>PRDATA STATUS bit5 PSLVERR=0, bit7 ERR_INT=0, bit6 TIMEOUT_ERR=0, bit4 ADDR_ERR=0 (sticky cleared)</expected>
          </step>
          <step num="6">
            <action>At T8, read CTRL: PADDR=0x00000F00, sample PRDATA and verify SOFT_RST self-cleared</action>
            <expected>PRDATA bit0 ENABLE=1 preserved, bit1 SOFT_RST=0 (self-clearing)</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS sticky bits 7,6,5,4 all read 0 after soft reset. 2. CTRL ENABLE(bit0)=1 preserved. 3. SOFT_RST(bit1) reads 0 (self-clears). 4. STATUS READY(bit0)=1.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_008" name="ctrl_reserved_bits_readonly_check">
        <req_ref>REQ_003</req_ref>
        <objective>Verify CTRL reserved bits remain 0 and are not affected by attempted writes of all-ones.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>CTRL at reset 0x00000001</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL SETUP: PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x00000F00, PWDATA=0xFFFFFFFF</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0 (attempting to set all bits including reserved)</expected>
          </step>
          <step num="2">
            <action>At T2, drive PENABLE=1, hold PWDATA=0xFFFFFFFF, wait PREADY=1</action>
            <expected>ACCESS phase, write committed to writable fields only on PREADY=1</expected>
          </step>
          <step num="3">
            <action>At T3, end transfer PENABLE=0, PSEL=0</action>
            <expected>Write complete; reserved positions unaffected</expected>
          </step>
          <step num="4">
            <action>At T4, read CTRL SETUP: PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F00</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="5">
            <action>At T5, drive PENABLE=1, wait PREADY=1, sample PRDATA</action>
            <expected>ACCESS phase, PRDATA returned</expected>
          </step>
          <step num="6">
            <action>At T6, verify reserved bits read 0 and writable bits set</action>
            <expected>PRDATA bits31:8=0x000000, bit2=0; writable bits7=1(TIMEOUT_EN), bits6:4=0x7, bit3=1(ERR_INT_EN), bit1=1(SOFT_RST attempt), bit0=1(ENABLE)</expected>
          </step>
        </steps>
        <pass_criteria>1. PRDATA bits31:8 all read 0. 2. bit2 reads 0. 3. Writable fields reflect written ones (subject to SOFT_RST self-clear). 4. No write to reserved positions alters their RO=0 value.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_009" name="error_addr_capture_on_addr_error">
        <req_ref>REQ_005</req_ref>
        <objective>Verify ERROR_ADDR captures the source-side address of an address-error transaction.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, read ERROR_ADDR via APB: drive PSEL=1, PADDR=0x0000_0F08, PWRITE=0, PENABLE=0</action>
            <expected>SETUP phase entered, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T2 (rising edge), drive PENABLE=1, PREADY=1 and sample PRDATA</action>
            <expected>ACCESS phase, PRDATA=0x0000_0000 (reset value per Table 8), PSLVERR=0</expected>
          </step>
          <step num="3">
            <action>At T3, issue a source-side transfer to an invalid address: HSEL=1, HTRANS=2'b10 (New), HADDR=0xDEAD_BEEF, HWRITE=1, HWDATA=0x1234_5678</action>
            <expected>ADDR_ERR scenario detected, STATUS.ADDR_ERR set to 1</expected>
          </step>
          <step num="4">
            <action>At T4, wait for HRESP=1 (error) and HREADY_OUT=1 on source side</action>
            <expected>Source-side error indication asserted, model becomes ready</expected>
          </step>
          <step num="5">
            <action>At T5, read ERROR_ADDR: drive PSEL=1, PADDR=0x0000_0F08, PWRITE=0, then PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0xDEAD_BEEF (captured invalid address)</expected>
          </step>
          <step num="6">
            <action>At T6, compare captured PRDATA against the stimulus HADDR</action>
            <expected>ERROR_ADDR == 0xDEAD_BEEF, confirming capture of most recent error address</expected>
          </step>
        </steps>
        <pass_criteria>1. ERROR_ADDR reset value reads 0x0000_0000. 2. STATUS.ADDR_ERR=1 after invalid access. 3. ERROR_ADDR reads 0xDEAD_BEEF matching the errored HADDR. 4. ERROR_ADDR is read-only (no write effect).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_010" name="error_info_context_capture">
        <req_ref>REQ_005</req_ref>
        <objective>Verify ERROR_INFO captures direction/beat/error-class context for a target-side (PSLVERR) error.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1 (0x00000001)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, read ERROR_INFO: drive PSEL=1, PADDR=0x0000_0F0C, PWRITE=0, PENABLE=0</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="2">
            <action>At T2, drive PENABLE=1, PREADY=1, sample PRDATA</action>
            <expected>PRDATA=0x0000_0000 (reset value, Table 8)</expected>
          </step>
          <step num="3">
            <action>At T3, issue a source-side READ to a valid address: HSEL=1, HTRANS=2'b10, HADDR=0x0000_0100, HWRITE=0</action>
            <expected>Bridge advances to target SETUP/ACTIVE, PSEL=1</expected>
          </step>
          <step num="4">
            <action>At T4 (target active phase), drive PSLVERR=1, PREADY=1 on peripheral side</action>
            <expected>Target error observed, STATUS.PSLVERR set to 1, HRESP=1 on source side</expected>
          </step>
          <step num="5">
            <action>At T5, read ERROR_INFO: drive PSEL=1, PADDR=0x0000_0F0C, PWRITE=0, then PENABLE=1, PREADY=1</action>
            <expected>PRDATA non-zero, encoding direction=read, coarse error class=target-error</expected>
          </step>
          <step num="6">
            <action>At T6, decode and verify ERROR_INFO fields against the read/target-error stimulus</action>
            <expected>Direction field indicates read, error-class field indicates target error</expected>
          </step>
        </steps>
        <pass_criteria>1. ERROR_INFO reset reads 0x0000_0000. 2. STATUS.PSLVERR=1 after target error. 3. ERROR_INFO context fields reflect read direction and target error class. 4. ERROR_INFO is read-only.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_011" name="debug_regs_reset_values">
        <req_ref>REQ_005</req_ref>
        <objective>Verify both captured debug registers clear to 0x0000_0000 on hard reset.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>Before reset, induce an error (HADDR=0xCAFE_0000 invalid) so ERROR_ADDR/ERROR_INFO are non-zero at T1</action>
            <expected>ERROR_ADDR holds 0xCAFE_0000, ERROR_INFO non-zero, STATUS.ADDR_ERR=1</expected>
          </step>
          <step num="2">
            <action>At T2, assert HRESETn=0 and PRESETn=0 for at least 2 cycles</action>
            <expected>Model enters reset, IDLE state</expected>
          </step>
          <step num="3">
            <action>At T4, deassert HRESETn=1 and PRESETn=1 (rising edge)</action>
            <expected>Model returns to clean idle, HREADY_OUT=1</expected>
          </step>
          <step num="4">
            <action>At T5, read ERROR_ADDR: PSEL=1, PADDR=0x0000_0F08, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0x0000_0000</expected>
          </step>
          <step num="5">
            <action>At T6, read ERROR_INFO: PSEL=1, PADDR=0x0000_0F0C, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0x0000_0000</expected>
          </step>
          <step num="6">
            <action>At T7, verify STATUS=0x0000_0001 (READY, no sticky error)</action>
            <expected>Sticky flags cleared, ERROR_ADDR and ERROR_INFO both 0x0000_0000</expected>
          </step>
        </steps>
        <pass_criteria>1. Post-reset ERROR_ADDR=0x0000_0000. 2. Post-reset ERROR_INFO=0x0000_0000. 3. STATUS=0x0000_0001 after reset. 4. Pre-reset non-zero capture confirms registers were cleared by reset.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_012" name="debug_regs_read_only_write_ignored">
        <req_ref>REQ_005</req_ref>
        <objective>Verify attempted APB writes to ERROR_ADDR/ERROR_INFO have no effect on stored value.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, induce a target error so ERROR_ADDR=0x0000_0100 (valid known capture)</action>
            <expected>ERROR_ADDR captures 0x0000_0100, STATUS.PSLVERR=1</expected>
          </step>
          <step num="2">
            <action>At T2, attempt write to ERROR_ADDR: PSEL=1, PADDR=0x0000_0F08, PWRITE=1, PWDATA=0xFFFF_FFFF, then PENABLE=1, PREADY=1</action>
            <expected>Write accepted on bus but RO register ignores data</expected>
          </step>
          <step num="3">
            <action>At T3, attempt write to ERROR_INFO: PSEL=1, PADDR=0x0000_0F0C, PWRITE=1, PWDATA=0xAAAA_AAAA, then PENABLE=1, PREADY=1</action>
            <expected>Write ignored by RO register</expected>
          </step>
          <step num="4">
            <action>At T4, read back ERROR_ADDR: PSEL=1, PADDR=0x0000_0F08, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0x0000_0100 (unchanged, not 0xFFFF_FFFF)</expected>
          </step>
          <step num="5">
            <action>At T5, read back ERROR_INFO: PSEL=1, PADDR=0x0000_0F0C, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA retains captured context (not 0xAAAA_AAAA)</expected>
          </step>
          <step num="6">
            <action>At T6, compare read-back values against pre-write captured values</action>
            <expected>Both registers prove write-immune (RO semantics confirmed)</expected>
          </step>
        </steps>
        <pass_criteria>1. ERROR_ADDR read-back == 0x0000_0100 despite write of 0xFFFF_FFFF. 2. ERROR_INFO read-back unchanged despite write of 0xAAAA_AAAA. 3. No PSLVERR raised by the writes. 4. RO behavior verified for both debug registers.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_013" name="error_addr_overwrite_most_recent">
        <req_ref>REQ_005</req_ref>
        <objective>Verify a subsequent error overwrites the previously captured ERROR_ADDR.</objective>
        <preconditions>
          <condition>HCLK and PCLK running</condition>
          <condition>HRESETn deasserted</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, generate first error: HSEL=1, HTRANS=2'b10, HADDR=0x1111_0000 invalid</action>
            <expected>STATUS.ADDR_ERR=1, HRESP=1</expected>
          </step>
          <step num="2">
            <action>At T2, read ERROR_ADDR: PSEL=1, PADDR=0x0000_0F08, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0x1111_0000</expected>
          </step>
          <step num="3">
            <action>At T3, generate second error: HSEL=1, HTRANS=2'b10, HADDR=0x2222_0000 invalid</action>
            <expected>ADDR_ERR re-asserted for new event, HRESP=1</expected>
          </step>
          <step num="4">
            <action>At T4, read ERROR_ADDR again: PSEL=1, PADDR=0x0000_0F08, PWRITE=0, PENABLE=1, PREADY=1</action>
            <expected>PRDATA=0x2222_0000 (overwritten with most recent)</expected>
          </step>
          <step num="5">
            <action>At T5, compare T2 and T4 read-back values</action>
            <expected>Value changed from 0x1111_0000 to 0x2222_0000, proving most-recent capture</expected>
          </step>
        </steps>
        <pass_criteria>1. First read ERROR_ADDR=0x1111_0000. 2. Second read ERROR_ADDR=0x2222_0000. 3. Captured address always reflects most recent error event. 4. STATUS.ADDR_ERR remains sticky across both events.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_014" name="ctrl_register_reset_and_rw">
        <req_ref>REQ_007</req_ref>
        <objective>Verify CTRL reset value and read/write behavior of writable bits via the peripheral-side register access path.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted after reset</condition>
          <condition>model ENABLE active</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, apply PRESETn=0 for 2 cycles then deassert PRESETn=1 at rising edge of T3</action>
            <expected>CTRL register loads reset value 0x00000001</expected>
          </step>
          <step num="2">
            <action>At T4, drive PSEL=1, PENABLE=0, PWRITE=0, PADDR=0x00000F00 (SETUP phase)</action>
            <expected>SETUP phase entered, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="3">
            <action>At T5, drive PSEL=1, PENABLE=1, PWRITE=0, PADDR=0x00000F00; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000001 (ENABLE=1, all others 0), PREADY=1</expected>
          </step>
          <step num="4">
            <action>At T6, write CTRL: PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x00000F00, PWDATA=0x000000FB (TIMEOUT_EN=1, TIMEOUT_VAL=0x7, ERR_INT_EN=1, ENABLE=1)</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="5">
            <action>At T7, complete write: PSEL=1, PENABLE=1, PWRITE=1, PADDR=0x00000F00, PWDATA=0x000000FB; wait PREADY=1</action>
            <expected>Write accepted, PREADY=1</expected>
          </step>
          <step num="6">
            <action>At T8, read back CTRL via SETUP/ACCESS phases (PADDR=0x00000F00, PWRITE=0)</action>
            <expected>PRDATA=0x000000FB; reserved bits [31:8] and bit[2] read 0; verify writable bits retained values</expected>
          </step>
        </steps>
        <pass_criteria>1. CTRL reset value == 0x00000001. 2. CTRL writable bits (7,6:4,3,1,0) update correctly. 3. Reserved bits [31:8] and bit[2] read as 0. 4. Read-back matches written 0x000000FB masked to writable bits.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_015" name="status_register_reset_and_w1c">
        <req_ref>REQ_007</req_ref>
        <objective>Verify STATUS reset value and write-1-to-clear semantics on sticky error bits while RO bits are unaffected.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>an error scenario has set sticky bits</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, after PRESETn deassertion read STATUS: PSEL=1, PENABLE=1, PWRITE=0, PADDR=0x00000F04; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000001 (READY=1, no sticky error set)</expected>
          </step>
          <step num="2">
            <action>Inject a target error so PSLVERR observed; at T3 read STATUS PADDR=0x00000F04</action>
            <expected>PRDATA bit[5] PSLVERR=1, bit[7] ERR_INT=1 (aggregated), READY/BUSY reflect state</expected>
          </step>
          <step num="3">
            <action>At T4, W1C clear: PSEL=1, PENABLE=0, PWRITE=1, PADDR=0x00000F04, PWDATA=0x000000A0 (write 1 to bits 7 and 5)</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="4">
            <action>At T5, complete write: PSEL=1, PENABLE=1, PWRITE=1, PADDR=0x00000F04, PWDATA=0x000000A0; wait PREADY=1</action>
            <expected>Write accepted, PREADY=1</expected>
          </step>
          <step num="5">
            <action>At T6, read back STATUS PADDR=0x00000F04, PWRITE=0</action>
            <expected>PRDATA bit[7]=0 and bit[5]=0 (cleared); RO bits READY[0]/BUSY[1] unchanged by the write</expected>
          </step>
          <step num="6">
            <action>At T7, attempt to write 0 to a sticky bit (PWDATA=0x00000000) and re-read</action>
            <expected>Writing 0 does not clear or set any sticky bit (W1C semantics proven)</expected>
          </step>
        </steps>
        <pass_criteria>1. STATUS reset == 0x00000001. 2. Writing 1 to bits 7/6/5/4 clears the corresponding sticky bit. 3. Writing 0 leaves sticky bits unchanged. 4. RO bits BUSY[1]/READY[0] unaffected by W1C writes.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_016" name="error_addr_error_info_readonly">
        <req_ref>REQ_007</req_ref>
        <objective>Verify RO debug registers reset to 0, capture error context on an error event, and reject write attempts.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>model idle, no prior errors</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, after reset read ERROR_ADDR: PSEL=1, PENABLE=1, PWRITE=0, PADDR=0x00000F08; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000000 (cleared)</expected>
          </step>
          <step num="2">
            <action>At T2, read ERROR_INFO: PADDR=0x00000F0C, PWRITE=0</action>
            <expected>PRDATA=0x00000000 (cleared)</expected>
          </step>
          <step num="3">
            <action>At T3, drive a source write transfer to invalid address (e.g. HADDR=0x0000ABCD) triggering an ADDR_ERR event</action>
            <expected>Model captures error context into debug registers</expected>
          </step>
          <step num="4">
            <action>At T5, read ERROR_ADDR: PADDR=0x00000F08, PWRITE=0; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x0000ABCD (captured error address)</expected>
          </step>
          <step num="5">
            <action>At T6, read ERROR_INFO: PADDR=0x00000F0C, PWRITE=0</action>
            <expected>PRDATA encodes write direction, beat index, and ADDR_ERR coarse class (non-zero context)</expected>
          </step>
          <step num="6">
            <action>At T7, attempt write: PSEL=1, PENABLE=1, PWRITE=1, PADDR=0x00000F08, PWDATA=0xDEADBEEF; then re-read at T9</action>
            <expected>Write ignored (RO); PRDATA still 0x0000ABCD, value unchanged</expected>
          </step>
        </steps>
        <pass_criteria>1. ERROR_ADDR and ERROR_INFO reset == 0x00000000. 2. ERROR_ADDR captures 0x0000ABCD on error. 3. ERROR_INFO captures coarse error context. 4. Writes to RO registers have no effect (read-back unchanged).</pass_criteria>
      </test_case>
      <test_case test_id="TEST_REGISTER_ACCESS_017" name="register_map_offset_decode">
        <req_ref>REQ_007</req_ref>
        <objective>Verify each defined offset decodes to the correct register and that the 4-byte stride mapping is correct.</objective>
        <preconditions>
          <condition>PCLK running</condition>
          <condition>PRESETn deasserted</condition>
          <condition>model at default reset state</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, SETUP+ACCESS read PADDR=0x00000F00, PSEL=1, PENABLE transitions 0-&gt;1, PWRITE=0; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000001 (CTRL reset value), confirming 0xF00 decodes to CTRL</expected>
          </step>
          <step num="2">
            <action>At T3, read PADDR=0x00000F04, PWRITE=0; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000001 (STATUS reset value, READY=1), confirming 0xF04 decodes to STATUS</expected>
          </step>
          <step num="3">
            <action>At T5, read PADDR=0x00000F08, PWRITE=0; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000000 (ERROR_ADDR reset), confirming 0xF08 decodes to ERROR_ADDR</expected>
          </step>
          <step num="4">
            <action>At T7, read PADDR=0x00000F0C, PWRITE=0; sample PRDATA on PREADY=1</action>
            <expected>PRDATA=0x00000000 (ERROR_INFO reset), confirming 0xF0C decodes to ERROR_INFO</expected>
          </step>
          <step num="5">
            <action>At T9, write CTRL only: PADDR=0x00000F00, PWRITE=1, PWDATA=0x00000080, complete with PENABLE=1/PREADY=1, then read STATUS PADDR=0x00000F04</action>
            <expected>STATUS read-back unaffected by CTRL write (no aliasing); verify offset isolation</expected>
          </step>
        </steps>
        <pass_criteria>1. Each offset 0xF00/0xF04/0xF08/0xF0C returns the correct register's reset value. 2. Access type per offset matches Table 4. 3. Writing one register does not alter another (no address aliasing).</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="reset_tests" category="reset" count="8">
      <test_case test_id="TEST_RESET_001" name="soft_reset_clears_active_transfer_state">
        <req_ref>REQ_014</req_ref>
        <objective>Verify that asserting SOFT_RST while a transfer is active clears active transfer state and returns the model to a clean idle state.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn=1 (deasserted)</condition>
          <condition>PCLK running</condition>
          <condition>PRESETn=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL register: write 0x00000001 to offset 0xF00 (ENABLE=1, SOFT_RST=0, TIMEOUT_EN=0)</action>
            <expected>CTRL=0x00000001, model enabled. STATUS READY bit[0]=1, BUSY bit[1]=0 (STATUS=0x00000001)</expected>
          </step>
          <step num="2">
            <action>At T2, send write traffic: drive HSEL=1, HTRANS=2'b10 (New), HWRITE=1, HADDR=0x00000100, HWDATA=0xDEADBEEF, HSIZE=3'b010</action>
            <expected>Source capture occurs, model accepts transfer, STATUS BUSY bit[1]=1</expected>
          </step>
          <step num="3">
            <action>At T3, observe target-side setup: PSEL=1, PENABLE=0, PADDR=0x00000100, PWRITE=1, PWDATA=0xDEADBEEF</action>
            <expected>Target setup phase (FLOW-2), PSEL=1, PENABLE=0</expected>
          </step>
          <step num="4">
            <action>At T4, advance to active phase: PSEL=1, PENABLE=1 (FLOW-3). Hold target stalled by keeping PREADY=0</action>
            <expected>Target active phase held, model BUSY, source-side completion delayed (HREADY_OUT=0)</expected>
          </step>
          <step num="5">
            <action>At T5, with transfer in ACTIVE/WAITING state, assert soft reset: write CTRL=0x00000003 to offset 0xF00 (SOFT_RST bit[1]=1, ENABLE=1)</action>
            <expected>SOFT_RST asserted, model-local reset action begins</expected>
          </step>
          <step num="6">
            <action>Hold soft reset for N=4 cycles (T5 through T8)</action>
            <expected>Active transfer state cleared, target phase torn down</expected>
          </step>
          <step num="7">
            <action>At T9, read STATUS at offset 0xF04 and compare</action>
            <expected>STATUS=0x00000001 (READY bit[0]=1, BUSY bit[1]=0, all sticky error bits[7:4]=0)</expected>
          </step>
          <step num="8">
            <action>At T10, observe peripheral-side outputs</action>
            <expected>PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000; HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="9">
            <action>At T11, reconfigure: write CTRL=0x00000001 to offset 0xF00 (clear SOFT_RST, keep ENABLE=1)</action>
            <expected>CTRL=0x00000001, model re-enabled and idle</expected>
          </step>
          <step num="10">
            <action>At T12, prove re-use: drive HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x00000100, HWDATA=0xCAFEBABE; allow target completion (PREADY=1); then issue read of HADDR=0x00000100 and compare</action>
            <expected>Read returns HRDATA=0xCAFEBABE, HRESP=0; transfer completes cleanly proving model fully recovered after soft reset</expected>
          </step>
        </steps>
        <pass_criteria>1. After SOFT_RST, STATUS reads 0x00000001 with BUSY=0 and no sticky errors. 2. Target outputs PSEL/PENABLE/PADDR/PWDATA all cleared. 3. After reconfiguration, write 0xCAFEBABE reads back as 0xCAFEBABE. 4. Active in-flight transfer is fully aborted by soft reset.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_002" name="soft_reset_clears_sticky_status_flags">
        <req_ref>REQ_014</req_ref>
        <objective>Verify SOFT_RST clears sticky STATUS error flags that were set by error scenarios.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
          <condition>model enabled CTRL=0x00000001</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, enable error handling: write CTRL=0x00000089 to offset 0xF00 (ENABLE=1, ERR_INT_EN bit[3]=1, TIMEOUT_EN bit[7]=1)</action>
            <expected>CTRL=0x00000089, timeout and sticky interrupt enabled</expected>
          </step>
          <step num="2">
            <action>At T2, inject a target error: drive a write HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x00000200, HWDATA=0xDEADBEEF; on target active phase drive PSLVERR=1 with PREADY=1</action>
            <expected>Target error observed during active access, model captures debug context</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS at offset 0xF04 and verify error capture</action>
            <expected>STATUS PSLVERR bit[5]=1, ERR_INT bit[7]=1 sticky set (STATUS = 0x000000A1: bit7,bit5,bit0). HRESP=1 returned</expected>
          </step>
          <step num="4">
            <action>At T4, read ERROR_ADDR at offset 0xF08 and compare</action>
            <expected>ERROR_ADDR=0x00000200 (captured failing address)</expected>
          </step>
          <step num="5">
            <action>At T5, confirm model is idle and READY (STATUS bit[0]=1, BUSY bit[1]=0)</action>
            <expected>Model ready for subsequent activity after error</expected>
          </step>
          <step num="6">
            <action>At T6, assert soft reset: write CTRL=0x0000008B to offset 0xF00 (SOFT_RST bit[1]=1, retaining ENABLE/ERR_INT_EN/TIMEOUT_EN)</action>
            <expected>SOFT_RST asserted, sticky-flag clearing action begins</expected>
          </step>
          <step num="7">
            <action>Hold soft reset for N=4 cycles (T6 through T9)</action>
            <expected>Sticky status flags cleared by soft reset action</expected>
          </step>
          <step num="8">
            <action>At T10, read STATUS at offset 0xF04 and compare to reset value</action>
            <expected>STATUS=0x00000001 (ERR_INT[7]=0, PSLVERR[5]=0, all sticky bits cleared, READY[0]=1)</expected>
          </step>
          <step num="9">
            <action>At T11, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C)</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000 (debug capture cleared)</expected>
          </step>
          <step num="10">
            <action>At T12, write CTRL=0x00000001 to clear SOFT_RST; then prove clean operation: write HADDR=0x00000200 HWDATA=0xCAFEBABE with PREADY=1 PSLVERR=0, read back and compare</action>
            <expected>HRDATA=0xCAFEBABE, HRESP=0, STATUS still 0x00000001 (no new errors) — proving sticky flags fully cleared and model recovered</expected>
          </step>
        </steps>
        <pass_criteria>1. Sticky bits ERR_INT[7] and PSLVERR[5] set after error then read 0 after SOFT_RST. 2. STATUS returns to 0x00000001. 3. ERROR_ADDR/ERROR_INFO cleared to 0x00000000. 4. Subsequent error-free transfer completes with HRDATA=0xCAFEBABE and HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_003" name="soft_reset_preserves_basic_configuration">
        <req_ref>REQ_014</req_ref>
        <objective>Verify SOFT_RST preserves configuration bits (TIMEOUT_VAL, TIMEOUT_EN, ENABLE) while clearing transient/sticky state.</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>HRESETn=1</condition>
          <condition>PRESETn=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, write CTRL=0x000000F9 to offset 0xF00 (ENABLE bit[0]=1, ERR_INT_EN bit[3]=1, TIMEOUT_VAL bits[6:4]=3'b111, TIMEOUT_EN bit[7]=1)</action>
            <expected>CTRL=0x000000F9, full configuration programmed</expected>
          </step>
          <step num="2">
            <action>At T2, read back CTRL at offset 0xF00 and compare</action>
            <expected>CTRL=0x000000F9 confirming configuration written</expected>
          </step>
          <step num="3">
            <action>At T3, send traffic: HSEL=1, HTRANS=2'b10, HWRITE=1, HADDR=0x00000300, HWDATA=0xDEADBEEF, PREADY=1; verify write completes</action>
            <expected>Transfer completes, PADDR=0x00000300, PWDATA=0xDEADBEEF, HRESP=0</expected>
          </step>
          <step num="4">
            <action>At T4, read back HADDR=0x00000300 to prove traffic works</action>
            <expected>HRDATA=0xDEADBEEF, HRESP=0</expected>
          </step>
          <step num="5">
            <action>At T5, place model in BUSY state by starting a stalled transfer (PREADY=0) so STATUS BUSY bit[1]=1</action>
            <expected>STATUS=0x00000003 (BUSY[1]=1, READY[0]=1 transient), transfer in WAITING state</expected>
          </step>
          <step num="6">
            <action>At T6, assert soft reset: write CTRL=0x000000FB to offset 0xF00 (set SOFT_RST bit[1]=1 while keeping config bits TIMEOUT_VAL/TIMEOUT_EN/ENABLE/ERR_INT_EN)</action>
            <expected>SOFT_RST asserted</expected>
          </step>
          <step num="7">
            <action>Hold soft reset for N=4 cycles (T6 through T9), then write CTRL with SOFT_RST=0 keeping config: CTRL=0x000000F9</action>
            <expected>Active state cleared, SOFT_RST self-cleared by software</expected>
          </step>
          <step num="8">
            <action>At T10, read CTRL at offset 0xF00 and verify configuration preserved</action>
            <expected>CTRL=0x000000F9 (TIMEOUT_VAL=3'b111, TIMEOUT_EN=1, ERR_INT_EN=1, ENABLE=1 all preserved; SOFT_RST=0)</expected>
          </step>
          <step num="9">
            <action>At T11, read STATUS at offset 0xF04 and verify transient/sticky state cleared</action>
            <expected>STATUS=0x00000001 (BUSY[1]=0, sticky errors=0, READY[0]=1)</expected>
          </step>
          <step num="10">
            <action>At T12, prove operation resumes with preserved config: write HADDR=0x00000300 HWDATA=0xCAFEBABE with PREADY=1, read back and compare</action>
            <expected>HRDATA=0xCAFEBABE, HRESP=0; configuration-dependent behavior intact, proving soft reset preserved config while clearing transient state</expected>
          </step>
        </steps>
        <pass_criteria>1. CTRL configuration bits (0x000000F9) unchanged across SOFT_RST. 2. STATUS transient BUSY and sticky bits cleared to 0x00000001. 3. Write 0xCAFEBABE reads back as 0xCAFEBABE after soft reset. 4. Soft reset distinguishes between preserved config and cleared transient state.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_004" name="soft_reset_vs_hard_reset_value_comparison">
        <req_ref>REQ_014</req_ref>
        <objective>Verify the distinction between SOFT_RST behavior (preserves config) and full HRESETn hard reset (restores all defaults including CTRL).</objective>
        <preconditions>
          <condition>HCLK running</condition>
          <condition>PRESETn=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, apply hard reset: drive HRESETn=0 and PRESETn=0 for 2 cycles, then release HRESETn=1, PRESETn=1 at T3</action>
            <expected>All registers at Table 8 reset values: CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="2">
            <action>At T4, verify hard-reset register values by reading offsets 0xF00, 0xF04, 0xF08, 0xF0C and comparing</action>
            <expected>CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000; HREADY_OUT=1, HRESP=0, PSEL=0, PENABLE=0</expected>
          </step>
          <step num="3">
            <action>At T5, reconfigure away from defaults: write CTRL=0x000000F9 to offset 0xF00</action>
            <expected>CTRL=0x000000F9, non-default config programmed</expected>
          </step>
          <step num="4">
            <action>At T6, send traffic and induce a sticky error (PSLVERR=1) on a write to HADDR=0x00000400 HWDATA=0xDEADBEEF</action>
            <expected>STATUS sticky bits set (e.g. STATUS=0x00000021 with PSLVERR[5]=1), ERROR_ADDR=0x00000400, HRESP=1</expected>
          </step>
          <step num="5">
            <action>At T7, verify pre-soft-reset state: read CTRL=0x000000F9, STATUS shows sticky error, ERROR_ADDR=0x00000400</action>
            <expected>CTRL=0x000000F9, STATUS bit[5]=1, ERROR_ADDR=0x00000400 confirmed</expected>
          </step>
          <step num="6">
            <action>At T8, assert SOFT_RST: write CTRL=0x000000FB (SOFT_RST bit[1]=1, config retained)</action>
            <expected>SOFT_RST asserted</expected>
          </step>
          <step num="7">
            <action>Hold SOFT_RST N=4 cycles (T8-T11), then write CTRL=0x000000F9 to deassert SOFT_RST</action>
            <expected>Active/sticky state cleared by soft reset</expected>
          </step>
          <step num="8">
            <action>At T12, read CTRL and STATUS; compare soft-reset result against hard-reset result</action>
            <expected>CTRL=0x000000F9 (PRESERVED, differs from hard-reset default 0x00000001), STATUS=0x00000001 (cleared, matches hard reset), ERROR_ADDR=0x00000000 (cleared)</expected>
          </step>
          <step num="9">
            <action>At T13, now apply full HRESETn=0 for 2 cycles and release at T15; read CTRL</action>
            <expected>CTRL=0x00000001 (hard reset OVERRIDES preserved config, restores default per Table 8)</expected>
          </step>
          <step num="10">
            <action>At T16, prove operational after both reset types: write HADDR=0x00000400 HWDATA=0xCAFEBABE with PREADY=1 PSLVERR=0, read back and compare</action>
            <expected>HRDATA=0xCAFEBABE, HRESP=0, STATUS=0x00000001; proves soft reset preserved CTRL=0x000000F9 while hard reset restored CTRL=0x00000001, both clearing transient/sticky state</expected>
          </step>
        </steps>
        <pass_criteria>1. Hard reset (HRESETn) restores CTRL=0x00000001 per Table 8. 2. Soft reset (SOFT_RST) preserves CTRL=0x000000F9 while clearing STATUS to 0x00000001. 3. Both reset types clear sticky errors and ERROR_ADDR to 0x00000000. 4. Post-reset write 0xCAFEBABE reads back correctly proving full recovery.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_005" name="hard_reset_during_idle_register_defaults">
        <req_ref>REQ_015</req_ref>
        <objective>Verify that asserting hard reset while the bridge is idle returns all outputs and registers to their documented reset values.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1, PRESETn=1 initially</condition>
          <condition>bridge enabled (CTRL.ENABLE=1)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL: write 0x000000F9 (ENABLE=1, SOFT_RST=0, ERR_INT_EN=1, TIMEOUT_VAL=3'b111, TIMEOUT_EN=1) via source-side write to offset 0xF00, HADDR=0x00000F00, HWRITE=1, HWDATA=0x000000F9</action>
            <expected>CTRL accepts write, HREADY_OUT=1, HRESP=0 on completion</expected>
          </step>
          <step num="2">
            <action>At T2, read back CTRL: HADDR=0x00000F00, HWRITE=0; capture HRDATA</action>
            <expected>HRDATA=0x000000F9, confirming configuration applied</expected>
          </step>
          <step num="3">
            <action>At T3, send traffic: write 0xDEAD_BEEF to a data target, HADDR=0x00000100, HWRITE=1, HWDATA=0xDEADBEEF; PSEL=1, PENABLE=1, PWRITE=1, PWDATA=0xDEADBEEF, PADDR=0x00000100; PREADY=1</action>
            <expected>Transfer completes, HREADY_OUT=1, HRESP=0, target write observed PWDATA=0xDEADBEEF</expected>
          </step>
          <step num="4">
            <action>At T4, read back 0x00000100: HADDR=0x00000100, HWRITE=0, PREADY=1, PRDATA=0xDEADBEEF</action>
            <expected>HRDATA=0xDEADBEEF, traffic path proven functional</expected>
          </step>
          <step num="5">
            <action>At T5, ensure bridge is in IDLE state (no pending transfer, STATUS.BUSY=0, STATUS.READY=1)</action>
            <expected>Bridge idle, PSEL=0, PENABLE=0</expected>
          </step>
          <step num="6">
            <action>At T6 (rising edge), assert hard reset: HRESETn=0 and PRESETn=0</action>
            <expected>Reset entry begins</expected>
          </step>
          <step num="7">
            <action>Hold HRESETn=0 and PRESETn=0 for 8 cycles (T6 through T13)</action>
            <expected>Reset held; internal state forced to idle</expected>
          </step>
          <step num="8">
            <action>At T14 (rising edge), release reset: HRESETn=1 and PRESETn=1</action>
            <expected>Bridge resumes from clean idle state</expected>
          </step>
          <step num="9">
            <action>At T15, verify output signals: HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000</action>
            <expected>All outputs at Table 8 reset values</expected>
          </step>
          <step num="10">
            <action>At T16, read all registers and compare: CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</action>
            <expected>All registers at documented reset values; prior CTRL=0x000000F9 cleared to 0x00000001</expected>
          </step>
          <step num="11">
            <action>At T17, reconfigure: write CTRL=0x00000001 (re-enable), HADDR=0x00000F00, HWRITE=1, HWDATA=0x00000001</action>
            <expected>CTRL write accepted, HREADY_OUT=1</expected>
          </step>
          <step num="12">
            <action>At T18, send traffic: write 0xCAFE_BABE, HADDR=0x00000100, HWRITE=1, HWDATA=0xCAFEBABE; PSEL=1, PENABLE=1, PWDATA=0xCAFEBABE, PREADY=1</action>
            <expected>Transfer completes, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="13">
            <action>At T19, read back 0x00000100: HADDR=0x00000100, HWRITE=0, PRDATA=0xCAFEBABE</action>
            <expected>HRDATA=0xCAFEBABE, proving full functional recovery post-reset</expected>
          </step>
        </steps>
        <pass_criteria>1. After reset release, HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000. 2. CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000. 3. Post-reset write/read of 0xCAFEBABE matches, proving recovery.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_006" name="hard_reset_during_active_transfer_abort">
        <req_ref>REQ_015</req_ref>
        <objective>Verify that asserting hard reset while a transfer is in the ACTIVE/WAITING phase aborts the transfer cleanly and restores all reset values.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1, PRESETn=1 initially</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL: write 0x00000001 to offset 0xF00, HADDR=0x00000F00, HWRITE=1, HWDATA=0x00000001</action>
            <expected>CTRL=0x00000001, HREADY_OUT=1</expected>
          </step>
          <step num="2">
            <action>At T2, verify config by reading CTRL: HADDR=0x00000F00, HWRITE=0</action>
            <expected>HRDATA=0x00000001</expected>
          </step>
          <step num="3">
            <action>At T3, prove traffic works: write 0xDEAD_BEEF to HADDR=0x00000200, HWRITE=1, HWDATA=0xDEADBEEF, PREADY=1, then read back at T4</action>
            <expected>HRDATA=0xDEADBEEF on read-back, HRESP=0</expected>
          </step>
          <step num="4">
            <action>At T5, start a new write: HADDR=0x00000204, HWRITE=1, HWDATA=0x12345678, HTRANS=2'b10 (New); model enters target setup (PSEL=1, PENABLE=0, PADDR=0x00000204)</action>
            <expected>SETUP phase entered, PSEL=1, PENABLE=0</expected>
          </step>
          <step num="5">
            <action>At T6, advance to ACTIVE phase with target stalling: PSEL=1, PENABLE=1, PWRITE=1, PWDATA=0x12345678, PREADY=0 (target not ready)</action>
            <expected>ACTIVE/WAITING state, HREADY_OUT=0 (completion delayed), STATUS.BUSY=1</expected>
          </step>
          <step num="6">
            <action>At T7 (rising edge), while transfer is mid-flight and stalled, assert hard reset: HRESETn=0 and PRESETn=0</action>
            <expected>In-flight transfer aborted; reset entry begins</expected>
          </step>
          <step num="7">
            <action>Hold HRESETn=0 and PRESETn=0 for 6 cycles (T7 through T12)</action>
            <expected>Reset held; PSEL forced 0, PENABLE forced 0</expected>
          </step>
          <step num="8">
            <action>At T13 (rising edge), release reset: HRESETn=1 and PRESETn=1</action>
            <expected>Bridge returns to clean idle</expected>
          </step>
          <step num="9">
            <action>At T14, verify outputs: HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000 (the aborted PWDATA=0x12345678 must be cleared)</action>
            <expected>All outputs at reset values; no residual aborted transfer state</expected>
          </step>
          <step num="10">
            <action>At T15, read STATUS and compare: STATUS=0x00000001 (BUSY=0, READY=1, no sticky error)</action>
            <expected>STATUS=0x00000001, confirming clean idle with no error flags set by the abort</expected>
          </step>
          <step num="11">
            <action>At T16, read ERROR_ADDR and ERROR_INFO: compare both to 0x00000000</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="12">
            <action>At T17, reconfigure CTRL=0x00000001 and at T18 send write 0xCAFE_BABE to HADDR=0x00000204, HWRITE=1, HWDATA=0xCAFEBABE, PREADY=1</action>
            <expected>Transfer completes, HREADY_OUT=1, HRESP=0</expected>
          </step>
          <step num="13">
            <action>At T19, read back HADDR=0x00000204, HWRITE=0, PRDATA=0xCAFEBABE; compare</action>
            <expected>HRDATA=0xCAFEBABE, proving clean recovery after mid-transfer reset</expected>
          </step>
        </steps>
        <pass_criteria>1. Reset asserted during ACTIVE/WAITING aborts the stalled transfer; PSEL=0, PENABLE=0, PWDATA=0x00000000 after release. 2. STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000, no spurious error set. 3. Post-reset 0xCAFEBABE write/read matches.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_007" name="hard_reset_clears_sticky_error_state">
        <req_ref>REQ_015</req_ref>
        <objective>Verify that hard reset clears sticky STATUS error bits (ERR_INT, TIMEOUT_ERR, PSLVERR, ADDR_ERR) and captured debug registers ERROR_ADDR/ERROR_INFO.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1, PRESETn=1 initially</condition>
          <condition>CTRL.ENABLE=1, CTRL.ERR_INT_EN=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL: write 0x00000009 to offset 0xF00 (ENABLE=1, ERR_INT_EN=1), HADDR=0x00000F00, HWRITE=1, HWDATA=0x00000009</action>
            <expected>CTRL=0x00000009, HREADY_OUT=1</expected>
          </step>
          <step num="2">
            <action>At T2, read back CTRL: HADDR=0x00000F00, HWRITE=0</action>
            <expected>HRDATA=0x00000009 confirming error indication enabled</expected>
          </step>
          <step num="3">
            <action>At T3, prove normal traffic: write 0xDEAD_BEEF to HADDR=0x00000300, HWRITE=1, HWDATA=0xDEADBEEF, PREADY=1; read back at T4</action>
            <expected>HRDATA=0xDEADBEEF, HRESP=0, no error flags set</expected>
          </step>
          <step num="4">
            <action>At T5, inject a target error: start write to HADDR=0x00000304, HWRITE=1, PSEL=1, PENABLE=1, PWDATA=0x55555555, PREADY=1, PSLVERR=1</action>
            <expected>Target error observed; HRESP=1 returned; STATUS.PSLVERR=1, STATUS.ERR_INT=1 set sticky</expected>
          </step>
          <step num="5">
            <action>At T6, read STATUS: HADDR=0x00000F04, HWRITE=0; verify sticky bits set</action>
            <expected>HRDATA shows STATUS bit5 (PSLVERR)=1 and bit7 (ERR_INT)=1 (e.g. 0x000000A1)</expected>
          </step>
          <step num="6">
            <action>At T7, read ERROR_ADDR (offset 0xF08) and ERROR_INFO (offset 0xF0C)</action>
            <expected>ERROR_ADDR=0x00000304 (captured failing address), ERROR_INFO non-zero (captured context)</expected>
          </step>
          <step num="7">
            <action>At T8 (rising edge), with sticky error state present, assert hard reset: HRESETn=0 and PRESETn=0</action>
            <expected>Reset entry begins</expected>
          </step>
          <step num="8">
            <action>Hold HRESETn=0 and PRESETn=0 for 10 cycles (T8 through T17)</action>
            <expected>Reset held; sticky flags being cleared</expected>
          </step>
          <step num="9">
            <action>At T18 (rising edge), release reset: HRESETn=1 and PRESETn=1</action>
            <expected>Bridge returns to clean idle</expected>
          </step>
          <step num="10">
            <action>At T19, read STATUS (offset 0xF04) and compare to 0x00000001</action>
            <expected>STATUS=0x00000001; ERR_INT, PSLVERR, TIMEOUT_ERR, ADDR_ERR all cleared, READY=1</expected>
          </step>
          <step num="11">
            <action>At T20, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C); compare each to 0x00000000</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000, captured debug state cleared</expected>
          </step>
          <step num="12">
            <action>At T21, verify outputs: HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0</action>
            <expected>All outputs at Table 8 reset values; HRESP error de-asserted</expected>
          </step>
          <step num="13">
            <action>At T22, reconfigure CTRL=0x00000009, then at T23 write 0xCAFE_BABE to HADDR=0x00000300, HWRITE=1, HWDATA=0xCAFEBABE, PREADY=1; at T24 read back and compare</action>
            <expected>HRDATA=0xCAFEBABE on read-back, proving error-free recovery with no residual sticky flags</expected>
          </step>
        </steps>
        <pass_criteria>1. Pre-reset STATUS sticky bits (PSLVERR, ERR_INT) and ERROR_ADDR=0x00000304 confirmed set. 2. After reset release, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000. 3. Outputs at reset values and post-reset 0xCAFEBABE write/read matches with HRESP=0.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_RESET_008" name="hard_reset_immediate_reuse_after_release">
        <req_ref>REQ_015</req_ref>
        <objective>Verify the bridge is immediately ready to accept and complete a new transfer on the first cycle after reset release, with all registers at reset values.</objective>
        <preconditions>
          <condition>HCLK/PCLK running</condition>
          <condition>HRESETn=1, PRESETn=1 initially</condition>
          <condition>CTRL.ENABLE=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, configure CTRL: write 0x000000F1 to offset 0xF00 (ENABLE=1, TIMEOUT_EN=1, TIMEOUT_VAL=3'b111), HADDR=0x00000F00, HWRITE=1, HWDATA=0x000000F1</action>
            <expected>CTRL=0x000000F1, HREADY_OUT=1</expected>
          </step>
          <step num="2">
            <action>At T2, read back CTRL: HADDR=0x00000F00, HWRITE=0</action>
            <expected>HRDATA=0x000000F1</expected>
          </step>
          <step num="3">
            <action>At T3, prove traffic works: write 0xDEAD_BEEF to HADDR=0x00000400, HWRITE=1, HWDATA=0xDEADBEEF, PREADY=1; at T4 read back HADDR=0x00000400, HWRITE=0</action>
            <expected>HRDATA=0xDEADBEEF, HRESP=0</expected>
          </step>
          <step num="4">
            <action>At T5, drive bridge into SETUP state: HADDR=0x00000404, HWRITE=1, HTRANS=2'b10 (New), PSEL=1, PENABLE=0, PADDR=0x00000404</action>
            <expected>SETUP phase, PSEL=1, PENABLE=0, STATUS.BUSY=1</expected>
          </step>
          <step num="5">
            <action>At T6 (rising edge), assert hard reset: HRESETn=0 and PRESETn=0</action>
            <expected>Reset entry begins, transfer aborted</expected>
          </step>
          <step num="6">
            <action>Hold HRESETn=0 and PRESETn=0 for exactly 4 cycles (T6 through T9)</action>
            <expected>Reset held minimum window</expected>
          </step>
          <step num="7">
            <action>At T10 (rising edge), release reset: HRESETn=1 and PRESETn=1</action>
            <expected>Bridge enters clean idle</expected>
          </step>
          <step num="8">
            <action>At T11 (first cycle after release), verify readiness and outputs: HREADY_OUT=1, HRESP=0, HRDATA=0x00000000, PSEL=0, PENABLE=0, PADDR=0x00000000, PWDATA=0x00000000</action>
            <expected>Bridge immediately ready; all outputs at Table 8 reset values</expected>
          </step>
          <step num="9">
            <action>At T11, read STATUS (0xF04) and CTRL (0xF00); compare</action>
            <expected>STATUS=0x00000001 (READY=1), CTRL=0x00000001 (TIMEOUT settings cleared)</expected>
          </step>
          <step num="10">
            <action>At T12, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C); compare</action>
            <expected>ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</expected>
          </step>
          <step num="11">
            <action>At T13, immediately issue a new transfer (no reconfiguration delay): write 0xCAFE_BABE to HADDR=0x00000404, HWRITE=1, HWDATA=0xCAFEBABE, HTRANS=2'b10, PSEL=1, PENABLE=1, PWDATA=0xCAFEBABE, PREADY=1</action>
            <expected>Transfer accepted on first attempt post-reset, HREADY_OUT asserts on completion, HRESP=0</expected>
          </step>
          <step num="12">
            <action>At T14, read back HADDR=0x00000404, HWRITE=0, PRDATA=0xCAFEBABE; compare</action>
            <expected>HRDATA=0xCAFEBABE, proving immediate re-use capability after reset</expected>
          </step>
          <step num="13">
            <action>At T15, re-read STATUS to confirm clean completion: HADDR=0x00000F04, HWRITE=0</action>
            <expected>STATUS shows BUSY=0, READY=1, no sticky error bits (0x00000001)</expected>
          </step>
        </steps>
        <pass_criteria>1. On the first cycle after reset release HREADY_OUT=1 and STATUS.READY=1, bridge ready without reconfiguration. 2. All registers at reset values: CTRL=0x00000001, STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000. 3. Immediate post-reset write/read of 0xCAFEBABE matches with HRESP=0.</pass_criteria>
      </test_case>
    </test_suite>
    <test_suite name="cross_feature_tests" category="cross_feature" count="6">
      <test_case test_id="TEST_CROSS_FEATURE_001" name="hard_reset_during_active_transfer">
        <req_ref>REQ_015</req_ref>
        <features_involved>hard_reset_initialization, core_translation_behavior, back_pressure_wait_behavior</features_involved>
        <objective>Expose state-machine corruption / dangling target-side phase when HRESETn is asserted while a transfer is mid-flight and the peripheral is stalling (PREADY=0). Single-feature reset tests start from idle and miss the abort-of-in-flight-transfer bug class.</objective>
        <preconditions>
          <condition>HCLK free-running with PCLK tied to HCLK</condition>
          <condition>HRESETn=1, PRESETn=1, bridge in clean IDLE (STATUS=0x00000001)</condition>
          <condition>Peripheral model configured to hold PREADY=0 to force back-pressure</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HSEL=0x1, HTRANS=2'b10 (NSEQ), HWRITE=0x1, HSIZE=3'b010, HADDR=0x0000_1000, HWDATA=0xDEAD_BEEF on HCLK rising edge</action>
            <expected>Source captures transfer (FLOW-1); FSM moves IDLE-&gt;SETUP, BUSY=1</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup phase: PSEL=0x1, PENABLE=0x0, PADDR=0x0000_1000, PWDATA=0xDEAD_BEEF</action>
            <expected>Target setup asserted (FLOW-2), PENABLE still low</expected>
          </step>
          <step num="3">
            <action>At T3, advance to active phase with peripheral stalling: PENABLE=0x1, PREADY=0x0 held</action>
            <expected>Bridge holds active phase (FLOW-4), HREADY_OUT=0x0, completion blocked by target latency</expected>
          </step>
          <step num="4">
            <action>At T4, while PREADY=0x0 and transfer is mid-flight, assert HRESETn=0 and PRESETn=0 on the shared rising edge</action>
            <expected>Bridge aborts in-flight transfer cleanly; no latched dangling PSEL/PENABLE</expected>
          </step>
          <step num="5">
            <action>At T5, hold reset for two HCLK cycles, then deassert HRESETn=1 and PRESETn=1 together</action>
            <expected>Bridge returns to clean IDLE; PSEL=0x0, PENABLE=0x0, HREADY_OUT=0x1 per Table 8</expected>
          </step>
          <step num="6">
            <action>At T6, read back STATUS (HADDR=0x0000_0F04, HWRITE=0) and ERROR_ADDR (0xF08)</action>
            <expected>STATUS=0x0000_0001 (READY=1, BUSY=0, no sticky bits set by the abort); ERROR_ADDR=0x0000_0000</expected>
          </step>
          <step num="7">
            <action>At T7, issue a fresh transfer HSEL=0x1, HTRANS=2'b10, HWRITE=0x1, HADDR=0x0000_2000, HWDATA=0xA5A5_5A5A with PREADY=0x1</action>
            <expected>New transfer accepted and completes normally, HRESP=0x0, proving the reset fully cleared the aborted transfer state</expected>
          </step>
        </steps>
        <pass_criteria>1. Asserting HRESETn mid-stall aborts the in-flight transfer with no dangling PSEL/PENABLE. 2. Post-reset state is clean IDLE: PSEL=0, PENABLE=0, HREADY_OUT=1, STATUS=0x00000001, ERROR_ADDR=0x00000000. 3. A new transfer after reset completes successfully with HRESP=0, proving no corruption survived the abort.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_002" name="target_error_during_back_pressure">
        <req_ref>REQ_018</req_ref>
        <features_involved>target_error_scenario, back_pressure_wait_behavior, error_response_timing</features_involved>
        <objective>Expose error-latching faults when PSLVERR is asserted on the same cycle the peripheral finally releases back-pressure (PREADY rises with PSLVERR=1). Single-feature error tests assert PSLVERR with no prior stall and miss the stall-then-error race.</objective>
        <preconditions>
          <condition>HCLK free-running, PCLK=HCLK, bridge in IDLE</condition>
          <condition>STATUS=0x00000001 with no sticky error flags set</condition>
          <condition>Peripheral configured to stall (PREADY=0) for several cycles then complete with PSLVERR=1</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HSEL=0x1, HTRANS=2'b10, HWRITE=0x0 (read), HSIZE=3'b010, HADDR=0x0000_3000</action>
            <expected>Source captures read transfer (FLOW-1), BUSY=1</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup PSEL=0x1, PENABLE=0x0, PADDR=0x0000_3000, PWRITE=0x0</action>
            <expected>Target setup phase asserted (FLOW-2)</expected>
          </step>
          <step num="3">
            <action>At T3-T5, advance to active phase PENABLE=0x1 and hold PREADY=0x0 for three cycles (back-pressure)</action>
            <expected>Bridge holds, HREADY_OUT=0x0, source completion delayed (FLOW-4), no error latched yet</expected>
          </step>
          <step num="4">
            <action>At T6, peripheral releases back-pressure and signals error on the same edge: PREADY=0x1 with PSLVERR=0x1 and PRDATA=0x0000_0000</action>
            <expected>Bridge completes the transfer and propagates error: HRESP=0x1 (ERROR) returned to source on the same completion</expected>
          </step>
          <step num="5">
            <action>At T7, observe HREADY_OUT and HRESP timing on the source side</action>
            <expected>HRESP=0x1 asserted coincident with completion; error not lost despite the preceding multi-cycle stall</expected>
          </step>
          <step num="6">
            <action>At T8, read back STATUS (HADDR=0x0000_0F04, HWRITE=0)</action>
            <expected>STATUS shows sticky PSLVERR=1 and ERR_INT=1 latched; BUSY=0, READY=1</expected>
          </step>
          <step num="7">
            <action>At T9, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) to confirm captured context</action>
            <expected>ERROR_ADDR=0x0000_3000 (faulting address), ERROR_INFO encodes read direction and target-error class</expected>
          </step>
        </steps>
        <pass_criteria>1. A PSLVERR coincident with PREADY rising after a multi-cycle stall is correctly captured (no lost error). 2. HRESP=0x1 propagates to the source on completion. 3. STATUS latches sticky PSLVERR and ERR_INT. 4. ERROR_ADDR=0x00003000 matches the faulting address with correct ERROR_INFO context.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_003" name="ctrl_register_write_during_active_transfer">
        <req_ref>REQ_003</req_ref>
        <features_involved>ctrl_register_access, core_translation_behavior, back_pressure_wait_behavior</features_involved>
        <objective>Expose mid-transfer reconfiguration hazards when CTRL.ENABLE is cleared (or TIMEOUT_EN toggled) while a data transfer is still active. Single-feature register tests write CTRL only from idle and miss the live-transfer interaction.</objective>
        <preconditions>
          <condition>HCLK=PCLK running, bridge in IDLE, CTRL=0x00000001 (ENABLE=1)</condition>
          <condition>STATUS=0x00000001, no sticky errors</condition>
          <condition>Peripheral stalls one cycle (PREADY=0) then completes</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, start a write transfer: HSEL=0x1, HTRANS=2'b10, HWRITE=0x1, HSIZE=3'b010, HADDR=0x0000_4000, HWDATA=0xCAFE_F00D</action>
            <expected>Transfer captured (FLOW-1), BUSY=1, FSM IDLE-&gt;SETUP</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup PSEL=0x1, PENABLE=0x0, PADDR=0x0000_4000, PWDATA=0xCAFE_F00D</action>
            <expected>Target setup phase active (FLOW-2)</expected>
          </step>
          <step num="3">
            <action>At T3, advance to active phase PENABLE=0x1 with PREADY=0x0 (one stall cycle)</action>
            <expected>Bridge holds active phase, HREADY_OUT=0x0 (FLOW-4)</expected>
          </step>
          <step num="4">
            <action>At T4, while the transfer is still active, issue a CTRL register write: HSEL=0x1, HTRANS=2'b10, HWRITE=0x1, HADDR=0x0000_0F00, HWDATA=0x0000_0000 (attempt to clear ENABLE)</action>
            <expected>In-flight data transfer is not corrupted; CTRL write is either deferred or applied without disturbing the active beat</expected>
          </step>
          <step num="5">
            <action>At T5, peripheral completes the original data transfer: PREADY=0x1, PSLVERR=0x0</action>
            <expected>Original write completes intact, PWDATA=0xCAFE_F00D delivered, HRESP=0x0, HREADY_OUT=0x1</expected>
          </step>
          <step num="6">
            <action>At T6, read back CTRL (HADDR=0x0000_0F00, HWRITE=0)</action>
            <expected>CTRL reflects the write applied at a clean boundary (ENABLE=0); reserved bits 31:8/bit2 unchanged</expected>
          </step>
          <step num="7">
            <action>At T7, read STATUS (0xF04) to confirm the in-flight transfer was not flagged as an error by the concurrent CTRL access</action>
            <expected>STATUS sticky error bits all 0; BUSY=0, READY=1, STATUS=0x00000001</expected>
          </step>
        </steps>
        <pass_criteria>1. A CTRL write during an active transfer does not corrupt the in-flight beat: PWDATA=0xCAFEF00D is delivered with HRESP=0. 2. The CTRL write applies cleanly (ENABLE=0 readback). 3. No spurious sticky error bits set in STATUS by the concurrent access.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_004" name="soft_reset_clears_sticky_error">
        <req_ref>REQ_014</req_ref>
        <features_involved>soft_reset, target_error_scenario, status_register_access, captured_debug_registers</features_involved>
        <objective>Expose incomplete soft-reset behavior where SOFT_RST clears active transfer state but fails to clear previously latched sticky STATUS error flags or stale ERROR_ADDR/ERROR_INFO. Requires first provoking an error, then soft-resetting — neither error nor reset feature alone covers this.</objective>
        <preconditions>
          <condition>HCLK=PCLK running, bridge post hard-reset IDLE, CTRL=0x00000001</condition>
          <condition>STATUS=0x00000001, ERROR_ADDR=0x00000000, ERROR_INFO=0x00000000</condition>
          <condition>Peripheral configured to assert PSLVERR=1 on the next transfer</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive an erroring transfer: HSEL=0x1, HTRANS=2'b10, HWRITE=0x1, HADDR=0x0000_5000, HWDATA=0x1234_5678</action>
            <expected>Transfer captured and forwarded to target (FLOW-1..FLOW-3)</expected>
          </step>
          <step num="2">
            <action>At T2, peripheral completes with PREADY=0x1, PSLVERR=0x1</action>
            <expected>HRESP=0x1 returned to source; error context captured</expected>
          </step>
          <step num="3">
            <action>At T3, read STATUS (0xF04), ERROR_ADDR (0xF08), ERROR_INFO (0xF0C) to confirm sticky state is set</action>
            <expected>STATUS has PSLVERR=1 and ERR_INT=1 sticky; ERROR_ADDR=0x0000_5000; ERROR_INFO non-zero (write direction, target-error class)</expected>
          </step>
          <step num="4">
            <action>At T4, write CTRL (HADDR=0x0000_0F00, HWRITE=1, HWDATA with SOFT_RST bit1=1) to trigger a model-local soft reset</action>
            <expected>SOFT_RST asserted; bridge clears active transfer state per Section 6.3</expected>
          </step>
          <step num="5">
            <action>At T5, allow soft reset to take effect, then read back CTRL (0xF00)</action>
            <expected>SOFT_RST is self-clearing (reads back 0); ENABLE/config knobs preserved per Table 5</expected>
          </step>
          <step num="6">
            <action>At T6, read back STATUS (0xF04) to verify sticky error flags were cleared by the soft reset</action>
            <expected>STATUS=0x0000_0001 (PSLVERR=0, ERR_INT=0, BUSY=0, READY=1)</expected>
          </step>
          <step num="7">
            <action>At T7, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) to confirm stale error context was cleared</action>
            <expected>ERROR_ADDR=0x0000_0000 and ERROR_INFO=0x0000_0000</expected>
          </step>
        </steps>
        <pass_criteria>1. SOFT_RST clears sticky STATUS error flags (PSLVERR, ERR_INT) back to STATUS=0x00000001. 2. SOFT_RST clears ERROR_ADDR and ERROR_INFO to 0x00000000. 3. CTRL configuration (ENABLE) is preserved and SOFT_RST self-clears. 4. No latched error survives the soft reset.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_005" name="hsel_deassert_mid_transfer">
        <req_ref>REQ_004</req_ref>
        <features_involved>source_side_interface_signals, transfer_timing, setup_active_state_machine</features_involved>
        <objective>Expose protocol/state-machine faults when HSEL is deasserted (HSEL=0) after a transfer has been captured but before target completion. Connectivity and protocol features alone do not cover the deselect-during-active-phase interaction.</objective>
        <preconditions>
          <condition>HCLK=PCLK running, bridge in IDLE, STATUS=0x00000001</condition>
          <condition>Peripheral stalls two cycles (PREADY=0) then completes</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive HSEL=0x1, HTRANS=2'b10, HWRITE=0x0 (read), HADDR=0x0000_6000</action>
            <expected>Source captures the read transfer (FLOW-1), FSM IDLE-&gt;SETUP, BUSY=1</expected>
          </step>
          <step num="2">
            <action>At T2, observe target setup PSEL=0x1, PENABLE=0x0, PADDR=0x0000_6000</action>
            <expected>Target setup asserted (FLOW-2)</expected>
          </step>
          <step num="3">
            <action>At T3, advance to active phase PENABLE=0x1 with PREADY=0x0 held (back-pressure)</action>
            <expected>Bridge holds active phase, HREADY_OUT=0x0 (FLOW-4)</expected>
          </step>
          <step num="4">
            <action>At T4, deassert source select mid-transfer: drive HSEL=0x0 and HTRANS=2'b00 (IDLE) while the captured transfer is still active in the target</action>
            <expected>Already-captured transfer continues to completion in the FSM; deselect does not abort or corrupt the in-flight target operation</expected>
          </step>
          <step num="5">
            <action>At T5, peripheral completes: PREADY=0x1, PRDATA=0xBEEF_CACE, PSLVERR=0x0</action>
            <expected>Read data returned for the original transfer only after target completion (FLOW-5); HRDATA=0xBEEF_CACE, HRESP=0x0</expected>
          </step>
          <step num="6">
            <action>At T6, confirm the FSM returns to IDLE and does not launch a spurious second transfer from the deasserted-HSEL cycle</action>
            <expected>No new PSEL assertion; PSEL=0x0, PENABLE=0x0, HREADY_OUT=0x1</expected>
          </step>
          <step num="7">
            <action>At T7, read STATUS (HADDR=0x0000_0F04, HWRITE=0) to verify clean completion</action>
            <expected>STATUS=0x0000_0001 (BUSY=0, READY=1, no sticky error from the mid-transfer deselect)</expected>
          </step>
        </steps>
        <pass_criteria>1. Deasserting HSEL mid-transfer does not abort the already-captured beat: HRDATA=0xBEEFCACE returned with HRESP=0. 2. No spurious second transfer is launched from the HSEL=0/HTRANS=IDLE cycle (PSEL stays 0 afterward). 3. FSM returns to clean IDLE with STATUS=0x00000001.</pass_criteria>
      </test_case>
      <test_case test_id="TEST_CROSS_FEATURE_006" name="back_to_back_with_error_recovery">
        <req_ref>REQ_021</req_ref>
        <features_involved>sequence_handling, error_response_timing, target_error_scenario, read_data_return_path</features_involved>
        <objective>Expose error-isolation faults in a back-to-back stream where one beat errors (PSLVERR) and the following beat must complete cleanly. Sequence handling and error features alone miss whether an error on beat N leaks into beat N+1.</objective>
        <preconditions>
          <condition>HCLK=PCLK running, bridge in IDLE, STATUS=0x00000001</condition>
          <condition>Peripheral programmed to error on the second beat only (PSLVERR=1 once)</condition>
        </preconditions>
        <steps>
          <step num="1">
            <action>At T1, drive first beat: HSEL=0x1, HTRANS=2'b10 (NSEQ), HWRITE=0x1, HSIZE=3'b010, HADDR=0x0000_0400, HWDATA=0x1111_1111</action>
            <expected>Beat 1 captured (FLOW-1), forwarded to target</expected>
          </step>
          <step num="2">
            <action>At T2, beat 1 completes: PREADY=0x1, PSLVERR=0x0; immediately drive beat 2 as continued stream HTRANS=2'b11 (SEQ), HADDR=0x0000_0404, HWDATA=0x2222_2222</action>
            <expected>Beat 1 HRESP=0x0; address advanced by 4 (word size) for beat 2 per sequence handling</expected>
          </step>
          <step num="3">
            <action>At T3, beat 2 completes with error: PREADY=0x1, PSLVERR=0x1</action>
            <expected>Beat 2 HRESP=0x1 (ERROR); sticky PSLVERR/ERR_INT latched, ERROR_ADDR=0x0000_0404 captured</expected>
          </step>
          <step num="4">
            <action>At T4, drive beat 3 as continued stream HTRANS=2'b11 (SEQ), HADDR=0x0000_0408, HWDATA=0x3333_3333 with peripheral healthy (PSLVERR=0)</action>
            <expected>Beat 3 proceeds; the prior beat-2 error does not abort or corrupt beat 3</expected>
          </step>
          <step num="5">
            <action>At T5, beat 3 completes: PREADY=0x1, PSLVERR=0x0</action>
            <expected>Beat 3 HRESP=0x0; PWDATA=0x3333_3333 delivered, proving recovery after the errored beat</expected>
          </step>
          <step num="6">
            <action>At T6, read back STATUS (HADDR=0x0000_0F04, HWRITE=0)</action>
            <expected>Sticky PSLVERR=1 and ERR_INT=1 remain set from beat 2 (sticky semantics), BUSY=0, READY=1</expected>
          </step>
          <step num="7">
            <action>At T7, read ERROR_ADDR (0xF08) and ERROR_INFO (0xF0C) to confirm captured context is from the faulting beat 2</action>
            <expected>ERROR_ADDR=0x0000_0404 (beat 2 address, most-recent error), ERROR_INFO encodes write direction and target-error class</expected>
          </step>
          <step num="8">
            <action>At T8, perform a verification read-back of address 0x0000_0408: HSEL=0x1, HTRANS=2'b10, HWRITE=0x0, with peripheral returning PRDATA=0x3333_3333</action>
            <expected>HRDATA=0x3333_3333 with HRESP=0x0, confirming beat 3 data integrity after the intervening error</expected>
          </step>
        </steps>
        <pass_criteria>1. An error on beat 2 (HRESP=0x1) does not corrupt or abort beats 1 or 3: both complete with HRESP=0. 2. Sequence addresses advance correctly (0x400-&gt;0x404-&gt;0x408). 3. Sticky STATUS error bits persist and ERROR_ADDR=0x00000404 captures the faulting beat. 4. Read-back of beat 3 data returns 0x33333333 with HRESP=0, proving error isolation and recovery.</pass_criteria>
      </test_case>
    </test_suite>
  </test_suites>
</testplan>